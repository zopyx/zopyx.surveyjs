  "cards": [
    {
      "dot": "cyan",
      "title": "Choose the backend by concurrency",
      "items": [
        "ZODB needs no extra service, but conflicts start at ~5 concurrent writers",
        "SQLite is single-writer: WAL and a busy timeout serialize writes",
        "PostgreSQL or MySQL for many workers, hosts or sustained rates"
      ]
    },
    {
      "dot": "rose",
      "title": "Shared state must be reachable by every process",
      "items": [
        "Token and replay caches belong on a local filesystem, never NFS or SMB",
        "Multiple hosts need a dedicated KV database URI, not the results URI",
        "SQLite under ZEO is acceptable only for low-volume forms"
      ]
    },
    {
      "dot": "emerald",
      "title": "Run the state tier deliberately",
      "items": [
        "Back up ZODB/Data.fs and the RDBMS separately, one is not the other",
        "Every stored row carries the site_id for multi-site setups",
        "Watch logs for conflict and lock errors; load-test the real worker count"
      ]
    }
  ]
