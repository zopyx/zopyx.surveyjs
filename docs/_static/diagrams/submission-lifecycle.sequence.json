    { "from": "browser", "to": "addon", "y": 174, "label": "GET @@get-form-json · access mode enforced", "variant": "emphasis" },
    { "from": "addon", "to": "browser", "y": 202, "label": "form schema + auth_token (HS256, version bound)", "variant": "return" },
    { "from": "browser", "to": "addon", "y": 230, "label": "POST @@save-poll · pollResult", "variant": "emphasis" },
    { "from": "addon", "to": "boundary", "y": 258, "label": "size limit · token & replay check · normalize", "variant": "security" },
