  "cards": [
    { "dot": "cyan", "title": "Authorize at load time", "items": ["@@viewer issues a short-lived HS256 token bound to the form id and version", "Publishing a new form version invalidates every outstanding token", "Recording the token on disk gives replay protection (24 h TTL)"] },
    { "dot": "rose", "title": "Fail closed, fail early", "items": ["Payload size is enforced before JSON parsing (413)", "Access mode, token and replay checks reject with 403", "An unavailable token cache rejects (503) instead of allowing"] },
    { "dot": "emerald", "title": "Actions are independent", "items": ["One subscriber per side effect: store, mail, mail-notification, post", "A failing mail host or webhook is logged, never raised", "The submission stays accepted: { isSuccess: true }"] }
  ]
