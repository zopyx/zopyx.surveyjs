      "id": "reject_shape",
      "lane": "rejections",
      "col": 2,
      "type": "security",
      "label": "Reject 400",
      "sublabel": "invalid_json · unknown_field",
      "width": 170
    },
    {
      "id": "reject_files",
      "lane": "rejections",
      "col": 3,
      "type": "security",
      "label": "Reject 400",
      "sublabel": "unsafe_filename · mime_mismatch",
      "width": 170
    },
    {
      "id": "reject_external",
      "lane": "rejections",
      "col": 4,
      "type": "security",
      "label": "Reject 400 / 500",
      "sublabel": "validation failed · no binary",
      "width": 170
    }
  ],
  "edges": [
    {
      "id": "receive-transport",
      "from": "receive",
      "to": "transport",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "id": "transport-shape",
      "from": "transport",
      "to": "shape",
      "role": "main",
      "label": "within limit"
    },
    {
      "id": "shape-files",
      "from": "shape",
      "to": "files",
      "role": "main"
    },
    {
      "id": "files-external",
      "from": "files",
      "to": "external",
      "variant": "emphasis",
      "role": "main",
      "label": "schema + payload"
    },
    {
      "id": "external-handoff",
      "from": "external",
      "to": "handoff",
      "variant": "emphasis",
      "role": "main",
      "label": "valid"
    },
    {
      "id": "transport-reject",
      "from": "transport",
      "to": "reject_transport",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "shape-reject",
      "from": "shape",
      "to": "reject_shape",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "files-reject",
      "from": "files",
      "to": "reject_files",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "external-reject",
      "from": "external",
      "to": "reject_external",
      "variant": "security",
      "role": "error",
      "label": "invalid"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Order is the contract",
      "items": [
        "Transport limits are enforced before any JSON is parsed",
        "Checks run on a recursive copy, never on the caller payload",
        "Only the normalized copy reaches validation, storage and actions"
      ]
    },
    {
      "dot": "rose",
      "title": "Fail closed, decide early",
      "items": [
        "A rejected submission never reaches a subscriber or action",
        "A missing or tampered validator binary refuses the submission",
        "Single-use tokens are consumed only after validation succeeded"
      ]
    },
    {
      "dot": "emerald",
      "title": "Deterministic evidence",
      "items": [
        "Every failure returns a stable code plus an optional field",
        "Failures are logged at warning level without submission content",
        "Audit entries carry only reason, field, origin and remote address"
      ]
    }
  ]
}
