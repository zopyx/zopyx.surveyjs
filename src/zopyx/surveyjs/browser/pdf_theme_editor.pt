<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      tal:define="portal_state context/@@plone_portal_state">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>PDF Theme Editor</title>

  <metal:block use-macro="context/@@survey-assets/macros/surveyjs-var-actual-url" />
  <metal:block use-macro="context/@@survey-assets/macros/surveyjs-var-csrf" />
  <metal:block use-macro="context/@@survey-assets/macros/surveyjs-vars-base" />

  <span id="survey-editor-config"
        hidden="hidden"
        tal:attributes="data-license-key python: view.surveyjs_license_key or ''"></span>

  <metal:block use-macro="context/@@survey-assets/macros/surveyjs-core" />
  <metal:block use-macro="context/@@survey-assets/macros/surveyjs-ui" />
  <metal:block use-macro="context/@@survey-assets/macros/surveyjs-theme-index" />
  <metal:block use-macro="context/@@survey-assets/macros/surveyjs-creator" />
  <metal:block use-macro="context/@@survey-assets/macros/surveyjs-creator-i18n" />
  <metal:block use-macro="context/@@survey-assets/macros/surveyjs-ui-presets" />
  <metal:block use-macro="context/@@survey-assets/macros/surveyjs-ui-preset-editor" />

  <link rel="stylesheet" type="text/css"
        href="++resource++zopyx.surveyjs/pdf_theme_editor.css" />
  <script src="++resource++zopyx.surveyjs/pdf_theme_editor.js"
          type="text/javascript"></script>
</head>
<body>
  <div id="pdfThemeEditorApp">
    <div id="pdfThemeEditorToolbar">
      <h1>PDF Theme Editor</h1>
      <div class="actions">
        <button id="importThemeBtn" type="button">Import Theme JSON</button>
        <input type="file" id="importThemeInput" accept=".json,application/json"
               style="display:none" />
        <button id="exportThemeBtn" type="button">Export Theme JSON</button>
      </div>
      <span id="themeStatus" class="status"></span>
    </div>
    <div id="surveyContainer"></div>
  </div>
</body>
</html>