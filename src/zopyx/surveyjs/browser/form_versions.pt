<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      metal:use-macro="context/main_template/macros/master"
      i18n:domain="zopyx.surveyjs">

  <metal:block fill-slot="content-core">

    <!-- Load SurveyJS libraries for preview -->
    <link href="https://unpkg.com/survey-core/survey-core.min.css"
          rel="stylesheet"
          type="text/css"
    />
    <script src="https://unpkg.com/survey-core/survey.core.min.js"
            type="text/javascript"
    ></script>
    <script src="https://unpkg.com/survey-js-ui/survey-js-ui.min.js"
            type="text/javascript"
    ></script>
    <script src="https://unpkg.com/survey-core/themes/index.min.js"
            type="text/javascript"
    ></script>
    <link href="++resource++zopyx.surveyjs/viewer.css"
          rel="stylesheet"
          type="text/css"
    />

    <style>
      :root {
        --fv-bg: #f5f7fb;
        --fv-card: #ffffff;
        --fv-border: #e2e8f0;
        --fv-accent: #2f6fb6;
        --fv-shadow: 0 12px 30px rgba(15, 23, 42, 0.12);
      }
      .form-versions-container {
        background: linear-gradient(135deg, #f9fbff 0%, #eef2ff 100%);
        border-radius: 16px;
        box-shadow: var(--fv-shadow);
        padding: 28px;
      }
      .form-versions-header {
        margin-bottom: 30px;
        padding-bottom: 16px;
        border-bottom: 1px solid var(--fv-border);
        position: relative;
      }
      .form-versions-header::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -2px;
        width: 180px;
        height: 4px;
        border-radius: 999px;
        background: linear-gradient(90deg, #4c8dff, #6fd3ff);
      }
      .page-headline {
        margin: 0;
        color: #343a40;
        font-weight: 600;
        font-size: 1.5em;
      }
      .page-subtitle {
        color: #6c757d;
        font-size: 0.95em;
        margin-top: 5px;
      }
      .panel {
        background: var(--fv-card);
        border: 1px solid var(--fv-border);
        border-radius: 14px;
        box-shadow: 0 10px 26px rgba(15, 23, 42, 0.08);
        margin-bottom: 25px;
      }
      .panel-heading {
        background: linear-gradient(180deg, #f8fafc 0%, #eef2f7 100%);
        border-bottom: 1px solid var(--fv-border);
        padding: 16px 22px;
        border-radius: 14px 14px 0 0;
      }
      .panel-title {
        font-size: 16px;
        font-weight: 600;
        color: #495057;
        margin: 0;
      }
      .panel-body {
        padding: 20px;
      }
      .upload-panel {
        border-left: 4px solid #2fbf71;
      }
      .versions-panel {
        border-left: 4px solid #4c8dff;
      }
      .form-control {
        border-radius: 4px;
        border: 1px solid #ced4da;
        padding: 10px 12px;
      }
      .form-control:focus {
        border-color: #80bdff;
        box-shadow: 0 0 0 0.2rem rgba(0,123,255,.25);
      }
      .btn {
        padding: 8px 16px;
        font-weight: 500;
        border-radius: 8px;
        transition: all 0.2s;
        border: 1px solid transparent;
      }
      .btn-primary {
        background: linear-gradient(145deg, #3b82f6, #2563eb);
        border-color: #2563eb;
        color: white;
      }
      .btn-primary:hover {
        background: linear-gradient(145deg, #2563eb, #1d4ed8);
        border-color: #1d4ed8;
      }
      .table {
        margin-bottom: 0;
        background-color: white;
      }
      .table thead th {
        background-color: #f8f9fa;
        border-bottom: 2px solid #dee2e6;
        color: #495057;
        font-weight: 600;
        padding: 12px;
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }
      .table tbody tr {
        transition: background-color 0.2s;
      }
      .table tbody tr:hover {
        background-color: #f1f3f5;
      }
      .table tbody td {
        padding: 12px;
        vertical-align: middle;
      }
      .version-id-badge {
        background: linear-gradient(135deg, #e2e8f0, #f1f5f9);
        border: 1px solid #d5dde8;
        padding: 4px 12px;
        border-radius: 12px;
        font-family: 'Monaco', 'Menlo', monospace;
        font-size: 11px;
        color: #495057;
        display: inline-block;
      }
      .btn-group {
        display: flex;
        gap: 6px;
      }
      .btn-sm {
        padding: 6px 12px;
        font-size: 13px;
        border-radius: 3px;
        font-weight: 500;
      }
      .btn-info {
        background: linear-gradient(145deg, #6b7280, #4b5563);
        border-color: #4b5563;
        color: white;
      }
      .btn-info:hover {
        background: linear-gradient(145deg, #4b5563, #374151);
        border-color: #374151;
      }
      .btn-success {
        background: linear-gradient(145deg, #22c55e, #16a34a);
        border-color: #16a34a;
        color: white;
        text-decoration: none;
      }
      .btn-success:hover {
        background: linear-gradient(145deg, #16a34a, #15803d);
        border-color: #15803d;
        color: white;
      }
      .btn-warning {
        background: linear-gradient(145deg, #fbbf24, #f59e0b);
        border-color: #f59e0b;
        color: #1f2937;
      }
      .btn-warning:hover {
        background: linear-gradient(145deg, #f59e0b, #d97706);
        border-color: #d97706;
      }
      .alert-info {
        background-color: #e0f2fe;
        border-color: #bae6fd;
        color: #0c5460;
        border-left: 4px solid #38bdf8;
        padding: 15px;
        border-radius: 10px;
      }
      .modal-content {
        border-radius: 6px;
        box-shadow: 0 5px 15px rgba(0,0,0,.5);
        border: 1px solid rgba(0,0,0,.2);
      }
      .modal-header {
        padding: 15px;
        border-bottom: 1px solid #e9ecef;
        background-color: #fff;
      }
      .modal-header .modal-title {
        font-weight: 500;
        color: #495057;
        font-size: 18px;
      }
      .modal-header .close {
        color: #000;
        opacity: 0.5;
        text-shadow: none;
        font-size: 24px;
        font-weight: bold;
      }
      .modal-header .close:hover {
        opacity: 0.8;
      }
      .modal-body {
        padding: 15px;
      }
      #jsonContent {
        background: #f8f9fa;
        color: #212529;
        border: 1px solid #dee2e6;
        padding: 15px;
        border-radius: 4px;
        font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', monospace;
        font-size: 13px;
        line-height: 1.6;
        max-height: 60vh;
        overflow: auto;
        box-shadow: none;
      }
      .modal-footer {
        background-color: #f8f9fa;
        border-top: 1px solid #e9ecef;
        padding: 15px;
        text-align: right;
      }

      .help-block {
        color: #6c757d;
        font-size: 13px;
        margin-top: 5px;
      }
      .icon {
        margin-right: 5px;
      }
      .date-cell {
        font-family: 'Monaco', 'Menlo', monospace;
        font-size: 13px;
        color: #495057;
      }
      .user-cell {
        font-weight: 500;
        color: #495057;
      }
      .empty-state {
        text-align: center;
        padding: 60px 20px;
      }
      .empty-state-icon {
        font-size: 64px;
        color: #dee2e6;
        margin-bottom: 20px;
      }

      /* Modal styles from ai.css */
      .modal {
        display: none;
        position: fixed;
        z-index: 1050;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgba(0,0,0,0.5);
      }

      .modal-content-large {
        width: 90%;
        max-width: 1200px;
        max-height: 85vh;
        overflow-y: auto;
      }

      .modal-content h2 {
        margin-top: 0;
        margin-bottom: 20px;
        color: #1f2937;
        font-size: 24px;
        font-weight: 600;
      }

      .close-button {
        color: #9ca3af;
        float: right;
        font-size: 28px;
        font-weight: bold;
        line-height: 20px;
        cursor: pointer;
        transition: color 0.2s;
      }

      .close-button:hover,
      .close-button:focus {
        color: #111827;
      }

      #surveyContainer {
        margin-top: 20px;
        min-height: 300px;
        background: #fff;
      }
      .action-btn {
        width: 32px;
        height: 32px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        box-shadow: inset 0 1px 0 rgba(255,255,255,0.35);
      }
      .btn-group form {
        margin: 0;
      }
    </style>

    <div class="survey-actions"
         tal:condition="view/can_manage_portal_content">
      <a class="survey-action-button action-view"
         href="${context/absolute_url}/@@viewer">
        <span i18n:translate="">View</span>
      </a>
      <a class="survey-action-button action-editor"
         href="${context/absolute_url}/@@editor">
        <span i18n:translate="">Visual Editor</span>
      </a>
      <a class="survey-action-button action-results"
         href="${context/absolute_url}/@@results">
        <span i18n:translate="">Form Results</span>
      </a>
      <a class="survey-action-button action-versions"
         href="${context/absolute_url}/@@form-versions">
        <span i18n:translate="">Versions</span>
      </a>
      <a class="survey-action-button action-ai"
         href="${context/absolute_url}/@@ai">
        <span i18n:translate="">AI Generator</span>
      </a>
    </div>

    <div class="form-versions-container">

      <div class="form-versions-header">
        <h2 class="page-headline" i18n:translate="">Form Version Management</h2>
        <div class="subtitle page-subtitle" i18n:translate="">Manage, view, and restore previous versions of your survey forms</div>
      </div>

      <!-- Versions List -->
      <div class="panel panel-default versions-panel">
        <div class="panel-heading">
          <h3 class="panel-title">
            <span i18n:translate="">Version History</span>
            <tal:count condition="view/has_versions">
              <span style="float: right; background-color: #337ab7; color: white; padding: 3px 10px; border-radius: 12px; font-size: 12px;"
                    tal:content="python: len(view.versions)">0</span>
            </tal:count>
          </h3>
        </div>
        <div class="panel-body">

          <tal:has-versions condition="view/has_versions">
            <div style="overflow-x: auto;">
              <table class="table table-striped table-hover">
                <thead>
                  <tr>
                    <th style="width: 180px;" i18n:translate="">Date/Time</th>
                    <th style="width: 150px;" i18n:translate="">User</th>
                    <th i18n:translate="">Version ID</th>
                    <th i18n:translate="">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <tal:version repeat="version view/versions">
                    <tr>
                      <td class="date-cell" tal:content="python: version['created'].strftime('%Y-%m-%d %H:%M:%S')">
                        2024-01-01 12:00:00
                      </td>
                      <td class="user-cell" tal:content="version/user">username</td>
                      <td>
                        <span class="version-id-badge" tal:content="version/id">
                          version-id
                        </span>
                      </td>
                      <td>
                        <div class="btn-group" role="group">
                          <!-- View JSON Button -->
                          <form method="get">
                            <button type="submit"
                                    class="btn btn-sm btn-info view-json-btn"
                                    tal:attributes="data-version-id version/id"
                                    title="View JSON"
                                    i18n:attributes="title">
                              JSON
                            </button>
                          </form>

                          <!-- Preview Button -->
                          <form method="get">
                            <button type="submit"
                                    class="btn btn-sm btn-primary preview-btn"
                                    tal:attributes="data-version-id version/id"
                                    title="Preview"
                                    i18n:attributes="title">
                              Preview
                            </button>
                          </form>

                          <!-- Restore Button -->
                          <form method="post"
                                tal:attributes="action string:${context/absolute_url}/@@restore-version"
                                onsubmit="return confirm('⚠️ Restore this version?\n\nThis will create a new version with the content from this older version.\n\nThe current version will remain in the history.');">
                            <input type="hidden" name="_authenticator" tal:attributes="value context/@@authenticator/token" />
                            <input type="hidden"
                                   name="version_id"
                                   tal:attributes="value version/id" />
                            <button type="submit"
                                    class="btn btn-sm btn-warning"
                                    title="Restore to previous version"
                                    aria-label="Restore to previous version">
                              Restore
                            </button>
                          </form>

                          <!-- Download Button -->
                          <form method="get"
                                tal:attributes="action string:${context/absolute_url}/@@download-version">
                            <input type="hidden" name="version_id" tal:attributes="value version/id" />
                            <button type="submit"
                                    class="btn btn-sm btn-success action-btn"
                                    title="Download form definition as JSON"
                                    aria-label="Download form definition as JSON">
                              <img src="++resource++zopyx.surveyjs/icon-download.svg"
                                   alt="Download form definition as JSON"
                                   title="Download form definition as JSON" />
                            </button>
                          </form>
                        </div>
                      </td>
                    </tr>
                  </tal:version>
                </tbody>
              </table>
            </div>
          </tal:has-versions>

          <tal:no-versions condition="not: view/has_versions">
            <div class="empty-state">
              <div class="empty-state-icon">📭</div>
              <h3 style="color: #6c757d; font-weight: 500;" i18n:translate="">No Versions Available</h3>
              <p style="color: #868e96; max-width: 500px; margin: 15px auto;" i18n:translate="">
                No form versions have been created yet. Use the Form Creator to design your first survey,
                or upload an existing JSON file using the form above.
              </p>
            </div>
          </tal:no-versions>

        </div>
      </div>

      <!-- Upload Section -->
      <div class="panel panel-default upload-panel" style="margin-bottom: 30px;">
        <div class="panel-heading">
          <h3 class="panel-title">
            <span i18n:translate="">Upload JSON form schema</span>
          </h3>
        </div>
        <div class="panel-body">
          <form method="post"
                enctype="multipart/form-data"
                tal:attributes="action string:${context/absolute_url}/@@upload-version">
            <input type="hidden" name="_authenticator" tal:attributes="value context/@@authenticator/token" />
            <div class="form-group">
              <label for="json_file" style="font-weight: 500; color: #495057;" i18n:translate="">Select JSON file:</label>
              <input type="file"
                     name="json_file"
                     id="json_file"
                     accept=".json,application/json"
                     class="form-control"
                     required="required" />
              <p class="help-block" i18n:translate="">
                Upload a valid SurveyJS JSON file to create a new version. The file will be validated before saving.
              </p>
            </div>
            <button type="submit" class="btn btn-success" title="Upload and Create Version" i18n:translate="">
              Upload
            </button>
          </form>
        </div>
      </div>

      <!-- JSON Viewer Modal -->
      <div class="modal fade" id="jsonViewerModal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
          <div class="modal-content">
            <div class="modal-header">
              <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
              </button>
              <h4 class="modal-title">
                <span style="font-size: 20px;">🔍</span>
                <span i18n:translate="">JSON Version Content</span>
              </h4>
            </div>
            <div class="modal-body">
              <pre id="jsonContent"></pre>
            </div>
            <div class="modal-footer">
              <button type="button"
                      class="btn btn-default"
                      data-dismiss="modal">
                <span i18n:translate="">Close</span>
              </button>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Preview Modal -->
    <div id="previewModal" class="modal" style="display:none;">
      <div class="modal-content modal-content-large">
        <span class="close-button">&times;</span>
        <h2 i18n:translate="">Form Preview</h2>
        <div id="surveyContainer"></div>
      </div>
    </div>

    <!-- JavaScript for View JSON functionality -->
    <script tal:attributes="src string:${context/portal_url}/++resource++zopyx.surveyjs/form_versions.js"
            type="text/javascript">
    </script>

  </metal:block>

</html>
