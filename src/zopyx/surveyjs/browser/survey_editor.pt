<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      i18n:domain="zopyx.surveyjs"
      metal:use-macro="context/main_template/macros/master"
>

  <metal:block fill-slot="style_slot">
    <metal:survey-header-critical
        use-macro="context/@@survey-actions/macros/survey-header-critical"
    />
  </metal:block>

  <metal:block fill-slot="content-core"
               tal:define="portal_state context/@@plone_portal_state">
    <metal:surveyjs-var-actual-url
        use-macro="context/@@survey-assets/macros/surveyjs-var-actual-url"
    />
    <metal:surveyjs-var-csrf
        use-macro="context/@@survey-assets/macros/surveyjs-var-csrf"
    />
    <metal:surveyjs-vars-base
        use-macro="context/@@survey-assets/macros/surveyjs-vars-base"
    />
    <metal:surveyjs-i18n-scripts
        use-macro="context/@@survey-assets/macros/surveyjs-i18n-scripts"
    />
    <span id="survey-editor-config"
          hidden="hidden"
          tal:attributes="data-license-key python: view.surveyjs_license_key or '';
                          data-survey-languages view/survey_languages_json"></span>

    <metal:surveyjs-core
        use-macro="context/@@survey-assets/macros/surveyjs-core"
    />
    <metal:surveyjs-ui
        use-macro="context/@@survey-assets/macros/surveyjs-ui"
    />
    <metal:surveyjs-theme-index
        use-macro="context/@@survey-assets/macros/surveyjs-theme-index"
    />
    <metal:surveyjs-creator
        use-macro="context/@@survey-assets/macros/surveyjs-creator"
    />
    <metal:surveyjs-creator-i18n
        use-macro="context/@@survey-assets/macros/surveyjs-creator-i18n"
    />
    <metal:surveyjs-ui-presets
        use-macro="context/@@survey-assets/macros/surveyjs-ui-presets"
    />
    <metal:surveyjs-ui-preset-editor
        use-macro="context/@@survey-assets/macros/surveyjs-ui-preset-editor"
    />
    <metal:surveyjs-theme-contrast
        use-macro="context/@@survey-assets/macros/surveyjs-theme-contrast"
    />

    <link rel="stylesheet"
          type="text/css"
          href="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.snow.css"
    />
    <script src="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.min.js"
            type="text/javascript"
    ></script>

    <script src="++resource++zopyx.surveyjs/editor.js"
            type="text/javascript"
    ></script>

    <metal:surveyjs-viewer-css
        use-macro="context/@@survey-assets/macros/surveyjs-viewer-css"
    />

    <link rel="stylesheet"
          type="text/css"
          href="++resource++zopyx.surveyjs/editor.css"
    />  

    <metal:survey-header use-macro="context/@@survey-actions/macros/survey-header">
      <metal:survey-header-headline fill-slot="view-headline">
        <div class="page-headline" i18n:translate="">Visual Editor</div>
      </metal:survey-header-headline>
      <metal:survey-header-subtitle fill-slot="view-subtitle">
        <div class="page-subtitle" i18n:translate="">
          Build and refine the survey form.
        </div>
      </metal:survey-header-subtitle>
    </metal:survey-header>

    <div id="editorUnsavedBanner" class="editor-unsaved-banner" hidden="hidden">
      <span class="editor-unsaved-dot" aria-hidden="true"></span>
      <strong i18n:translate="">Unsaved changes</strong>
      <span i18n:translate="">You have edits that haven't been saved yet.</span>
    </div>

    <div id="surveyEditorContainer">
      <div class="survey-editor-toolbar">
        <a id="surveyFullscreenToggle"
           class="survey-fullscreen-toggle"
           href="#"
           role="button"
           aria-pressed="false"
           i18n:translate=""
        >Fullscreen</a>
      </div>
      <div id="surveyContainer"></div>
    </div>


  </metal:block>

</html>
