<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      metal:use-macro="context/main_template/macros/master"
      i18n:domain="zopyx.surveyjs">

  <metal:block fill-slot="style_slot">
    <metal:survey-header-critical
        use-macro="context/@@survey-actions/macros/survey-header-critical"
    />
  </metal:block>

  <metal:block fill-slot="content-core"
               tal:define="portal_state context/@@plone_portal_state">

    <metal:surveyjs-vars-base
        use-macro="context/@@survey-assets/macros/surveyjs-vars-base"
    />
    <metal:surveyjs-i18n-scripts
        use-macro="context/@@survey-assets/macros/surveyjs-i18n-scripts"
    />

    <!-- Load SurveyJS libraries for preview -->
    <metal:surveyjs-core
        use-macro="context/@@survey-assets/macros/surveyjs-core"
    />
    <metal:surveyjs-ui
        use-macro="context/@@survey-assets/macros/surveyjs-ui"
    />
    <metal:surveyjs-theme-index
        use-macro="context/@@survey-assets/macros/surveyjs-theme-index"
    />
    <metal:surveyjs-viewer-css
        use-macro="context/@@survey-assets/macros/surveyjs-viewer-css"
    />

    <link rel="stylesheet"
          type="text/css"
          href="++resource++zopyx.surveyjs/form_versions.css"
    />

    <div class="form-versions-container"
         tal:attributes="data-survey-id context/getId">

      <metal:survey-header use-macro="context/@@survey-actions/macros/survey-header"
                           tal:define="header_class string:form-versions-header">
        <metal:survey-header-headline fill-slot="view-headline">
          <div class="page-headline" i18n:translate="">Form Version Management</div>
        </metal:survey-header-headline>
        <metal:survey-header-subtitle fill-slot="view-subtitle">
          <div class="subtitle page-subtitle" i18n:translate="">Manage, view, and restore previous versions of your survey forms</div>
        </metal:survey-header-subtitle>
      </metal:survey-header>

      <!-- Versions List -->
      <div class="panel panel-default versions-panel">
        <div class="panel-heading">
          <h3 class="panel-title">
            <span i18n:translate="">Version History</span>
            <tal:count condition="view/has_versions">
              <span style="float: right; background-color: #337ab7; color: white; padding: 3px 10px; border-radius: 12px; font-size: 12px;"
                    tal:content="python: len(view.versions)">0</span>
            </tal:count>
          </h3>
        </div>
        <div class="panel-body">

          <tal:has-versions condition="view/has_versions">
            <div style="overflow-x: auto;">
              <table class="form-versions-table">
                <thead>
                  <tr>
                    <th style="width: 180px;" i18n:translate="">Date/Time</th>
                    <th style="width: 150px;" i18n:translate="">User</th>
                    <th i18n:translate="">Version ID</th>
                    <th i18n:translate="">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <tal:version repeat="version view/versions">
                    <tr>
                      <td class="date-cell" tal:content="python: version['created'].strftime('%Y-%m-%d %H:%M:%S')">
                        2024-01-01 12:00:00
                      </td>
                      <td class="user-cell" tal:content="version/user">username</td>
                      <td>
                        <span class="version-id-badge" tal:content="version/id">
                          version-id
                        </span>
                        <tal:locked tal:condition="python: version.get('locked')">
                          <span class="lock-badge" i18n:translate="">Locked</span>
                        </tal:locked>
                      </td>
                      <td>
                        <div class="btn-group-compact" role="group">
                          <!-- Preview JSON -->
                          <button type="button"
                                  class="btn-compact btn-json view-json-btn"
                                  tal:attributes="data-version-id version/id"
                                  title="View JSON"
                                  i18n:attributes="title">
                            <span class="btn-icon">{ }</span>
                            <span class="btn-text" i18n:translate="">JSON</span>
                          </button>

                          <!-- Preview Form -->
                          <button type="button"
                                  class="btn-compact btn-primary preview-btn"
                                  tal:attributes="data-version-id version/id"
                                  title="Preview form"
                                  i18n:attributes="title">
                            <span class="btn-icon">👁</span>
                            <span class="btn-text" i18n:translate="">View</span>
                          </button>

                          <!-- Restore -->
                          <button type="button"
                                  class="btn-compact btn-restore open-restore-dialog"
                                  tal:attributes="data-version-id version/id;
                                                  data-created python: version['created'].strftime('%Y-%m-%d %H:%M:%S');
                                                  data-user version/user"
                                  title="Restore version"
                                  i18n:attributes="title">
                            <span class="btn-icon">↩</span>
                            <span class="btn-text" i18n:translate="">Restore</span>
                          </button>

                          <!-- Lock/Unlock -->
                          <form method="post" class="btn-form"
                                tal:attributes="action string:${context/absolute_url}/@@toggle-version-lock">
                            <input type="hidden" name="_authenticator" tal:attributes="value context/@@authenticator/token" />
                            <input type="hidden" name="version_id" tal:attributes="value version/id" />
                            <tal:block tal:define="lock_label python: 'Unlock' if version.get('locked') else 'Lock'">
                              <button type="submit"
                                      class="btn-compact"
                                      tal:attributes="class python: 'btn-compact ' + ('btn-unlock' if version.get('locked') else 'btn-lock');
                                                      title lock_label"
                                      i18n:attributes="title">
                                <span class="btn-icon" tal:content="python: '🔓' if version.get('locked') else '🔒'">🔒</span>
                                <span class="btn-text" tal:content="lock_label">Lock</span>
                              </button>
                            </tal:block>
                          </form>

                          <!-- Download -->
                          <form method="get" class="btn-form"
                                tal:attributes="action string:${context/absolute_url}/@@download-version">
                            <input type="hidden" name="version_id" tal:attributes="value version/id" />
                            <button type="submit"
                                    class="btn-compact btn-success"
                                    title="Download JSON"
                                    i18n:attributes="title">
                              <span class="btn-icon">⬇</span>
                              <span class="btn-text" i18n:translate="">Save</span>
                            </button>
                          </form>

                          <!-- Create Template -->
                          <button type="button"
                                  class="btn-compact btn-template open-template-dialog"
                                  tal:attributes="data-version-id version/id"
                                  title="Create template"
                                  i18n:attributes="title">
                            <span class="btn-icon">+</span>
                            <span class="btn-text" i18n:translate="">Template</span>
                          </button>

                          <!-- Delete -->
                          <form method="post" class="btn-form"
                                tal:condition="python: not version.get('locked')"
                                tal:attributes="action string:${context/absolute_url}/@@delete-version">
                            <input type="hidden" name="_authenticator" tal:attributes="value context/@@authenticator/token" />
                            <input type="hidden" name="version_id" tal:attributes="value version/id" />
                            <button type="button"
                                    class="btn-compact btn-danger open-delete-dialog"
                                    tal:attributes="data-version-id version/id"
                                    title="Delete version"
                                    i18n:attributes="title">
                              <span class="btn-icon">×</span>
                              <span class="btn-text" i18n:translate="">Delete</span>
                            </button>
                          </form>
                        </div>
                      </td>
                    </tr>
                  </tal:version>
                </tbody>
              </table>
            </div>
          </tal:has-versions>

          <tal:no-versions condition="not: view/has_versions">
            <div class="empty-state">
              <div class="empty-state-icon">📭</div>
              <h3 style="color: #6c757d; font-weight: 500;" i18n:translate="">No Versions Available</h3>
              <p style="color: #868e96; max-width: 500px; margin: 15px auto;" i18n:translate="">
                No form versions have been created yet. Use the Form Creator to design your first survey,
                or upload an existing JSON file using the form above.
              </p>
            </div>
          </tal:no-versions>

        </div>
      </div>

      <!-- Upload Section -->
      <div class="panel panel-default upload-panel" style="margin-bottom: 30px;">
        <div class="panel-heading">
          <h3 class="panel-title">
            <span i18n:translate="">Upload JSON form schema</span>
          </h3>
        </div>
        <div class="panel-body">
          <form method="post"
                enctype="multipart/form-data"
                tal:attributes="action string:${context/absolute_url}/@@upload-version">
            <input type="hidden" name="_authenticator" tal:attributes="value context/@@authenticator/token" />
            <div class="form-group">
              <div class="form-versions-upload-row">
                <input type="file"
                       name="json_file"
                       id="json_file"
                       accept=".json,application/json"
                       class="form-control"
                       required="required" />
                <button type="submit" class="btn btn-success" title="Upload and Create Version" i18n:translate="" i18n:attributes="title">
                  Upload
                </button>
              </div>
              <p class="help-block" i18n:translate="">
                Upload a valid SurveyJS JSON file to create a new version. The file will be validated before saving.
              </p>
            </div>
          </form>
        </div>
      </div>

      <!-- JSON Viewer Modal - Modern Design -->
      <div id="jsonModalOverlay" class="json-modal-overlay"></div>
      <div id="jsonViewerModal" class="json-modal">
        <div class="json-modal-header">
          <h3 class="json-modal-title">
            <span i18n:translate="">JSON Version Content</span>
          </h3>
          <button class="json-modal-close" aria-label="Close" i18n:attributes="aria-label">&times;</button>
        </div>
        <div class="json-modal-body">
          <pre id="jsonContent" i18n:translate="">Loading...</pre>
        </div>
      </div>

      <!-- Restore Modal -->
      <div id="restoreModalOverlay" class="restore-modal-overlay"></div>
      <div id="restoreModal" class="restore-modal">
        <div class="restore-modal-header">
          <span class="icon">&#8635;</span>
          <h3 i18n:translate="">Restore version</h3>
        </div>
        <div class="restore-modal-body">
          <p i18n:translate="">Restoring will create a new version using the selected snapshot and keep the current version in history.</p>
          <div class="restore-meta">
            <span class="restore-chip"><strong i18n:translate="">ID:</strong> <span id="restoreVersionId">—</span></span>
            <span class="restore-chip"><strong i18n:translate="">User:</strong> <span id="restoreVersionUser">—</span></span>
            <span class="restore-chip"><strong i18n:translate="">Date:</strong> <span id="restoreVersionDate">—</span></span>
          </div>
        </div>
        <div class="restore-modal-footer">
          <button type="button" class="btn btn-ghost close-restore" i18n:translate="">Cancel</button>
          <form id="restoreForm"
                method="post"
                tal:attributes="action string:${context/absolute_url}/@@restore-version">
            <input type="hidden" name="_authenticator" tal:attributes="value context/@@authenticator/token" />
            <input type="hidden" name="version_id" id="restoreVersionInput" />
            <button type="submit" class="btn btn-restore">
              <span class="btn-icon">&#8635;</span>
              <span class="btn-label" i18n:translate="">Confirm restore</span>
            </button>
          </form>
        </div>
      </div>

      <!-- Template Modal -->
      <div id="templateModalOverlay" class="template-modal-overlay"></div>
      <div id="templateModal" class="template-modal">
        <div class="template-modal-header">
          <span class="icon">+</span>
          <h3 i18n:translate="">Create template</h3>
        </div>
        <div class="template-modal-body">
          <p i18n:translate="">
            Generate a new SurveyTemplate from the selected version. You can adjust the name before creation.
          </p>
          <div class="template-meta">
            <span class="template-chip"><strong i18n:translate="">Version:</strong> <span id="templateVersionId">—</span></span>
          </div>
          <label for="templateTitleInput" style="font-weight: 600; margin-top: 10px;" i18n:translate="">Template name</label>
          <input id="templateTitleInput"
                 name="template_title"
                 class="template-input"
                 type="text"
                 required="required"
                 autocomplete="off" />
          <div class="template-hint" i18n:translate="">
            This template will be created next to the current survey.
          </div>
        </div>
        <div class="template-modal-footer">
          <button type="button" class="btn btn-ghost close-template" i18n:translate="">Cancel</button>
          <form id="templateForm"
                method="post"
                tal:attributes="action string:${context/absolute_url}/@@create-template-from-version">
            <input type="hidden" name="_authenticator" tal:attributes="value context/@@authenticator/token" />
            <input type="hidden" name="version_id" id="templateVersionInput" />
            <input type="hidden" name="template_title" id="templateTitleHidden" />
            <button type="submit" class="btn btn-template">
              <span class="btn-icon">+</span>
              <span i18n:translate="">Create template</span>
            </button>
          </form>
        </div>
      </div>

      <!-- Delete Modal -->
      <div id="deleteModalOverlay" class="delete-modal-overlay"></div>
      <div id="deleteModal" class="delete-modal">
        <div class="delete-modal-header">
          <span class="icon">!</span>
          <h3 i18n:translate="">Delete version</h3>
        </div>
        <div class="delete-modal-body">
          <p i18n:translate="">This action permanently removes the selected version. This cannot be undone.</p>
          <div class="delete-meta">
            <strong i18n:translate="">ID:</strong> <span id="deleteVersionId">—</span>
          </div>
        </div>
        <div class="delete-modal-footer">
          <button type="button" class="btn btn-ghost close-delete" i18n:translate="">Cancel</button>
          <button type="button" class="btn btn-danger confirm-delete" i18n:translate="">Confirm delete</button>
        </div>
      </div>

    </div>

    <!-- Preview Modal - Modern Design -->
    <div id="previewModalOverlay" class="preview-modal-overlay"></div>
    <div id="previewModal" class="preview-modal">
      <div class="preview-modal-header">
        <h3 class="preview-modal-title">
          <span i18n:translate="">Form Preview</span>
        </h3>
        <button class="preview-modal-close" aria-label="Close" i18n:attributes="aria-label">&times;</button>
      </div>
      <div class="preview-modal-body">
        <div id="surveyContainer"></div>
      </div>
    </div>

    <!-- JavaScript for View JSON functionality -->
    <script tal:attributes="src string:${context/portal_url}/++resource++zopyx.surveyjs/form_versions.js"
            type="text/javascript">
    </script>

  </metal:block>

</html>
