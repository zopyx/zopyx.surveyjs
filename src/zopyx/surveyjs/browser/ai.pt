<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      metal:use-macro="context/main_template/macros/master"
      i18n:domain="zopyx.surveyjs">

<metal:block fill-slot="style_slot">
  <metal:survey-header-critical
      use-macro="context/@@survey-actions/macros/survey-header-critical"
  />
  <link rel="stylesheet" type="text/css"
        href="++resource++zopyx.surveyjs/ai.css" />
</metal:block>

<metal:block fill-slot="content-core"
             tal:define="portal_state context/@@plone_portal_state">

  <metal:surveyjs-vars-base
      use-macro="context/@@survey-assets/macros/surveyjs-vars-base"
  />
  <metal:surveyjs-i18n-scripts
      use-macro="context/@@survey-assets/macros/surveyjs-i18n-scripts"
  />
  <metal:surveyjs-core
      use-macro="context/@@survey-assets/macros/surveyjs-core"
  />
  <metal:surveyjs-ui
      use-macro="context/@@survey-assets/macros/surveyjs-ui"
  />
  <metal:surveyjs-theme-index
      use-macro="context/@@survey-assets/macros/surveyjs-theme-index"
  />
  <metal:surveyjs-viewer-css
      use-macro="context/@@survey-assets/macros/surveyjs-viewer-css"
  />

  <div class="ai-container">
    <div class="ai-header">
      <metal:survey-header use-macro="context/@@survey-actions/macros/survey-header">
        <metal:survey-header-headline fill-slot="view-headline">
          <div class="page-headline" i18n:translate="">AI Assistant</div>
        </metal:survey-header-headline>
        <metal:survey-header-subtitle fill-slot="view-subtitle">
          <div class="page-subtitle" i18n:translate="">
            Upload documents and convert them to SurveyJS forms using AI
          </div>
          <div class="ai-model-badge" tal:condition="view/ai_model_name">
            <span class="ai-model-label">Model:</span>
            <span class="ai-model-name" tal:content="view/ai_model_name">gpt-4</span>
          </div>
        </metal:survey-header-subtitle>
      </metal:survey-header>
    </div>
    <div class="ai-stack">
      <div class="panel">
        <div class="panel-body">
          <div class="ai-section-grid">
            <div>
              <span class="ai-eyebrow" i18n:translate="">Document To Online Form</span>
              <p class="ai-intro" i18n:translate="">
                Upload a source document and generate a temporary SurveyJS form draft with AI.
              </p>
              <form method="post"
                    id="aiUploadForm"
                    enctype="multipart/form-data"
                    style="margin-top: 14px;"
                    tal:attributes="action string:${context/absolute_url}/@@ai-upload">
                <span tal:replace="structure context/@@authenticator/authenticator"></span>
                <div class="form-group">
                  <input type="file"
                         class="form-control"
                         name="document_file"
                         accept=".pdf,.docx,.odt,.html,.htm,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.oasis.opendocument.text,text/html"
                         required="required" />
                  <p class="help-block" i18n:translate="">
                    Accepted formats: PDF, DOCX, ODT, HTML.
                  </p>
                </div>
                <button type="submit"
                        class="btn ai-action-btn ai-btn-upload"
                        id="aiUploadBtn">
                  <span id="aiUploadBtnText" i18n:translate="">Upload and Convert</span>
                  <span id="aiUploadBtnSpinner" class="ai-btn-spinner" style="display:none;">
                    <span class="ai-spinner"></span>
                    <span i18n:translate="">Uploading...</span>
                  </span>
                </button>
              </form>
            </div>
            <div class="ai-action-pane">
              <div class="ai-action-group">
                <form method="post"
                      tal:attributes="action string:${context/absolute_url}/@@ai-copy-latest-to-temp">
                  <span tal:replace="structure context/@@authenticator/authenticator"></span>
                  <button type="submit"
                          class="btn ai-action-btn ai-btn-copy"
                          i18n:translate="">Latest version to workspace</button>
                </form>
                <tal:has-temp-clear tal:condition="view/has_temp_form">
                  <form method="post"
                        tal:attributes="action string:${context/absolute_url}/@@ai-clear-temp-storage">
                    <span tal:replace="structure context/@@authenticator/authenticator"></span>
                    <button type="submit"
                            class="btn ai-action-btn ai-btn-clear"
                            i18n:translate="">Clear workspace</button>
                  </form>
                </tal:has-temp-clear>
                <tal:has-temp-actions tal:condition="view/has_temp_form">
                  <form method="post" action="#">
                    <button type="button"
                            class="btn ai-action-btn ai-btn-preview"
                            id="aiOpenPreviewBtn"
                            i18n:translate="">Preview form</button>
                  </form>
                  <form method="post"
                        tal:attributes="action string:${context/absolute_url}/@@ai-store-temp-version">
                    <span tal:replace="structure context/@@authenticator/authenticator"></span>
                    <button type="submit"
                            class="btn ai-action-btn ai-btn-store"
                            i18n:translate="">Store as new version</button>
                  </form>
                </tal:has-temp-actions>
              </div>
              <div class="ai-status-box">
                <p class="ai-status-title" i18n:translate="">Current Temporary State</p>
                <tal:temp-ok tal:condition="view/has_temp_form">
                  <p class="help-block" i18n:translate="">
                    Temporary form is available and can be previewed, refined, or stored as new version.
                  </p>
                </tal:temp-ok>
                <tal:temp-empty tal:condition="not: view/has_temp_form">
                  <p class="help-block" i18n:translate="">
                    No temporary form yet. Upload a document or copy the latest version.
                  </p>
                </tal:temp-empty>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <tal:has-temp-bottom tal:condition="view/has_temp_form">
      <div class="panel" style="margin-top: 16px;">
        <div class="panel-body">
          <div class="ai-chat-layout">
            <div class="ai-chat-box">
              <span class="ai-eyebrow" i18n:translate="">Improve Temporary Form</span>
              <p class="ai-intro" i18n:translate="">
                Ask AI to change the current temporary form. Each prompt builds on the latest temporary version.
              </p>
              <form method="post"
                    id="aiChatForm"
                    tal:attributes="action string:${context/absolute_url}/@@ai-chat-refine">
                <span tal:replace="structure context/@@authenticator/authenticator"></span>
                <div class="form-group">
                  <textarea name="chat_prompt"
                            class="form-control"
                            rows="4"
                            required="required"
                            i18n:attributes="placeholder"
                            placeholder="Example: Add a section for contact preferences and make email required."></textarea>
                </div>
                <button type="submit"
                        id="aiChatSubmitBtn"
                        class="btn ai-action-btn ai-btn-preview"
                        >
                  <span id="aiChatSubmitText" i18n:translate="">Apply AI Change</span>
                  <span id="aiChatSubmitSpinner" class="ai-btn-spinner" style="display:none;">
                    <span class="ai-spinner"></span>
                    <span i18n:translate="">Applying...</span>
                  </span>
                </button>
              </form>
            </div>
            <div class="ai-history-box">
              <h4 i18n:translate="">History (max 5)</h4>
              <tal:history tal:condition="view/has_temp_history">
                <div class="ai-history-list">
                  <div class="ai-history-item"
                       tal:repeat="item view/temp_history_items">
                    <div class="ai-history-meta">
                      <span i18n:translate="">Step back:</span>
                      <span tal:content="item/step_back">1</span>
                    </div>
                    <div class="ai-history-prompt"
                         tal:content="item/prompt">Prompt text</div>
                    <form method="post"
                          tal:attributes="action string:${context/absolute_url}/@@ai-restore-history-step">
                      <span tal:replace="structure context/@@authenticator/authenticator"></span>
                      <input type="hidden"
                             name="history_index"
                             tal:attributes="value item/history_index" />
                      <button type="submit"
                              class="btn btn-default btn-xs"
                              i18n:translate="">Restore</button>
                    </form>
                  </div>
                </div>
              </tal:history>
              <tal:nohistory tal:condition="not: view/has_temp_history">
                <p class="help-block" i18n:translate="">
                  No chat refinement history yet.
                </p>
              </tal:nohistory>
            </div>
          </div>
        </div>
      </div>

      <div id="aiPreviewModal"
           class="modal ai-preview-modal"
           style="display:none;">
        <div class="modal-content">
          <span id="aiClosePreviewBtn" class="close-button">&#215;</span>
          <h2 i18n:translate="">Temporary SurveyJS Preview</h2>
          <div id="aiSurveyPreviewContainer"></div>
        </div>
      </div>
      <script type="application/json"
              id="ai-temp-form-json"
              tal:define="temp_json python: __import__('json').dumps(view.temp_form_data)"
              tal:content="structure temp_json"></script>
    </tal:has-temp-bottom>

  <script src="++resource++zopyx.surveyjs/ai.js"></script>
  </div>

</metal:block>
</html>
