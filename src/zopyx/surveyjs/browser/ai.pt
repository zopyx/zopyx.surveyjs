<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      metal:use-macro="context/main_template/macros/master"
      i18n:domain="zopyx.surveyjs">

<metal:block fill-slot="content-core"
             tal:define="portal_state context/@@plone_portal_state">

  <!-- Inject JavaScript variables for AJAX -->
  <script type="text/javascript"
          tal:content="string: ACTUAL_URL='${context/absolute_url}'"
  ></script>
  <script type="text/javascript"
          tal:content="string: CSRF_TOKEN='${context/@@authenticator/token}'"
  ></script>
  <script type="text/javascript"
          tal:content="string: SURVEYJS_I18N_LOCALE='${portal_state/language}'"
  ></script>
  <script type="text/javascript"
          tal:content="string: SURVEYJS_I18N_BASE='${context/portal_url}/++resource++zopyx.surveyjs/i18n'"
  ></script>
  <script src="++resource++zopyx.surveyjs/i18n.js"
          type="text/javascript"
  ></script>
  <script src="++resource++zopyx.surveyjs/i18n/en.js"
          type="text/javascript"
  ></script>
  <script tal:condition="python:portal_state.language() != 'en'"
          tal:attributes="src string:${context/portal_url}/++resource++zopyx.surveyjs/i18n/${portal_state/language}.js"
          type="text/javascript"
  ></script>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

  <!-- Load SurveyJS libraries for preview -->
  <link href="https://unpkg.com/survey-core/survey-core.min.css"
        rel="stylesheet"
        type="text/css"
  />
  <script src="https://unpkg.com/survey-core/survey.core.min.js"
          type="text/javascript"
  ></script>
  <script src="https://unpkg.com/survey-core/survey.i18n.min.js"
          type="text/javascript"
  ></script>
  <script src="https://unpkg.com/survey-js-ui/survey-js-ui.min.js"
          type="text/javascript"
  ></script>
  <script src="https://unpkg.com/survey-core/themes/index.min.js"
          type="text/javascript"
  ></script>
  <link href="++resource++zopyx.surveyjs/viewer.css"
        rel="stylesheet"
        type="text/css"
  />

  <!-- Load local CSS and JS -->
  <link rel="stylesheet"
        type="text/css"
        href="++resource++zopyx.surveyjs/ai.css"
  />
  <script src="++resource++zopyx.surveyjs/ai.js"
          type="text/javascript"
  ></script>

  <div class="survey-actions"
       tal:condition="view/can_manage_portal_content">
    <a class="survey-action-button action-view"
       href="${context/absolute_url}/@@viewer">
      <span i18n:translate="">View</span>
    </a>
    <a class="survey-action-button action-editor"
       href="${context/absolute_url}/@@editor">
      <span i18n:translate="">Visual Editor</span>
    </a>
      <a class="survey-action-button action-results"
         href="${context/absolute_url}/@@results">
        <span i18n:translate="">Form Results</span>
      </a>
      <tal:manager tal:condition="view/is_manager">
        <a class="survey-action-button action-dashboard"
           href="${context/absolute_url}/@@dashboard">
          <span i18n:translate="">Dashboard</span>
        </a>
        <a class="survey-action-button action-pdf-generator"
           href="${context/absolute_url}/@@pdf-generator">
          <span i18n:translate="">PDF Generator</span>
        </a>
      </tal:manager>
      <a class="survey-action-button action-versions"
         href="${context/absolute_url}/@@form-versions">
        <span i18n:translate="">Versions</span>
      </a>
    <a class="survey-action-button action-ai"
       href="${context/absolute_url}/@@ai">
      <span i18n:translate="">AI Generator</span>
    </a>
    <tal:manager tal:condition="view/is_manager">
      <a class="survey-action-button action-pdf-importer"
         href="${context/absolute_url}/@@pdf-importer">
        <span i18n:translate="">PDF Form Import</span>
      </a>
    </tal:manager>
    <tal:notmanager tal:condition="not: view/is_manager">
      <span class="survey-action-button action-pdf-importer is-disabled"
            aria-disabled="true">
        <span i18n:translate="">PDF Form Import</span>
        <span class="manager-badge" i18n:translate="">Manager only</span>
      </span>
    </tal:notmanager>
  </div>

  <tal:status tal:condition="view/can_manage_portal_content"
                tal:define="status view/survey_status_label;
                           effective view/survey_effective_display;
                           expires view/survey_expires_display;
                           results_count view/survey_results_count">
    <div class="survey-status-bar">
      <span class="survey-status-item">
        <strong i18n:translate="">Status</strong>:
        <span tal:content="status">Published</span>
      </span>
      <span class="survey-status-item"
            tal:condition="effective">
        <strong i18n:translate="">Effective</strong>:
        <span tal:content="effective">2024-01-01</span>
      </span>
      <span class="survey-status-item"
            tal:condition="expires">
        <strong i18n:translate="">Expires</strong>:
        <span tal:content="expires">2025-01-01</span>
      </span>
      <span class="survey-status-item">
        <strong i18n:translate="">Stored results</strong>:
        <span tal:content="results_count">0</span>
      </span>
    </div>
  </tal:status>

  <div class="ai-generator-container">

    <!-- Header -->
    <div class="ai-generator-header">
      <h2 class="page-headline" i18n:translate="">AI Form Generator</h2>
      <div class="subtitle page-subtitle" i18n:translate="">
        Describe your survey in natural language and let AI generate the form
      </div>
      <div class="alert alert-warning ai-warning">
        <strong i18n:translate="">Experimental:</strong>
        <ul>
          <li i18n:translate="">This is a helper to get started, not a finished form.</li>
          <li i18n:translate="">Use clear, specific prompts for best results.</li>
          <li i18n:translate="">Always review and adjust the generated form before use.</li>
        </ul>
      </div>
    </div>

    <!-- Refinement Mode Container (always visible) -->
    <div class="refinement-mode-container">

      <!-- Left: History Timeline -->
      <div class="panel history-panel">
        <div class="panel-heading">
          <h3 class="panel-title">
            <span i18n:translate="">Refinement History</span>
          </h3>
        </div>
        <div class="panel-body">
          <div id="historyTimeline" class="history-timeline"></div>
        </div>
      </div>

      <!-- Right: Form Input and Actions -->
      <div class="panel refinement-panel">
        <div class="panel-heading">
          <h3 class="panel-title">
            <span id="formPanelTitle" i18n:translate="">Describe Your Form</span>
          </h3>
        </div>
        <div class="panel-body">
          <div class="current-state-indicator" id="versionIndicator" style="display:none;">
            <strong i18n:translate="">Current Version:</strong> <span id="currentVersionInfo"></span>
          </div>
          <form id="refinementForm">
            <div class="form-group">
              <label for="refinementInput" id="formInputLabel" i18n:translate="">
                Describe the form you want to create:
              </label>
              <textarea
                id="refinementInput"
                name="refinement"
                class="form-control"
                rows="6"
                placeholder="Example: Create a customer satisfaction survey with questions about product quality, delivery experience, and overall satisfaction. Include rating scales and a comments section."
                i18n:attributes="placeholder"
                required
              ></textarea>
              <p class="help-block" id="formInputHelp" i18n:translate="">
                Be specific about the types of questions, response formats, and any particular fields you need.
              </p>
            </div>
            <div class="form-group refine-existing">
              <label for="refineExisting">
                <input type="checkbox" id="refineExisting" />
                <span i18n:translate="">Refine existing form</span>
              </label>
              <p class="help-block" i18n:translate="">
                Use the latest saved form as the starting point instead of generating a new one.
              </p>
            </div>

            <div class="button-group">
              <button type="submit" class="btn btn-primary" id="refineBtn">
                <span class="btn-text" id="refineBtnText" i18n:translate="">Generate Form</span>
                <span class="btn-spinner" style="display:none;">
                  <span class="spinner"></span> <span id="refineBtnSpinnerText" i18n:translate="">Generating...</span>
                </span>
              </button>
              <button type="button" class="btn btn-secondary" id="startOverBtn" style="display:none;">
                <span i18n:translate="">Start Over</span>
              </button>
            </div>
          </form>

          <!-- Action Buttons (shown after form is generated) -->
          <div class="action-buttons" id="formActionButtons" style="display:none; margin-top: 20px; padding-top: 20px; border-top: 1px solid #e0e0e0;">
            <button type="button" class="btn btn-info" id="previewJsonBtn">
              <span i18n:translate="">Preview JSON</span>
            </button>
            <button type="button" class="btn btn-info" id="previewFormBtn">
              <span i18n:translate="">Preview Form</span>
            </button>
            <button type="button" class="btn btn-success" id="saveBtn">
              <span i18n:translate="">Save Form</span>
            </button>
          </div>
        </div>
      </div>

    </div>

    <!-- Error Display (hidden initially) -->
    <div id="errorContainer" class="alert alert-danger" style="display:none;">
      <strong i18n:translate="">Error:</strong> <span id="errorMessage"></span>
    </div>

  </div>

  <!-- Form Preview Modal -->
  <div id="previewFormModal" class="modal" style="display:none;">
    <div class="modal-content modal-content-large">
      <span class="close-button close-form-preview">&times;</span>
      <h2 i18n:translate="">Form Preview</h2>
      <div id="surveyContainer"></div>
    </div>
  </div>

  <!-- JSON Preview Modal -->
  <div id="previewJsonModal" class="modal" style="display:none;">
    <div class="modal-content modal-content-large">
      <span class="close-button close-json-preview">&times;</span>
      <h2 i18n:translate="">Form JSON</h2>
      <div class="json-modal-body">
        <pre id="jsonModalDisplay"></pre>
      </div>
    </div>
  </div>

</metal:block>
</html>
