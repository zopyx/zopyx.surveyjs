<metal:survey_assets xmlns:metal="http://xml.zope.org/namespaces/metal"
                     xmlns:tal="http://xml.zope.org/namespaces/tal">
  <metal:surveyjs-var-actual-url define-macro="surveyjs-var-actual-url">
    <script type="application/json"
            id="surveyjs-actual-url"
            tal:define="value context/absolute_url; json python: __import__('json').dumps(value)"
            tal:content="structure json"></script>
  </metal:surveyjs-var-actual-url>

  <metal:surveyjs-var-csrf define-macro="surveyjs-var-csrf">
    <script type="application/json"
            id="surveyjs-csrf-token"
            tal:define="value context/@@authenticator/token; json python: __import__('json').dumps(value)"
            tal:content="structure json"></script>
  </metal:surveyjs-var-csrf>

  <metal:surveyjs-var-auth-token define-macro="surveyjs-var-auth-token">
    <script type="application/json"
            id="surveyjs-auth-token"
            tal:define="value context/@@survey-assets/auth_token; json python: __import__('json').dumps(value)"
            tal:content="structure json"></script>
  </metal:surveyjs-var-auth-token>

  <metal:surveyjs-vars-base define-macro="surveyjs-vars-base">
    <script type="application/json"
            id="surveyjs-i18n-locale"
            tal:define="value portal_state/language; json python: __import__('json').dumps(value)"
            tal:content="structure json"></script>
    <script type="application/json"
            id="surveyjs-i18n-base"
            tal:define="value string:${context/portal_url}/++resource++zopyx.surveyjs/i18n; json python: __import__('json').dumps(value)"
            tal:content="structure json"></script>
    <script type="application/json"
            id="surveyjs-creator-i18n-base"
            tal:define="value string:${context/portal_url}/++resource++zopyx.surveyjs/surveyjs; json python: __import__('json').dumps(value)"
            tal:content="structure json"></script>
    <script src="++resource++zopyx.surveyjs/survey_assets.js"
            type="text/javascript"></script>
  </metal:surveyjs-vars-base>

  <metal:surveyjs-i18n-scripts define-macro="surveyjs-i18n-scripts">
    <script tal:attributes="src string:${context/portal_url}/++resource++zopyx.surveyjs/i18n.js"
            type="text/javascript"
    ></script>
    <script tal:attributes="src string:${context/portal_url}/++resource++zopyx.surveyjs/i18n/en.js"
            type="text/javascript"
    ></script>
    <script tal:condition="python:portal_state.language() != 'en'"
            tal:attributes="src string:${context/portal_url}/++resource++zopyx.surveyjs/i18n/${portal_state/language}.js"
            type="text/javascript"
    ></script>
  </metal:surveyjs-i18n-scripts>

  <metal:surveyjs-core define-macro="surveyjs-core">
    <link tal:attributes="href string:${context/portal_url}/++resource++zopyx.surveyjs/surveyjs/survey-core.min.css"
          rel="stylesheet"
          type="text/css"
    />
    <script tal:attributes="src string:${context/portal_url}/++resource++zopyx.surveyjs/surveyjs/survey.core.min.js"
            type="text/javascript"
    ></script>
    <script tal:attributes="src string:${context/portal_url}/++resource++zopyx.surveyjs/surveyjs/survey.i18n.min.js"
            type="text/javascript"
    ></script>
  </metal:surveyjs-core>

  <metal:surveyjs-ui define-macro="surveyjs-ui">
    <script tal:attributes="src string:${context/portal_url}/++resource++zopyx.surveyjs/surveyjs/survey-js-ui.min.js"
            type="text/javascript"
    ></script>
  </metal:surveyjs-ui>

  <metal:surveyjs-theme-index define-macro="surveyjs-theme-index">
    <script tal:attributes="src string:${context/portal_url}/++resource++zopyx.surveyjs/surveyjs/index.min.js"
            type="text/javascript"
    ></script>
  </metal:surveyjs-theme-index>

  <metal:surveyjs-theme-contrast define-macro="surveyjs-theme-contrast">
    <script tal:attributes="src string:${context/portal_url}/++resource++zopyx.surveyjs/surveyjs/contrast-dark.min.js"
            type="text/javascript"
    ></script>
    <script tal:attributes="src string:${context/portal_url}/++resource++zopyx.surveyjs/surveyjs/contrast-light.min.js"
            type="text/javascript"
    ></script>
  </metal:surveyjs-theme-contrast>

  <metal:surveyjs-analytics define-macro="surveyjs-analytics">
    <link tal:attributes="href string:${context/portal_url}/++resource++zopyx.surveyjs/surveyjs/survey.analytics.min.css"
          rel="stylesheet"
          type="text/css"
    />
    <script tal:attributes="src string:${context/portal_url}/++resource++zopyx.surveyjs/surveyjs/plotly.min.js"
            type="text/javascript"
    ></script>
    <script tal:attributes="src string:${context/portal_url}/++resource++zopyx.surveyjs/surveyjs/survey.analytics.min.js"
            type="text/javascript"
    ></script>
  </metal:surveyjs-analytics>

  <metal:surveyjs-creator define-macro="surveyjs-creator">
    <link tal:attributes="href string:${context/portal_url}/++resource++zopyx.surveyjs/surveyjs/survey-creator-core.min.css"
          rel="stylesheet"
          type="text/css"
    />
    <script tal:attributes="src string:${context/portal_url}/++resource++zopyx.surveyjs/surveyjs/survey-creator-core.min.js"></script>
    <script tal:attributes="src string:${context/portal_url}/++resource++zopyx.surveyjs/surveyjs/survey-creator-js.min.js"></script>
  </metal:surveyjs-creator>

  <metal:surveyjs-creator-i18n define-macro="surveyjs-creator-i18n">
    <script tal:attributes="src string:${context/portal_url}/++resource++zopyx.surveyjs/surveyjs/survey-creator-core.i18n.min.js"
            type="text/javascript"
    ></script>
  </metal:surveyjs-creator-i18n>

  <metal:surveyjs-ui-presets define-macro="surveyjs-ui-presets">
    <script tal:attributes="src string:${context/portal_url}/++resource++zopyx.surveyjs/surveyjs/ui-presets/index.min.js"
            type="text/javascript"
    ></script>
  </metal:surveyjs-ui-presets>

  <metal:surveyjs-ui-preset-editor define-macro="surveyjs-ui-preset-editor">
    <script tal:attributes="src string:${context/portal_url}/++resource++zopyx.surveyjs/surveyjs/ui-preset-editor.min.js"
            type="text/javascript"
    ></script>
  </metal:surveyjs-ui-preset-editor>

  <metal:surveyjs-pdf define-macro="surveyjs-pdf">
    <script tal:attributes="src string:${context/portal_url}/++resource++zopyx.surveyjs/surveyjs/jspdf.umd.min.js"
            type="text/javascript"
    ></script>
    <script tal:attributes="src string:${context/portal_url}/++resource++zopyx.surveyjs/surveyjs/survey.pdf.min.js"
            type="text/javascript"
    ></script>
  </metal:surveyjs-pdf>

  <metal:surveyjs-viewer-css define-macro="surveyjs-viewer-css">
    <link tal:attributes="href string:${context/portal_url}/++resource++zopyx.surveyjs/viewer.css"
          rel="stylesheet"
          type="text/css"
    />
    <link tal:attributes="href string:${context/portal_url}/++resource++zopyx.surveyjs/header_actions.css"
          rel="stylesheet"
          type="text/css"
    />
  </metal:surveyjs-viewer-css>
</metal:survey_assets>
