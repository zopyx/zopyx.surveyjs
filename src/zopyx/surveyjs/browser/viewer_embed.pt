<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      tal:define="portal_state context/@@plone_portal_state"
      i18n:domain="zopyx.surveyjs">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title i18n:translate="">Survey</title>

  <metal:surveyjs-var-actual-url
      use-macro="context/@@survey-assets/macros/surveyjs-var-actual-url"
  />
  <metal:surveyjs-var-csrf
      use-macro="context/@@survey-assets/macros/surveyjs-var-csrf"
  />
  <metal:surveyjs-var-auth-token
      use-macro="context/@@survey-assets/macros/surveyjs-var-auth-token"
  />
  <script type="text/javascript"
          tal:content="python: 'SURVEY_TRUSTED_ACCESS_ENABLED=%s; SURVEY_CAN_MANAGE=%s;' % ('true' if view.trusted_access_enabled else 'false', 'true' if view.can_manage_portal_content else 'false')">
  </script>
  <metal:surveyjs-vars-base
      use-macro="context/@@survey-assets/macros/surveyjs-vars-base"
  />
  <metal:surveyjs-i18n-scripts
      use-macro="context/@@survey-assets/macros/surveyjs-i18n-scripts"
  />
  <metal:surveyjs-core
      use-macro="context/@@survey-assets/macros/surveyjs-core"
  />
  <metal:surveyjs-ui
      use-macro="context/@@survey-assets/macros/surveyjs-ui"
  />
  <metal:surveyjs-theme-contrast
      use-macro="context/@@survey-assets/macros/surveyjs-theme-contrast"
  />
  <script src="++resource++zopyx.surveyjs/viewer.js"
          type="text/javascript"
  ></script>
  <metal:surveyjs-viewer-css
      use-macro="context/@@survey-assets/macros/surveyjs-viewer-css"
  />
  <style type="text/css">
    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      background: #fff;
    }

    #surveyContainer {
      width: 100%;
      max-width: 100%;
    }

    .survey-container-hidden {
      display: none !important;
      visibility: hidden !important;
    }
  </style>
</head>
<body>
  <tal:trusted-access-state
      tal:define="missing_token python: view.trusted_access_enabled and not request.get('access_token') and not view.can_manage_portal_content">
    <div id="surveyAccessError"
         class="survey-access-error"
         tal:attributes="hidden python: None if missing_token else 'hidden'">
      <tal:trusted-access-message
          tal:condition="missing_token"
          i18n:translate="">
        This form requires a trusted access link. Please use the link provided by the form owner.
      </tal:trusted-access-message>
    </div>
    <div id="surveyContainer"
         tal:attributes="class python: 'survey-container-hidden' if missing_token else None; hidden python: 'hidden' if missing_token else None"></div>
  </tal:trusted-access-state>
</body>
</html>
