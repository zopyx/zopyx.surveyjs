<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      metal:use-macro="context/main_template/macros/master"
      i18n:domain="zopyx.surveyjs">

<metal:block fill-slot="style_slot">
  <metal:survey-header-critical
      use-macro="context/@@survey-actions/macros/survey-header-critical"
  />
</metal:block>

<metal:block fill-slot="content-core"
             tal:define="portal_state context/@@plone_portal_state;
                         feature_ok python: view.require_feature('chatbot')">

  <tal:feature tal:condition="feature_ok">

  <metal:surveyjs-var-actual-url
      use-macro="context/@@survey-assets/macros/surveyjs-var-actual-url"
  />
  <metal:surveyjs-var-csrf
      use-macro="context/@@survey-assets/macros/surveyjs-var-csrf"
  />
  <metal:surveyjs-vars-base
      use-macro="context/@@survey-assets/macros/surveyjs-vars-base"
  />
  <metal:surveyjs-i18n-scripts
      use-macro="context/@@survey-assets/macros/surveyjs-i18n-scripts"
  />

  <link rel="stylesheet"
        type="text/css"
        href="++resource++zopyx.surveyjs/chatbot.css"
  />
  <script src="++resource++zopyx.surveyjs/chatbot.js"
          type="text/javascript"
  ></script>

    <div class="chatbot-page"
         tal:attributes="data-chat-api python: context.absolute_url() + '/@@chat-api';
                         data-chat-stream-api python: context.absolute_url() + '/@@chat-api';
                         data-chat-stats-api python: context.absolute_url() + '/@@chatbot-stats'">

    <metal:survey-header use-macro="context/@@survey-actions/macros/survey-header">
      <metal:survey-header-headline fill-slot="view-headline">
        <div class="page-headline" i18n:translate="">Chatbot</div>
      </metal:survey-header-headline>
      <metal:survey-header-subtitle fill-slot="view-subtitle">
        <div class="subtitle page-subtitle" i18n:translate="">
          Ask about zopyx.surveyjs usage, configuration, and SurveyJS documentation
        </div>
      </metal:survey-header-subtitle>
    </metal:survey-header>

    <div class="chatbot-layout">
      <aside class="chatbot-sidebar">
        <h3 i18n:translate="">Quick Prompts</h3>
        <button class="chatbot-prompt" data-prompt="How do I configure actions store, mail and post?" i18n:translate="">How do I configure actions store, mail and post?</button>
        <button class="chatbot-prompt" data-prompt="Which global settings are available under Site Setup > Forms?" i18n:translate="">Which global settings are available under Site Setup > Forms?</button>
        <button class="chatbot-prompt" data-prompt="How do I enable server-side validation for submissions?" i18n:translate="">How do I enable server-side validation for submissions?</button>
        <button class="chatbot-prompt" data-prompt="Which view should I use for editor, viewer, results, and versions?" i18n:translate="">Which view should I use for editor, viewer, results, and versions?</button>
      </aside>

      <section class="chatbot-main">
        <div id="chatbotMessages" class="chatbot-messages" aria-live="polite"></div>
        <div id="chatbotSources" class="chatbot-sources"></div>
        <div id="chatbotFollowups" class="chatbot-followups"></div>

        <form id="chatbotForm" class="chatbot-form">
          <label for="chatbotInput" class="chatbot-label" i18n:translate="">Your question</label>
          <textarea id="chatbotInput"
                    rows="3"
                    required="required"
                    i18n:attributes="placeholder"
                    placeholder="Ask about this add-on and SurveyJS docs"></textarea>
          <div class="chatbot-controls">
            <label class="chatbot-stream-toggle" for="chatbotStream">
              <input type="checkbox" id="chatbotStream" checked="checked" />
              <span i18n:translate="">Stream response</span>
            </label>
            <button type="submit" id="chatbotSend" class="btn btn-primary" i18n:translate="">Send</button>
            <button type="button" id="chatbotReset" class="btn btn-secondary" i18n:translate="">Clear</button>
          </div>
        </form>
      </section>
    </div>
    </div>
  </tal:feature>

  <tal:feature-disabled tal:condition="not: feature_ok">
    <metal:feature-disabled
        use-macro="context/@@survey-actions/macros/feature-disabled"
    />
  </tal:feature-disabled>
</metal:block>
</html>
