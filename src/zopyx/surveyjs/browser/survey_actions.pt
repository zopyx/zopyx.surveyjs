<metal:survey_actions xmlns:metal="http://xml.zope.org/namespaces/metal"
                      xmlns:tal="http://xml.zope.org/namespaces/tal"
                      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
                      i18n:domain="zopyx.surveyjs"
                      define-macro="survey-actions">
  <div class="survey-actions"
       tal:condition="view/can_manage_portal_content"
       tal:define="current_url request/ACTUAL_URL">
    <div class="survey-actions-row">
      <a class="survey-action-button action-view"
         tal:attributes="class python: 'survey-action-button action-view' + (' is-active' if current_url.endswith('/@@viewer') or current_url == context.absolute_url() else '')"
         href="${context/absolute_url}/@@viewer">
        <span i18n:translate="">View</span>
      </a>
      <tal:pdfform tal:condition="view/pdf_form_available">
        <a class="survey-action-button action-pdf-form"
           tal:attributes="class python: 'survey-action-button action-pdf-form' + (' is-active' if current_url.endswith('/@@pdf-form') else '')"
           href="${context/absolute_url}/@@pdf-form">
          <span i18n:translate="">PDF Form</span>
        </a>
      </tal:pdfform>
      <a class="survey-action-button action-editor"
         tal:attributes="class python: 'survey-action-button action-editor' + (' is-active' if current_url.endswith('/@@editor') else '')"
         href="${context/absolute_url}/@@editor">
        <span i18n:translate="">Visual Editor</span>
      </a>
      <a class="survey-action-button action-versions"
         tal:attributes="class python: 'survey-action-button action-versions' + (' is-active' if current_url.endswith('/@@form-versions') else '')"
         href="${context/absolute_url}/@@form-versions">
        <span i18n:translate="">Versions</span>
      </a>
      <tal:ai tal:condition="python: view.feature_enabled('ai-generator')">
        <a class="survey-action-button action-ai"
           tal:attributes="class python: 'survey-action-button action-ai' + (' is-active' if current_url.endswith('/@@ai') else '')"
           href="${context/absolute_url}/@@ai">
          <span i18n:translate="">AI Generator</span>
        </a>
      </tal:ai>
      <a class="survey-action-button action-results"
         tal:attributes="class python: 'survey-action-button action-results' + (' is-active' if current_url.endswith('/@@results') else '')"
         href="${context/absolute_url}/@@results">
        <span i18n:translate="">Results</span>
      </a>
      <tal:dashboard tal:condition="python: view.feature_enabled('dashboard')">
        <a class="survey-action-button action-dashboard"
           tal:attributes="class python: 'survey-action-button action-dashboard' + (' is-active' if current_url.endswith('/@@dashboard') else '')"
           href="${context/absolute_url}/@@dashboard">
          <span i18n:translate="">Dashboard</span>
        </a>
      </tal:dashboard>
      <tal:manager tal:condition="view/is_manager">
        <tal:pdfimporter tal:condition="python: view.feature_enabled('pdf-form-import')">
          <a class="survey-action-button action-pdf-importer"
             tal:attributes="class python: 'survey-action-button action-pdf-importer' + (' is-active' if current_url.endswith('/@@pdf-importer') else '')"
             href="${context/absolute_url}/@@pdf-importer">
            <span i18n:translate="">Form from PDF</span>
          </a>
        </tal:pdfimporter>
        <tal:pdfgenerator tal:condition="python: view.feature_enabled('pdf-generator')">
          <a class="survey-action-button action-pdf-generator"
             tal:attributes="class python: 'survey-action-button action-pdf-generator' + (' is-active' if current_url.endswith('/@@pdf-generator') else '')"
             href="${context/absolute_url}/@@pdf-generator">
            <span i18n:translate="">PDF Generator</span>
            <span class="beta-badge" i18n:translate="">Beta</span>
          </a>
        </tal:pdfgenerator>
        <tal:pdfformsetup tal:condition="python: view.feature_enabled('fillable-pdf...')">
          <a class="survey-action-button action-pdf-form-setup"
             tal:attributes="class python: 'survey-action-button action-pdf-form-setup' + (' is-active' if current_url.endswith('/@@pdf-form-setup') else '')"
             href="${context/absolute_url}/@@pdf-form-setup">
            <span i18n:translate="">Fillable PDF Forms</span>
            <span class="beta-badge" i18n:translate="">Beta</span>
          </a>
        </tal:pdfformsetup>
      </tal:manager>
      <tal:notmanager tal:condition="not: view/is_manager">
        <tal:pdfimporter tal:condition="python: view.feature_enabled('pdf-form-import')">
          <span class="survey-action-button action-pdf-importer is-disabled"
                aria-disabled="true">
            <span i18n:translate="">Form from PDF</span>
            <span class="manager-badge" aria-label="Manager only" title="Manager only">&#128274;</span>
          </span>
        </tal:pdfimporter>
        <tal:pdfgenerator tal:condition="python: view.feature_enabled('pdf-generator')">
          <span class="survey-action-button action-pdf-generator is-disabled"
                aria-disabled="true">
            <span i18n:translate="">PDF Generator</span>
            <span class="beta-badge" i18n:translate="">Beta</span>
            <span class="manager-badge" aria-label="Manager only" title="Manager only">&#128274;</span>
          </span>
        </tal:pdfgenerator>
        <tal:pdfformsetup tal:condition="python: view.feature_enabled('fillable-pdf...')">
          <span class="survey-action-button action-pdf-form-setup is-disabled"
                aria-disabled="true">
            <span i18n:translate="">Fillable PDF Forms</span>
            <span class="beta-badge" i18n:translate="">Beta</span>
            <span class="manager-badge" aria-label="Manager only" title="Manager only">&#128274;</span>
          </span>
        </tal:pdfformsetup>
      </tal:notmanager>
    </div>
  </div>
</metal:survey_actions>

<metal:survey_header define-macro="survey-header">
  <div class="survey-header"
       tal:define="header_class header_class | nothing"
       tal:attributes="class python: 'survey-header' + (' ' + header_class if header_class else '')">
    <div class="survey-header-top">
      <div class="survey-header-main">
        <div class="survey-header-view">
          <metal:survey-header-headline define-slot="view-headline">
            <h2 i18n:translate="">Survey</h2>
          </metal:survey-header-headline>
          <metal:survey-header-subtitle define-slot="view-subtitle" />
        </div>
        <div class="survey-form-meta">
          <div class="survey-header-title-line">
            <span class="survey-form-title" tal:content="context/Title">Survey title</span>
          </div>
          <div class="survey-form-description"
               tal:condition="context/Description"
               tal:content="context/Description">Survey description</div>
          <metal:survey-status
              use-macro="context/@@survey-actions/macros/survey-status"
          />
        </div>
      </div>
    </div>
    <div class="survey-header-actions">
      <metal:survey-actions
          use-macro="context/@@survey-actions/macros/survey-actions"
      />
    </div>
  </div>
</metal:survey_header>

<metal:survey_header_critical define-macro="survey-header-critical">
  <style type="text/css">
    #content > header,
    article > header,
    #parent-fieldname-title,
    #parent-fieldname-description,
    .documentFirstHeading,
    .documentDescription {
      display: none;
    }
  </style>
</metal:survey_header_critical>

<metal:feature_disabled define-macro="feature-disabled">
  <div class="survey-feature-disabled">
    <p i18n:translate="">Feature disabled, access forbidden.</p>
  </div>
</metal:feature_disabled>

<metal:survey_status define-macro="survey-status">
  <tal:status tal:condition="view/can_manage_portal_content"
              tal:define="status view/survey_status_label;
                           effective view/survey_effective_display;
                           expires view/survey_expires_display;
                           results_count view/survey_results_count">
    <div class="survey-status-bar">
      <span class="survey-status-item">
        <strong i18n:translate="">Status</strong>:
        <span tal:content="status">Published</span>
      </span>
      <span class="survey-status-item"
            tal:condition="effective">
        <strong i18n:translate="">Effective</strong>:
        <span tal:content="effective">2024-01-01</span>
      </span>
      <span class="survey-status-item"
            tal:condition="expires">
        <strong i18n:translate="">Expires</strong>:
        <span tal:content="expires">2025-01-01</span>
      </span>
      <span class="survey-status-item">
        <strong i18n:translate="">Stored results</strong>:
        <span tal:content="results_count">0</span>
      </span>
    </div>
  </tal:status>
</metal:survey_status>
