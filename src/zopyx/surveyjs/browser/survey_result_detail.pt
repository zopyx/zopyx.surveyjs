<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      metal:use-macro="context/main_template/macros/master"
      i18n:domain="zopyx.surveyjs">

<metal:block fill-slot="style_slot">
  <metal:survey-header-critical
      use-macro="context/@@survey-actions/macros/survey-header-critical"
  />
</metal:block>

<metal:block fill-slot="content-core"
             tal:define="portal_state context/@@plone_portal_state">

    <metal:surveyjs-vars-base
        use-macro="context/@@survey-assets/macros/surveyjs-vars-base"
    />
    <metal:surveyjs-i18n-scripts
        use-macro="context/@@survey-assets/macros/surveyjs-i18n-scripts"
    />

    <link rel="stylesheet"
          type="text/css"
          href="++resource++zopyx.surveyjs/results.css"
    />
    <metal:surveyjs-viewer-css
        use-macro="context/@@survey-assets/macros/surveyjs-viewer-css"
    />

    <metal:survey-header use-macro="context/@@survey-actions/macros/survey-header">
      <metal:survey-header-headline fill-slot="view-headline">
        <div class="page-headline" i18n:translate="">Submission details</div>
      </metal:survey-header-headline>
    </metal:survey-header>

    <tal:block define="detail view/result_detail">
        <tal:block tal:condition="python: detail.get('error')">
            <div class="storage-warning result-detail-state">
                <strong i18n:translate="">Unable to load submission.</strong>
                <span tal:content="python: detail.get('error')">Error</span>
            </div>
            <p>
                <a class="btn btn-secondary"
                   href="${context/absolute_url}/@@results" i18n:translate="">Back to results</a>
            </p>
        </tal:block>

        <tal:block tal:condition="python: not detail.get('error')">
            <article class="result-detail-inspector" aria-labelledby="result-detail-title">
                <header class="result-detail-header">
                    <div>
                        <p class="result-detail-eyebrow" i18n:translate="">Stored submission</p>
                        <h1 id="result-detail-title" class="result-detail-title">
                            <span tal:content="detail/poll_id">Poll</span>
                        </h1>
                    </div>
                    <a class="btn btn-secondary result-detail-back"
                       href="${context/absolute_url}/@@results" i18n:translate="">Back to results</a>
                </header>

                <dl class="result-detail-meta">
                    <div>
                        <dt i18n:translate="">Created</dt>
                        <dd tal:content="detail/created">Date</dd>
                    </div>
                    <div>
                        <dt i18n:translate="">Submitted by</dt>
                        <dd tal:content="detail/creator">User</dd>
                    </div>
                    <div tal:condition="python: detail.get('seq_no')">
                        <dt i18n:translate="">Sequence</dt>
                        <dd tal:content="python: detail.get('seq_no')">#</dd>
                    </div>
                </dl>

                <section class="result-detail-answers" aria-labelledby="result-detail-answers-title">
                    <div class="result-detail-section-heading">
                        <h2 id="result-detail-answers-title" i18n:translate="">Answers</h2>
                    </div>
                    <div class="survey-detail-output"
                         tal:content="structure detail/html"></div>
                </section>

                <footer class="result-detail-actions">
                    <span class="result-detail-actions-label" i18n:translate="">Export submission</span>
                    <div class="download-actions" id="downloadActions">
                        <a tal:repeat="fmt detail/formats"
                           class="btn btn-primary"
                           tal:attributes="href python: context.absolute_url() + '/download-result?poll_id=' + detail['poll_id'] + '&format=' + fmt['key']"
                           tal:content="fmt/label">Format</a>
                    </div>
                </footer>
            </article>
        </tal:block>
    </tal:block>

</metal:block>
</html>
