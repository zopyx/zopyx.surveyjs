<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      metal:use-macro="context/main_template/macros/master"
      i18n:domain="zopyx.surveyjs">

<metal:block fill-slot="content-core"
             tal:define="portal_state context/@@plone_portal_state">

    <script type="text/javascript"
            tal:content="string: SURVEYJS_I18N_LOCALE='${portal_state/language}'"
    ></script>
    <script type="text/javascript"
            tal:content="string: SURVEYJS_I18N_BASE='${context/portal_url}/++resource++zopyx.surveyjs/i18n'"
    ></script>
    <script src="++resource++zopyx.surveyjs/i18n.js"
            type="text/javascript"
    ></script>
    <script src="++resource++zopyx.surveyjs/i18n/en.js"
            type="text/javascript"
    ></script>
    <script tal:condition="python:portal_state.language() != 'en'"
            tal:attributes="src string:${context/portal_url}/++resource++zopyx.surveyjs/i18n/${portal_state/language}.js"
            type="text/javascript"
    ></script>

    <link rel="stylesheet"
          type="text/css"
          href="++resource++zopyx.surveyjs/results.css"
    />
    <link href="++resource++zopyx.surveyjs/viewer.css"
          rel="stylesheet"
          type="text/css"
    />

    <div class="survey-actions"
         tal:condition="view/can_manage_portal_content">
      <a class="survey-action-button action-view"
         href="${context/absolute_url}/@@viewer">
        <span i18n:translate="">View</span>
      </a>
      <a class="survey-action-button action-editor"
         href="${context/absolute_url}/@@editor">
        <span i18n:translate="">Visual Editor</span>
      </a>
      <a class="survey-action-button action-results"
         href="${context/absolute_url}/@@results">
        <span i18n:translate="">Form Results</span>
      </a>
      <a class="survey-action-button action-versions"
         href="${context/absolute_url}/@@form-versions">
        <span i18n:translate="">Versions</span>
      </a>
      <a class="survey-action-button action-ai"
         href="${context/absolute_url}/@@ai">
        <span i18n:translate="">AI Generator</span>
      </a>
      <tal:manager tal:condition="view/is_manager">
        <a class="survey-action-button action-pdf-importer"
           href="${context/absolute_url}/@@pdf-importer">
          <span i18n:translate="">PDF Form Import</span>
          <span class="beta-badge" i18n:translate="">Beta</span>
        </a>
      </tal:manager>
      <tal:notmanager tal:condition="not: view/is_manager">
        <span class="survey-action-button action-pdf-importer is-disabled"
              aria-disabled="true">
          <span i18n:translate="">PDF Form Import</span>
          <span class="beta-badge" i18n:translate="">Beta</span>
          <span class="manager-badge" i18n:translate="">Manager only</span>
        </span>
      </tal:notmanager>
    </div>

    <tal:status tal:condition="view/can_manage_portal_content"
                tal:define="status view/survey_status_label;
                             effective view/survey_effective_display;
                             expires view/survey_expires_display;
                             results_count view/survey_results_count">
      <div class="survey-status-bar">
        <span class="survey-status-item">
          <strong i18n:translate="">Status</strong>:
          <span tal:content="status">Published</span>
        </span>
        <span class="survey-status-item"
              tal:condition="effective">
          <strong i18n:translate="">Effective</strong>:
          <span tal:content="effective">2024-01-01</span>
        </span>
        <span class="survey-status-item"
              tal:condition="expires">
          <strong i18n:translate="">Expires</strong>:
          <span tal:content="expires">2025-01-01</span>
        </span>
        <span class="survey-status-item">
          <strong i18n:translate="">Stored results</strong>:
          <span tal:content="results_count">0</span>
        </span>
      </div>
    </tal:status>

    <tal:block define="detail view/result_detail">
        <tal:block tal:condition="python: detail.get('error')">
            <div class="storage-warning">
                <strong i18n:translate="">Unable to load submission.</strong>
                <span tal:content="python: detail.get('error')">Error</span>
            </div>
            <p>
                <a class="btn btn-secondary"
                   href="${context/absolute_url}/@@results" i18n:translate="">Back to results</a>
            </p>
        </tal:block>

        <tal:block tal:condition="python: not detail.get('error')">
            <h2 class="page-headline" i18n:translate="">Submission Details</h2>

            <div id="results-table">
                <p><strong i18n:translate="">Poll ID:</strong> <span tal:content="detail/poll_id">Poll</span></p>
                <p tal:condition="python: detail.get('seq_no')">
                    <strong i18n:translate="">Sequence:</strong> <span tal:content="python: detail.get('seq_no')">#</span>
                </p>
                <p><strong i18n:translate="">Created:</strong> <span tal:content="detail/created">Date</span></p>
                <p><strong i18n:translate="">User:</strong> <span tal:content="detail/creator">User</span></p>

                <div class="results-toolbar">
                    <a class="btn btn-secondary"
                       href="${context/absolute_url}/@@results" i18n:translate="">Back to results</a>
                </div>

                <ul id="downloadActions">
                    <li tal:repeat="fmt detail/formats">
                        <a class="btn btn-primary"
                           tal:attributes="href python: context.absolute_url() + '/download-result?poll_id=' + detail['poll_id'] + '&format=' + fmt['key']"
                           tal:content="fmt/label">Format</a>
                    </li>
                </ul>

                <div class="survey-detail-output"
                     tal:content="structure detail/html"></div>
            </div>
        </tal:block>
    </tal:block>

</metal:block>
</html>
