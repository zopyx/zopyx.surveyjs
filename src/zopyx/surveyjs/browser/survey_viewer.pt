<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      i18n:domain="zopyx.surveyjs"
      metal:use-macro="context/main_template/macros/master"
>

  <metal:block fill-slot="style_slot">
    <metal:survey-header-critical
        use-macro="context/@@survey-actions/macros/survey-header-critical"
    />
  </metal:block>

  <metal:block fill-slot="content-core"
               tal:define="portal_state context/@@plone_portal_state;
                           missing_token python: view.trusted_access_enabled and not request.get('access_token') and not view.can_manage_portal_content;
                           can_modify python: context.portal_membership.checkPermission('Modify portal content', context)">
    <metal:surveyjs-var-actual-url
        use-macro="context/@@survey-assets/macros/surveyjs-var-actual-url"
    />
    <metal:surveyjs-var-csrf
        use-macro="context/@@survey-assets/macros/surveyjs-var-csrf"
    />
    <metal:surveyjs-var-auth-token
        use-macro="context/@@survey-assets/macros/surveyjs-var-auth-token"
    />
    <script type="application/json"
            id="survey-viewer-config"
            tal:define="config_json python: __import__('json').dumps({'trustedAccessEnabled': bool(view.trusted_access_enabled), 'canManage': bool(view.can_manage_portal_content), 'surveyLanguages': list(getattr(context, 'survey_languages', []) or [])})"
            tal:content="structure config_json"></script>
    <metal:surveyjs-vars-base
        use-macro="context/@@survey-assets/macros/surveyjs-vars-base"
    />
    <metal:surveyjs-i18n-scripts
        use-macro="context/@@survey-assets/macros/surveyjs-i18n-scripts"
    />
    <metal:surveyjs-core
        use-macro="context/@@survey-assets/macros/surveyjs-core"
    />
    <metal:surveyjs-ui
        use-macro="context/@@survey-assets/macros/surveyjs-ui"
    />
    <metal:surveyjs-theme-contrast
        use-macro="context/@@survey-assets/macros/surveyjs-theme-contrast"
    />
    <script src="++resource++zopyx.surveyjs/viewer.js"
            type="text/javascript"
    ></script>
    <metal:surveyjs-viewer-css
        use-macro="context/@@survey-assets/macros/surveyjs-viewer-css"
    />

    <metal:survey-header tal:condition="python: can_modify and not missing_token"
                         use-macro="context/@@survey-actions/macros/survey-header">
      <metal:survey-header-headline fill-slot="view-headline">
        <div class="page-headline" i18n:translate="">View Form</div>
      </metal:survey-header-headline>
      <metal:survey-header-subtitle fill-slot="view-subtitle">
        <div class="page-subtitle" i18n:translate="">
          Preview the live survey experience.
        </div>
      </metal:survey-header-subtitle>
    </metal:survey-header>

    <tal:trusted tal:condition="python: view.can_manage_portal_content and view.trusted_access_enabled">
      <div class="survey-trusted-access"
           id="surveyTrustedAccess"
           data-token-endpoint="${context/absolute_url}/@@trusted-access-token">
        <details class="survey-trusted-access-details">
          <summary class="survey-trusted-access-summary">
            <strong i18n:translate="">Trusted access link</strong>
            <span class="survey-trusted-access-hint" i18n:translate="">
              Share this link to open the form.
            </span>
          </summary>
          <div class="survey-trusted-access-body">
            <div class="survey-trusted-access-row">
              <span class="survey-trusted-access-label" i18n:translate="">URL</span>
              <a class="survey-trusted-access-value"
                 id="surveyTrustedAccessUrl"
                 href="#"
                 rel="noopener"
                 target="_blank">-</a>
              <button class="survey-trusted-access-copy"
                      id="surveyTrustedAccessCopy"
                      type="button"
                      i18n:translate="">Copy link</button>
              <span class="survey-trusted-access-message"
                    id="surveyTrustedAccessMessage"
                    aria-live="polite"></span>
            </div>
            <div class="survey-trusted-access-row">
              <span class="survey-trusted-access-label" i18n:translate="">Token</span>
              <span class="survey-trusted-access-value"
                    id="surveyTrustedAccessToken">-</span>
            </div>
            <div class="survey-trusted-access-row">
              <span class="survey-trusted-access-label" i18n:translate="">Expires</span>
              <span class="survey-trusted-access-value"
                    id="surveyTrustedAccessExpires">-</span>
            </div>
          </div>
        </details>
      </div>
    </tal:trusted>

    <tal:trusted-access-state>
      <div id="surveyAccessError"
           class="survey-access-error"
           tal:attributes="hidden python: None if missing_token else 'hidden'">
        <div class="survey-access-error-card">
          <div class="survey-access-error-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" role="presentation" focusable="false">
              <path d="M12 2a7 7 0 0 1 7 7v3h1.2a1.8 1.8 0 0 1 1.8 1.8v6.4A1.8 1.8 0 0 1 20.2 22H3.8A1.8 1.8 0 0 1 2 20.2v-6.4A1.8 1.8 0 0 1 3.8 12H5V9a7 7 0 0 1 7-7Zm0 2a5 5 0 0 0-5 5v3h10V9a5 5 0 0 0-5-5Zm0 10.2a1.8 1.8 0 0 1 1.1 3.2l-.1 2a1 1 0 0 1-2 0l-.1-2A1.8 1.8 0 0 1 12 14.2Z"></path>
            </svg>
          </div>
          <div class="survey-access-error-body">
            <p class="survey-access-error-title" i18n:translate="">Trusted access required</p>
            <p class="survey-access-error-message" id="surveyAccessErrorMessage" i18n:translate="">
              This form requires a trusted access link. Please use the link provided by the form owner.
            </p>
            <div class="survey-access-error-meta">
              <p class="survey-access-error-meta-title"
                 tal:content="context/Title">Survey title</p>
              <p class="survey-access-error-meta-description"
                 tal:condition="context/Description"
                 tal:content="context/Description">Survey description</p>
            </div>
            <ul class="survey-access-error-steps">
              <li i18n:translate="">Ask the form owner for a trusted access link.</li>
              <li i18n:translate="">Open the link in this browser to continue.</li>
            </ul>
          </div>
        </div>
      </div>
      <div id="surveyViewerContainer"
           class="survey-viewer-container"
           tal:attributes="class python: 'survey-viewer-container survey-container-hidden' if missing_token else 'survey-viewer-container'; hidden python: 'hidden' if missing_token else None">
        <div class="survey-viewer-toolbar">
          <select id="surveyLanguageSelector"
                  class="survey-language-selector"
                  aria-label="Select language">
            <option value="en">English</option>
            <option value="de">Deutsch</option>
            <option value="it">Italiano</option>
            <option value="fr">Français</option>
            <option value="pl">Polski</option>
            <option value="ru">Русский</option>
            <option value="sr">Srpski</option>
            <option value="tr">Türkçe</option>
            <option value="vi">Tiếng Việt</option>
          </select>
          <a id="surveyViewerFullscreenToggle"
             class="survey-fullscreen-toggle"
             href="#"
             role="button"
             aria-pressed="false"
             i18n:translate=""
          >Fullscreen</a>
        </div>
        <div id="surveyContainer"></div>
      </div>
    </tal:trusted-access-state>

  </metal:block>
</html>
