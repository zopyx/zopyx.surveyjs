<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      metal:use-macro="context/main_template/macros/master"
      i18n:domain="zopyx.surveyjs">

<metal:block fill-slot="content-core"
             tal:define="portal_state context/@@plone_portal_state">

    <script type="text/javascript"
            tal:content="string: SURVEYJS_I18N_LOCALE='${portal_state/language}'"
    ></script>
    <script type="text/javascript"
            tal:content="string: SURVEYJS_I18N_BASE='${context/portal_url}/++resource++zopyx.surveyjs/i18n'"
    ></script>
    <script src="++resource++zopyx.surveyjs/i18n.js"
            type="text/javascript"
    ></script>
    <script src="++resource++zopyx.surveyjs/i18n/en.js"
            type="text/javascript"
    ></script>
    <script tal:condition="python:portal_state.language() != 'en'"
            tal:attributes="src string:${context/portal_url}/++resource++zopyx.surveyjs/i18n/${portal_state/language}.js"
            type="text/javascript"
    ></script>

    <link rel="stylesheet"
          type="text/css"
          href="++resource++zopyx.surveyjs/results.css"
    />
    <link href="++resource++zopyx.surveyjs/viewer.css"
          rel="stylesheet"
          type="text/css"
    />

    <metal:survey-actions
        use-macro="context/@@survey-actions/macros/survey-actions"
    />

    <metal:survey-status
        use-macro="context/@@survey-actions/macros/survey-status"
    />

    <tal:block define="results view/get_paginated_results">

        <h2 class="page-headline" i18n:translate="">Stored form data</h2>
        <p class="storage-info">
            <strong i18n:translate="">Storage:</strong>
            <span tal:content="view/storage_info">Storage</span>
        </p>

        <div id="results-table">

            <tal:block tal:condition="python: not view.storing_enabled">
                <div class="storage-warning">
                    <strong i18n:translate="">Storage disabled.</strong>
                    <span i18n:translate="">Results are not being saved because the "Store" action is turned off.</span>
                    <span i18n:translate="">Enable it in the survey settings to collect and view responses here.</span>
                </div>
            </tal:block>

            <tal:block tal:condition="view/storing_enabled">
                <form method="get" action="" class="results-search" tal:condition="python: results['total'] > 0">
                    <input type="text" name="q" placeholder="Search by user..." tal:attributes="value request/q|nothing" i18n:attributes="placeholder" />
                    <button type="submit" i18n:translate="">Search</button>
                </form>

                <div tal:condition="view/is_manager" style="display:none;"
                     tal:content="structure context/@@authenticator/authenticator"></div>

                <tal:block tal:condition="python: results['total'] > 0">
                    <table class="table">
                        <thead>
                        <tr>
                            <th tal:condition="view/is_manager" class="selection-column">
                                <input type="checkbox" id="select-all-results" aria-label="Select all results" i18n:attributes="aria-label" />
                            </th>
                            <th i18n:translate="">Date</th>
                            <th i18n:translate="">User</th>
                            <th i18n:translate="">#</th>
                            <th i18n:translate="">UUID</th>
                            <th i18n:translate="">Action</th>
                        </tr>
                        </thead>
                        <tbody>
                        <tr tal:repeat="item python:list(results['items'])">
                            <td tal:condition="view/is_manager" class="selection-column">
                                <input type="checkbox" class="result-select" tal:attributes="value item/poll_id" aria-label="Select result" i18n:attributes="aria-label" />
                            </td>
                            <td tal:content="python: view.format_created(item['created'])">Date</td>
                            <td tal:content="item/user">User</td>
                            <td tal:content="python: item.get('seq_no', '')">#</td>
                            <td tal:content="item/poll_id">UUID</td>
                            <td>
                                <div class="result-actions">
                                    <button class="btn btn-primary view-json"
                                            tal:attributes="data-poll-id item/poll_id"
                                            aria-label="JSON"
                                            i18n:attributes="aria-label">
                                        <span i18n:translate="">JSON</span>
                                    </button>
                                    <button class="btn btn-success view-details"
                                            tal:attributes="data-poll-id item/poll_id"
                                            aria-label="Table"
                                            i18n:attributes="aria-label">
                                        <span i18n:translate="">Table</span>
                                    </button>
                                    <a class="btn btn-secondary detail-link"
                                       tal:attributes="href string:${context/absolute_url}/@@result-detail?poll_id=${item/poll_id}"
                                       aria-label="Details"
                                       i18n:attributes="aria-label">
                                        <span i18n:translate="">Details</span>
                                    </a>
                          <form method="get" action="download-result" class="download-form">
                            <input type="hidden" name="_authenticator" tal:attributes="value context/@@authenticator/token" />
                            <input type="hidden" name="poll_id"
                                   tal:attributes="value item/poll_id" />
                            <select name="format">
                                <option tal:repeat="fmt view/converter_formats"
                                        tal:attributes="value fmt/key"
                                                    tal:content="fmt/short_label">
                                                Format
                                            </option>
                                        </select>
                                    <button class="btn btn-secondary download-result icon-only"
                                            type="submit"
                                            title="Download result"
                                            aria-label="Download result"
                                            i18n:attributes="title aria-label">
                                        <img src="++resource++zopyx.surveyjs/icon-download.svg"
                                             alt="Download result"
                                             title="Download result"
                                             i18n:attributes="alt title" />
                                    </button>
                                    <button class="btn btn-info mail-result icon-only"
                                            tal:condition="view/has_mail_action"
                                            type="submit"
                                            formaction="mail-result"
                                            title="Mail result"
                                            aria-label="Mail result"
                                            i18n:attributes="title aria-label">
                                        <img src="++resource++zopyx.surveyjs/icon-mail.svg"
                                             alt="Mail result"
                                             title="Mail result"
                                             i18n:attributes="alt title" />
                                    </button>
                                    <button class="btn btn-warning post-result icon-only"
                                            tal:condition="view/has_post_action"
                                            type="submit"
                                            formaction="post-result"
                                            formmethod="post"
                                            title="POST result"
                                            aria-label="POST result"
                                            i18n:attributes="title aria-label">
                                      <img src="++resource++zopyx.surveyjs/icon-post.svg"
                                           alt="POST result"
                                           title="POST result"
                                           i18n:attributes="alt title" />
                                    </button>
                                    <button class="btn btn-danger delete-result icon-only"
                                            type="button"
                                            tal:condition="view/is_manager"
                                            tal:attributes="data-poll-id item/poll_id"
                                            title="Delete result"
                                            aria-label="Delete result"
                                            i18n:attributes="title aria-label">
                                        <img src="++resource++zopyx.surveyjs/icon-trash.svg"
                                             alt="Delete result"
                                             title="Delete result"
                                             i18n:attributes="alt title" />
                                    </button>
                                </form>
                                </div>
                            </td>
                        </tr>                </tbody>
                    </table>

                    <div class="results-toolbar"
                         tal:condition="python: results['total'] > 0">
                        <button id="delete-selected-btn"
                                class="btn btn-danger"
                                tal:condition="view/is_manager"
                                disabled
                                i18n:translate="">Delete selected</button>
                        <button id="clear-results-btn" class="btn btn-danger" i18n:translate="">Clear all results</button>
                    </div>

                    <div class="pagination"
                         tal:define="pagination_info results;
                                     query_string python:request.get('q') and '&q=' + request.get('q') or ''"
                         tal:condition="python: pagination_info['numpages'] > 1">
                        <a tal:condition="python: pagination_info['page'] > 1"
                           tal:attributes="href python:'?b_start=' + str((pagination_info['page'] - 2) * pagination_info['pagesize']) + query_string"
                           i18n:translate="">&laquo; Previous</a>
                        <span tal:repeat="i python:range(1, pagination_info['numpages'] + 1)">
                  <a tal:condition="python: i != pagination_info['page']"
                     tal:attributes="href python:'?b_start=' + str((i - 1) * pagination_info['pagesize']) + query_string"
                     tal:content="i">
                  </a>
                  <span tal:condition="python: i == pagination_info['page']"
                        tal:content="i" class="current-page"></span>
                </span>
                        <a tal:condition="python: pagination_info['page'] < pagination_info['numpages']"
                           tal:attributes="href python:'?b_start=' + str(pagination_info['page'] * pagination_info['pagesize']) + query_string"
                           i18n:translate="">Next &raquo;</a>
                    </div>
                </tal:block>

                <tal:block tal:condition="python: results['total'] == 0">
                    <div class="no-results-message">
                        <svg class="no-results-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 11H3a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2v-6"></path>
                            <path d="M9 3h6v6"></path>
                            <path d="M9 9l6-6"></path>
                        </svg>
                        <h3 i18n:translate="">No Survey Results Yet</h3>
                        <p tal:condition="request/q|nothing" i18n:translate="">No results found matching your search query.</p>
                        <p tal:condition="not: request/q|nothing" i18n:translate="">There are no survey responses yet. Once users submit the survey, their responses will appear here.</p>
                    </div>
                </tal:block>
            </tal:block>
        </div>

        <tal:block tal:condition="view/storing_enabled">
            <!-- Modal for displaying JSON -->
            <div id="json-modal" class="modal" style="display:none;">
                <div class="modal-content">
                    <span class="close-button">&times;</span>
                    <pre id="json-content"></pre>
                </div>
            </div>

            <!-- Modal for displaying Details -->
            <div id="details-modal" class="modal" style="display:none;">
                <div class="modal-content modal-content-large">
                    <span class="close-button details-close-button">&times;</span>
                    <h2 i18n:translate="">Survey Response Details</h2>
                    <div id="details-content"></div>
                </div>
            </div>

            <!-- Modal for Clear Results Confirmation -->
            <div id="clear-confirm-modal" class="modal" style="display:none;">
                <div class="modal-content">
                    <span class="close-button clear-close-button">&times;</span>
                    <h2 i18n:translate="">Clear All Results</h2>
                    <div class="warning-message">
                        <p><strong i18n:translate="">Warning:</strong> <span i18n:translate="">This action will permanently delete all survey results. This cannot be undone.</span></p>
                        <p i18n:translate="">To confirm, please type <strong>clear</strong> in the field below:</p>
                    </div>
                    <input type="text"
                           id="clear-confirm-input"
                           data-clear-keyword="clear"
                           placeholder="Type 'clear' to confirm"
                           i18n:attributes="placeholder data-clear-keyword" />
                    <div class="modal-actions">
                        <button id="clear-confirm-btn" class="btn btn-danger" disabled i18n:translate="">Clear All Results</button>
                        <button id="clear-cancel-btn" class="btn btn-secondary" i18n:translate="">Cancel</button>
                    </div>
                </div>
            </div>

            <ul id="downloadActions" tal:condition="python: results['total'] > 0">
                <li>
                    <a href="download-polls-json" class="btn btn-primary" i18n:translate="">Download results (JSON)</a>
                </li>
                <li>
                    <a href="download-polls-csv" class="btn btn-primary" i18n:translate="">Download results (CSV)</a>
                </li>
                <li class="align-right">
                    <a href="download-form-json" class="btn btn-primary download-definition" i18n:translate="">Download form definition (JSON)</a>
                </li>
            </ul>
        </tal:block>

    </tal:block>

    <script src="++resource++zopyx.surveyjs/results.js"
            type="text/javascript"
    ></script>

</metal:block>
</html>
