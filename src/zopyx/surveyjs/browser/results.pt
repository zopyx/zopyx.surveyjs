<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      metal:use-macro="context/main_template/macros/master"
>

<metal:block fill-slot="content-core">

    <link rel="stylesheet"
          type="text/css"
          href="++resource++zopyx.surveyjs/results.css"
    />

    <tal:block define="results view/get_paginated_results">

        <h2 class="page-headline">Stored form data</h2>

        <div id="results-table">

            <tal:block tal:condition="python: not view.storing_enabled">
                <div class="storage-warning">
                    <strong>Storage disabled.</strong>
                    Results are not being saved because the "Store" action is turned off.
                    Enable it in the survey settings to collect and view responses here.
                </div>
            </tal:block>

            <tal:block tal:condition="view/storing_enabled">
                <form method="get" action="" tal:condition="python: results['total'] > 0">
                    <input type="text" name="q" placeholder="Search by user..." tal:attributes="value request/q|nothing" />
                    <button type="submit">Search</button>
                </form>

                <div tal:condition="view/is_manager" style="display:none;"
                     tal:content="structure context/@@authenticator/authenticator"></div>

                <div class="results-toolbar"
                     tal:condition="python: results['total'] > 0 and view.is_manager">
                    <button id="delete-selected-btn" class="btn btn-danger" disabled>Delete Selected</button>
                </div>

                <tal:block tal:condition="python: results['total'] > 0">
                    <table class="table">
                        <thead>
                        <tr>
                            <th tal:condition="view/is_manager" class="selection-column">
                                <input type="checkbox" id="select-all-results" aria-label="Select all results" />
                            </th>
                            <th>Date</th>
                            <th>User</th>
                            <th>UUID</th>
                            <th>Action</th>
                        </tr>
                        </thead>
                        <tbody>
                        <tr tal:repeat="item python:list(results['items'])">
                            <td tal:condition="view/is_manager" class="selection-column">
                                <input type="checkbox" class="result-select" tal:attributes="value item/poll_id" aria-label="Select result" />
                            </td>
                            <td tal:content="python: view.plone_api.portal.get_localized_time(item['created'], long_format=True)">Date</td>
                            <td tal:content="item/user">User</td>
                            <td tal:content="item/poll_id">UUID</td>
                            <td>
                                <div class="result-actions">
                                    <button class="btn btn-primary view-json"
                                            tal:attributes="data-poll-id item/poll_id">
                                        View
                                    </button>
                                    <button class="btn btn-success view-details"
                                            tal:attributes="data-poll-id item/poll_id">
                                        Details
                                    </button>
                                    <form method="get" action="download-result" class="download-form">
                                        <input type="hidden" name="poll_id"
                                               tal:attributes="value item/poll_id" />
                                        <select name="format">
                                            <option tal:repeat="fmt view/converter_formats"
                                                    tal:attributes="value fmt/key"
                                                    tal:content="fmt/label">
                                                Format
                                            </option>
                                        </select>
                                    <button class="btn btn-secondary download-result" type="submit">
                                        Download
                                    </button>
                                    <button class="btn btn-info mail-result"
                                            tal:condition="view/has_mail_action"
                                            type="submit"
                                            formaction="mail-result">
                                        Mail
                                    </button>
                                    <button class="btn btn-danger delete-result"
                                            type="button"
                                            tal:condition="view/is_manager"
                                            tal:attributes="data-poll-id item/poll_id">
                                        Delete
                                    </button>
                                </form>
                                </div>
                            </td>
                        </tr>                </tbody>
                    </table>

                    <div class="pagination"
                         tal:define="pagination_info results;
                                     query_string python:request.get('q') and '&q=' + request.get('q') or ''"
                         tal:condition="python: pagination_info['numpages'] > 1">
                        <a tal:condition="python: pagination_info['page'] > 1"
                           tal:attributes="href python:'?b_start=' + str((pagination_info['page'] - 2) * pagination_info['pagesize']) + query_string"
                        >&laquo; Previous</a>
                        <span tal:repeat="i python:range(1, pagination_info['numpages'] + 1)">
                  <a tal:condition="python: i != pagination_info['page']"
                     tal:attributes="href python:'?b_start=' + str((i - 1) * pagination_info['pagesize']) + query_string"
                     tal:content="i">
                  </a>
                  <span tal:condition="python: i == pagination_info['page']"
                        tal:content="i" class="current-page"></span>
                </span>
                        <a tal:condition="python: pagination_info['page'] < pagination_info['numpages']"
                           tal:attributes="href python:'?b_start=' + str(pagination_info['page'] * pagination_info['pagesize']) + query_string"
                        >Next &raquo;</a>
                    </div>
                </tal:block>

                <tal:block tal:condition="python: results['total'] == 0">
                    <div class="no-results-message">
                        <svg class="no-results-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 11H3a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2v-6"></path>
                            <path d="M9 3h6v6"></path>
                            <path d="M9 9l6-6"></path>
                        </svg>
                        <h3>No Survey Results Yet</h3>
                        <p tal:condition="request/q|nothing">No results found matching your search query.</p>
                        <p tal:condition="not: request/q|nothing">There are no survey responses yet. Once users submit the survey, their responses will appear here.</p>
                    </div>
                </tal:block>
            </tal:block>
        </div>

        <tal:block tal:condition="view/storing_enabled">
            <!-- Modal for displaying JSON -->
            <div id="json-modal" class="modal" style="display:none;">
                <div class="modal-content">
                    <span class="close-button">&times;</span>
                    <pre id="json-content"></pre>
                </div>
            </div>

            <!-- Modal for displaying Details -->
            <div id="details-modal" class="modal" style="display:none;">
                <div class="modal-content modal-content-large">
                    <span class="close-button details-close-button">&times;</span>
                    <h2>Survey Response Details</h2>
                    <div id="details-content"></div>
                </div>
            </div>

            <!-- Modal for Clear Results Confirmation -->
            <div id="clear-confirm-modal" class="modal" style="display:none;">
                <div class="modal-content">
                    <span class="close-button clear-close-button">&times;</span>
                    <h2>Clear All Results</h2>
                    <div class="warning-message">
                        <p><strong>Warning:</strong> This action will permanently delete all survey results. This cannot be undone.</p>
                        <p>To confirm, please type <strong>clear</strong> in the field below:</p>
                    </div>
                    <input type="text" id="clear-confirm-input" placeholder="Type 'clear' to confirm" />
                    <div class="modal-actions">
                        <button id="clear-confirm-btn" class="btn btn-danger" disabled>Clear All Results</button>
                        <button id="clear-cancel-btn" class="btn btn-secondary">Cancel</button>
                    </div>
                </div>
            </div>

            <ul id="downloadActions" tal:condition="python: results['total'] > 0">
                <li>
                    <a href="download-polls-json" class="btn btn-primary">Download data (JSON)</a>
                </li>
                <li>
                    <a href="download-form-json" class="btn btn-primary">Download form (JSON)</a>
                </li>
                <li>
                    <button id="clear-results-btn" class="btn btn-danger">Clear Results</button>
                </li>
            </ul>
        </tal:block>

    </tal:block>

    <script src="++resource++zopyx.surveyjs/results.js"
            type="text/javascript"
    ></script>

</metal:block>
</html>
