<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      metal:use-macro="context/main_template/macros/master"
      i18n:domain="zopyx.surveyjs">

<metal:block fill-slot="style_slot">
  <metal:survey-header-critical
      use-macro="context/@@survey-actions/macros/survey-header-critical"
  />
</metal:block>

<metal:block fill-slot="content-core"
             tal:define="portal_state context/@@plone_portal_state;
                         feature_ok python: view.require_feature('pdf-form-import');
                         ai_model view/get_ai_model">

  <tal:feature tal:condition="feature_ok">
    <metal:ai-provider-gate
        use-macro="context/@@survey-actions/macros/ai-provider-gate"
    >
      <metal:ai-enabled-content fill-slot="enabled-content">
        <metal:surveyjs-var-actual-url
            use-macro="context/@@survey-assets/macros/surveyjs-var-actual-url"
        />
        <metal:surveyjs-var-csrf
            use-macro="context/@@survey-assets/macros/surveyjs-var-csrf"
        />
        <metal:surveyjs-vars-base
            use-macro="context/@@survey-assets/macros/surveyjs-vars-base"
        />
        <metal:surveyjs-i18n-scripts
            use-macro="context/@@survey-assets/macros/surveyjs-i18n-scripts"
        />

        <metal:surveyjs-viewer-css
            use-macro="context/@@survey-assets/macros/surveyjs-viewer-css"
        />
        <link href="++resource++zopyx.surveyjs/pdf_importer.css"
              rel="stylesheet"
              type="text/css"
        />
        <metal:surveyjs-core
            use-macro="context/@@survey-assets/macros/surveyjs-core"
        />
        <metal:surveyjs-ui
            use-macro="context/@@survey-assets/macros/surveyjs-ui"
        />
        <metal:surveyjs-theme-index
            use-macro="context/@@survey-assets/macros/surveyjs-theme-index"
        />
        <script src="++resource++zopyx.surveyjs/pdf_importer.js"
                type="text/javascript"
        ></script>

        <metal:survey-header use-macro="context/@@survey-actions/macros/survey-header">
          <metal:survey-header-headline fill-slot="view-headline">
            <div class="page-headline" i18n:translate="">PDF Form Import</div>
          </metal:survey-header-headline>
          <metal:survey-header-subtitle fill-slot="view-subtitle">
            <div class="page-subtitle" i18n:translate="">
              Upload a PDF form and generate SurveyJS JSON from it
            </div>
          </metal:survey-header-subtitle>
        </metal:survey-header>

        <metal:ai-provider-notice
            use-macro="context/@@survey-actions/macros/ai-provider-notice"
        />

        <div class="pdf-importer-container">
        <div class="pdf-importer-docs">
          <a class="pdf-importer-docs-link"
             href="https://docs.privacyforms.studio/functionality_pdf_import_form.html"
             target="_blank"
             rel="noopener noreferrer"
             i18n:translate=""
          >
            DOCS
          </a>
        </div>

        <div class="pdf-importer-flow">
          <section class="pdf-importer-panel stage-upload">
            <div class="panel-title">
              <span i18n:translate="">Upload PDF</span>
            </div>
            <form id="pdfImporterForm" enctype="multipart/form-data">
              <div class="form-group">
                <div class="pdf-importer-file-row">
                  <input type="file"
                         id="pdfFile"
                         name="pdf_file"
                         class="form-control"
                         accept="application/pdf"
                         required
                  />
                  <button type="submit" class="btn btn-primary" id="importBtn">
                    <span class="btn-text" i18n:translate="">Convert PDF</span>
                    <span class="btn-spinner" id="importSpinner" style="display:none;">
                      <span class="spinner"></span>
                      <span i18n:translate="">Processing...</span>
                    </span>
                  </button>
                </div>
                <p class="help-block" i18n:translate="">
                  Choose a PDF that contains the form layout you want to convert.
                </p>
              </div>
              <div class="form-group">
                <div class="checkbox">
                  <label i18n:translate="">
                    <input type="checkbox"
                           id="pdfcpuValidationEnabled"
                           name="pdfcpu_validation"
                           checked="checked"
                    />
                    Form validation using pdfcpu
                  </label>
                </div>
                <p class="help-block" i18n:translate="">
                  When enabled, pdfcpu is used to validate and enrich form fields.
                </p>
              </div>
              <div class="form-group">
                <label for="pdfAdditionalPrompt" i18n:translate="">Additional prompt</label>
                <textarea id="pdfAdditionalPrompt"
                          name="additional_prompt"
                          class="form-control"
                          rows="3"
                          i18n:attributes="placeholder"
                          placeholder="Add extra conversion guidance..."
                ></textarea>
                <p class="help-block" i18n:translate="">
                  Optional instructions to guide the conversion.
                </p>
              </div>
              <div id="pdfImporterStatus" class="alert" style="display:none;"></div>
              <div class="button-group">
                <button type="button" class="btn btn-secondary" id="storeConvertedBtn" style="display:none;" disabled>
                  <span class="btn-text" i18n:translate="">Store converted form as new version</span>
                  <span class="btn-spinner" id="storeConvertedSpinner" style="display:none;">
                    <span class="spinner"></span>
                    <span i18n:translate="">Processing...</span>
                  </span>
                </button>
              </div>
            </form>

          </section>

          <section class="pdf-importer-panel stage-preview">
            <div class="panel-title" i18n:translate="">Preview</div>
            <div class="preview-grid">
              <div class="preview-card">
                <h3 i18n:translate="">PDF Preview</h3>
                <div class="preview-placeholder" id="pdfPreviewPlaceholder">
                  <span i18n:translate="">No PDF selected yet.</span>
                </div>
                <iframe id="pdfPreviewFrame"
                        title="PDF Preview"
                        i18n:attributes="title"
                        style="display:none;"
                        class="pdf-preview-frame"
                ></iframe>
              </div>
              <div class="preview-card">
                <h3 i18n:translate="">SurveyJS Preview</h3>
                <div class="preview-placeholder" id="surveyPreviewPlaceholder">
                  <span i18n:translate="">Generated form preview will appear here.</span>
                </div>
                <div id="surveyPreviewContainer" class="survey-preview-container"></div>
              </div>
            </div>
          </section>
        </div>
        </div>
      </metal:ai-enabled-content>
    </metal:ai-provider-gate>
  </tal:feature>

  <tal:feature-disabled tal:condition="not: feature_ok">
    <metal:feature-disabled
        use-macro="context/@@survey-actions/macros/feature-disabled"
    />
  </tal:feature-disabled>

</metal:block>
</html>
