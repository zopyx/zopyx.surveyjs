<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      metal:use-macro="context/main_template/macros/master"
      i18n:domain="zopyx.surveyjs">

<metal:block fill-slot="content-core"
             tal:define="portal_state context/@@plone_portal_state">

  <script type="text/javascript"
          tal:content="string: ACTUAL_URL='${context/absolute_url}'"
  ></script>
  <script type="text/javascript"
          tal:content="string: CSRF_TOKEN='${context/@@authenticator/token}'"
  ></script>
  <script type="text/javascript"
          tal:content="string: SURVEYJS_I18N_LOCALE='${portal_state/language}'"
  ></script>
  <script type="text/javascript"
          tal:content="string: SURVEYJS_I18N_BASE='${context/portal_url}/++resource++zopyx.surveyjs/i18n'"
  ></script>
  <script src="++resource++zopyx.surveyjs/i18n.js"
          type="text/javascript"
  ></script>
  <script src="++resource++zopyx.surveyjs/i18n/en.js"
          type="text/javascript"
  ></script>
  <script tal:condition="python:portal_state.language() != 'en'"
          tal:attributes="src string:${context/portal_url}/++resource++zopyx.surveyjs/i18n/${portal_state/language}.js"
          type="text/javascript"
  ></script>

  <link href="++resource++zopyx.surveyjs/viewer.css"
        rel="stylesheet"
        type="text/css"
  />
  <link href="++resource++zopyx.surveyjs/pdf_importer.css"
        rel="stylesheet"
        type="text/css"
  />
  <link href="https://unpkg.com/survey-core/survey-core.min.css"
        rel="stylesheet"
        type="text/css"
  />
  <script src="https://unpkg.com/survey-core/survey.core.min.js"
          type="text/javascript"
  ></script>
  <script src="https://unpkg.com/survey-core/survey.i18n.min.js"
          type="text/javascript"
  ></script>
  <script src="https://unpkg.com/survey-js-ui/survey-js-ui.min.js"
          type="text/javascript"
  ></script>
  <script src="https://unpkg.com/survey-core/themes/index.min.js"
          type="text/javascript"
  ></script>
  <script src="++resource++zopyx.surveyjs/pdf_importer.js"
          type="text/javascript"
  ></script>

  <metal:survey-actions
      use-macro="context/@@survey-actions/macros/survey-actions"
  />

  <metal:survey-status
      use-macro="context/@@survey-actions/macros/survey-status"
  />

  <div class="pdf-importer-container">
    <div class="pdf-importer-header">
      <div class="header-text">
        <h2 class="page-headline" i18n:translate="">PDF Form Importer</h2>
        <div class="subtitle page-subtitle" i18n:translate="">
          Upload a PDF form and generate SurveyJS JSON from it
        </div>
      </div>
    </div>

    <div class="pdf-importer-flow">
      <section class="pdf-importer-panel stage-upload">
        <div class="panel-title" i18n:translate="">Upload PDF</div>
        <form id="pdfImporterForm" enctype="multipart/form-data">
          <div class="form-group">
            <label for="pdfFile" i18n:translate="">PDF file</label>
            <input type="file"
                   id="pdfFile"
                   name="pdf_file"
                   class="form-control"
                   accept="application/pdf"
                   required
            />
            <p class="help-block" i18n:translate="">
              Choose a PDF that contains the form layout you want to convert.
            </p>
          </div>
          <div class="button-group">
            <button type="submit" class="btn btn-primary" id="importBtn">
              <span class="btn-text" i18n:translate="">Convert PDF</span>
              <span class="btn-spinner" id="importSpinner" style="display:none;">
                <span class="spinner"></span>
                <span i18n:translate="">Processing...</span>
              </span>
            </button>
            <button type="button" class="btn btn-secondary" id="storeConvertedBtn" style="display:none;" disabled>
              <span class="btn-text" i18n:translate="">Store converted form as new version</span>
              <span class="btn-spinner" id="storeConvertedSpinner" style="display:none;">
                <span class="spinner"></span>
                <span i18n:translate="">Processing...</span>
              </span>
            </button>
          </div>
        </form>

        <div id="pdfImporterStatus" class="alert" style="display:none;"></div>

        <div class="importer-note">
          <strong i18n:translate="">Heads up:</strong>
          <span i18n:translate="">
            This feature is experimental. Please review the generated form carefully.
          </span>
        </div>
      </section>

      <section class="pdf-importer-panel stage-preview">
        <div class="panel-title" i18n:translate="">Preview</div>
        <div class="preview-grid">
          <div class="preview-card">
            <h3 i18n:translate="">PDF Preview</h3>
            <div class="preview-placeholder" id="pdfPreviewPlaceholder">
              <span i18n:translate="">No PDF selected yet.</span>
            </div>
            <iframe id="pdfPreviewFrame"
                    title="PDF Preview"
                    i18n:attributes="title"
                    style="display:none;"
                    class="pdf-preview-frame"
            ></iframe>
          </div>
          <div class="preview-card">
            <h3 i18n:translate="">SurveyJS Preview</h3>
            <div class="preview-placeholder" id="surveyPreviewPlaceholder">
              <span i18n:translate="">Generated form preview will appear here.</span>
            </div>
            <div id="surveyPreviewContainer" class="survey-preview-container"></div>
          </div>
        </div>
      </section>
    </div>
  </div>

</metal:block>
</html>
