<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="zopyx.surveyjs">

  <!-- Set overrides folder for Just-a-Bunch-Of-Templates product -->
  <include package="z3c.jbot" file="meta.zcml" />

  <browser:page
    name="root-redirect"
    for="plone.base.interfaces.IPloneSiteRoot"
    permission="zope2.View"
    class=".views.RootRedirect"
  />
  <browser:page
    name="results"
    for="zopyx.surveyjs.content.survey.ISurvey"
    class=".views.Views"
    permission="cmf.ModifyPortalContent"
    template="results.pt"
  />
  <browser:page
    name="dashboard"
    for="zopyx.surveyjs.content.survey.ISurvey"
    class=".views.Views"
    permission="cmf.ManagePortal"
    template="dashboard.pt"
  />
  <browser:page
    name="pdf-generator"
    for="zopyx.surveyjs.content.survey.ISurvey"
    class=".views.Views"
    permission="cmf.ManagePortal"
    template="pdf_generator.pt"
  />
  <browser:page
    name="result-detail"
    for="zopyx.surveyjs.content.survey.ISurvey"
    class=".views.Views"
    permission="cmf.ModifyPortalContent"
    template="result_detail.pt"
  />
  <browser:page
    name="view-main"
    for="*"
    permission="zope2.View"
    class=".views.Views"
    template="view_main.pt"
  />

  <browser:page
    name="viewer"
    for="*"
    permission="zope2.View"
    class=".views.Views"
    template="viewer.pt"
  />

  <browser:page
    name="viewer-embed"
    for="*"
    permission="zope2.View"
    class=".views.EmbedViewer"
  />

  <browser:page
    name="editor"
    for="*"
    permission="cmf.ModifyPortalContent"
    class=".views.Views"
    template="editor.pt"
  />

  <browser:page 
    name="clear-results"
    permission="cmf.ModifyPortalContent"
    for="zopyx.surveyjs.content.survey.ISurvey"
    class=".views.Views"
    attribute="clear_results"

  />
  <browser:page 
    name="get-form-json"
    permission="zope2.View"
    for="zopyx.surveyjs.content.survey.ISurvey"
    class=".views.Views"
    attribute="get_form_json"

  />
  <browser:page 
    name="save-form-json"
    permission="zope2.View"
    for="zopyx.surveyjs.content.survey.ISurvey"
    class=".views.Views"
    attribute="save_form_json"
  />
  <browser:page 
    name="save-poll"
    permission="zope2.View"
    for="zopyx.surveyjs.content.survey.ISurvey"
    class=".views.Views"
    attribute="save_poll"
  />
  <browser:page 
    name="get-polls-json"
    permission="zope2.View"
    for="zopyx.surveyjs.content.survey.ISurvey"
    class=".views.Views"
    attribute="get_polls_json"
  />
  <browser:page
    name="get-polls-json2"
    permission="zope2.View"
    for="zopyx.surveyjs.content.survey.ISurvey"
    class=".views.Views"
    attribute="get_polls_json2"
  />

  <!-- Download endpoints with Content-Disposition attachment -->
  <browser:page
    name="download-form-json"
    permission="zope2.View"
    for="zopyx.surveyjs.content.survey.ISurvey"
    class=".views.Views"
    attribute="download_form_json"
  />
  <browser:page
    name="download-polls-json"
    permission="zope2.View"
    for="zopyx.surveyjs.content.survey.ISurvey"
    class=".views.Views"
    attribute="download_polls_json"
  />
  <browser:page
    name="download-polls-csv"
    permission="zope2.View"
    for="zopyx.surveyjs.content.survey.ISurvey"
    class=".views.Views"
    attribute="download_polls_csv"
  />
  <browser:page
    name="download-result"
    permission="cmf.ModifyPortalContent"
    for="zopyx.surveyjs.content.survey.ISurvey"
    class=".views.Views"
    attribute="download_result"
  />
  <browser:page
    name="mail-result"
    permission="cmf.ModifyPortalContent"
    for="zopyx.surveyjs.content.survey.ISurvey"
    class=".views.Views"
    attribute="mail_result"
  />
  <browser:page
    name="post-result"
    permission="cmf.ModifyPortalContent"
    for="zopyx.surveyjs.content.survey.ISurvey"
    class=".views.Views"
    attribute="post_result"
  />

  <!-- Form Versions Management -->
  <browser:page
    name="form-versions"
    for="zopyx.surveyjs.content.survey.ISurvey"
    permission="cmf.ModifyPortalContent"
    class=".views.Views"
    template="form_versions.pt"
  />
  <browser:page
    name="download-version"
    for="zopyx.surveyjs.content.survey.ISurvey"
    permission="cmf.ModifyPortalContent"
    class=".views.Views"
    attribute="download_version"
  />
  <browser:page
    name="restore-version"
    for="zopyx.surveyjs.content.survey.ISurvey"
    permission="cmf.ModifyPortalContent"
    class=".views.Views"
    attribute="restore_version"
  />
  <browser:page
    name="toggle-version-lock"
    for="zopyx.surveyjs.content.survey.ISurvey"
    permission="cmf.ModifyPortalContent"
    class=".views.Views"
    attribute="toggle_version_lock"
  />
  <browser:page
    name="delete-version"
    for="zopyx.surveyjs.content.survey.ISurvey"
    permission="cmf.ModifyPortalContent"
    class=".views.Views"
    attribute="delete_version"
  />
  <browser:page
    name="upload-version"
    for="zopyx.surveyjs.content.survey.ISurvey"
    permission="cmf.ModifyPortalContent"
    class=".views.Views"
    attribute="upload_version"
  />
  <browser:page
    name="view-version-json"
    for="zopyx.surveyjs.content.survey.ISurvey"
    permission="cmf.ModifyPortalContent"
    class=".views.Views"
    attribute="view_version_json"
  />

  <browser:page
    name="view-result-json"
    for="zopyx.surveyjs.content.survey.ISurvey"
    permission="cmf.ModifyPortalContent"
    class=".views.Views"
    attribute="view_result_json"
  />
  <browser:page
    name="delete-results"
    for="zopyx.surveyjs.content.survey.ISurvey"
    permission="cmf.ModifyPortalContent"
    class=".views.Views"
    attribute="delete_results"
  />

  <!-- AI Form Generator -->
  <browser:page
    name="ai"
    for="zopyx.surveyjs.content.survey.ISurvey"
    permission="cmf.ModifyPortalContent"
    class=".views.Views"
    template="ai.pt"
  />

  <!-- PDF Form Importer -->
  <browser:page
    name="pdf-importer"
    for="zopyx.surveyjs.content.survey.ISurvey"
    permission="cmf.ManagePortal"
    class=".views.Views"
    template="pdf_importer.pt"
  />

  <browser:page
    name="generate-ai-form"
    for="zopyx.surveyjs.content.survey.ISurvey"
    permission="cmf.ModifyPortalContent"
    class=".views.Views"
    attribute="generate_ai_form"
  />

  <browser:page
    name="save-ai-form"
    for="zopyx.surveyjs.content.survey.ISurvey"
    permission="cmf.ModifyPortalContent"
    class=".views.Views"
    attribute="save_ai_form"
  />

  <browser:page
    name="refine-ai-form"
    for="zopyx.surveyjs.content.survey.ISurvey"
    permission="cmf.ModifyPortalContent"
    class=".views.Views"
    attribute="refine_ai_form"
  />

  <browser:page
    name="import-pdf-form"
    for="zopyx.surveyjs.content.survey.ISurvey"
    permission="cmf.ManagePortal"
    class=".views.Views"
    attribute="import_pdf_form"
  />

  <browser:page
    name="store-pdf-form"
    for="zopyx.surveyjs.content.survey.ISurvey"
    permission="cmf.ManagePortal"
    class=".views.Views"
    attribute="store_pdf_form"
  />

  <!-- Forms Settings Control Panel -->
  <browser:page
    name="forms-settings"
    for="Products.CMFPlone.interfaces.IPloneSiteRoot"
    class=".controlpanel.FormsSettingsControlPanel"
    permission="cmf.ManagePortal"
  />


  <browser:jbot
      directory="overrides"
      layer="zopyx.surveyjs.interfaces.IZopyxSurveyjsLayer"
      />

  <!-- Publish static files -->
  <browser:resourceDirectory
      name="zopyx.surveyjs"
      directory="static"
      />

</configure>
