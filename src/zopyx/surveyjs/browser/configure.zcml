<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="zopyx.surveyjs">

  <!-- Set overrides folder for Just-a-Bunch-Of-Templates product -->
  <include package="z3c.jbot" file="meta.zcml" />

  <browser:page
    name="root-redirect"
    for="plone.base.interfaces.IPloneSiteRoot"
    permission="zope2.View"
    class=".views.RootRedirect"
  />
  <browser:page
    name="pfs"
    for="Products.CMFCore.interfaces.IFolderish"
    permission="zope2.View"
    class=".psf.PFSView"
    template="pfs.pt"
  />
  <browser:menuItem
    for="Products.CMFCore.interfaces.IFolderish"
    menu="plone_displayviews"
    title="Forms overview"
    action="@@pfs"
    description="Open Forms overview"
  />
  <browser:page
    name="survey-add"
    for="*"
    permission="zopyx.surveyjs.AddSurvey"
    class=".survey_add.SurveyAddView"
  />
  <browser:page
    name="survey-metadata"
    for="zopyx.surveyjs.content.survey.ISurvey"
    permission="cmf.ModifyPortalContent"
    class=".survey_metadata.SurveyMetadata"
  />
  <browser:page
    name="demo-content"
    for="plone.base.interfaces.IPloneSiteRoot"
    permission="cmf.ManagePortal"
    class=".demo_content.DemoContent"
  />
  <browser:page
    name="results"
    for="zopyx.surveyjs.content.survey.ISurvey"
    class=".survey_results.SurveyResults"
    permission="cmf.ModifyPortalContent"
    template="survey_results.pt"
  />
  <browser:page
    name="dashboard"
    for="zopyx.surveyjs.content.survey.ISurvey"
    class=".survey_dashboard.SurveyDashboard"
    permission="cmf.ModifyPortalContent"
    template="survey_dashboard.pt"
  />
  <browser:page
    name="survey-overview"
    for="*"
    class=".survey_overview.SurveyOverview"
    permission="cmf.ManagePortal"
    template="survey_overview.pt"
  />
  <browser:page
    name="survey-templates-overview"
    for="*"
    class=".survey_templates_overview.SurveyTemplatesOverview"
    permission="cmf.ManagePortal"
    template="survey_templates_overview.pt"
  />
  <browser:page
    name="pdf-generator"
    for="zopyx.surveyjs.content.survey.ISurvey"
    class=".views.Views"
    permission="cmf.ManagePortal"
    template="pdf_generator.pt"
  />
  <browser:page
    name="result-detail"
    for="zopyx.surveyjs.content.survey.ISurvey"
    class=".survey_results.SurveyResults"
    permission="cmf.ModifyPortalContent"
    template="survey_result_detail.pt"
  />
  <browser:page
    name="view-main"
    for="*"
    permission="zope2.View"
    class=".views.Views"
    template="view_main.pt"
  />

  <browser:page
    name="viewer"
    for="*"
    permission="zope2.View"
    class=".views.Views"
    template="survey_viewer.pt"
  />
  <browser:page
    name="viewer"
    for="zopyx.surveyjs.content.survey_template.ISurveyTemplate"
    permission="zope2.View"
    class=".survey_template_views.SurveyTemplateViewer"
    template="survey_template_viewer.pt"
  />
  <browser:page
    name="get-template-json"
    for="zopyx.surveyjs.content.survey_template.ISurveyTemplate"
    permission="zope2.View"
    class=".survey_template_views.SurveyTemplateViewer"
    attribute="get_template_json"
  />

  <browser:page
    name="viewer-embed"
    for="*"
    permission="zope2.View"
    class=".views.EmbedViewer"
  />
  <browser:page
    name="embedded-demo"
    for="*"
    permission="cmf.ManagePortal"
    class=".views.EmbeddedDemoView"
    template="embedded_demo.pt"
  />
  <browser:page
    name="feature-disabled"
    for="*"
    permission="zope2.View"
    class=".views.Views"
    template="feature_disabled.pt"
  />

  <browser:page
    name="survey-actions"
    for="*"
    permission="zope2.View"
    class=".views.Views"
    template="survey_actions.pt"
  />

  <browser:page
    name="survey-assets"
    for="*"
    permission="zope2.View"
    class=".views.Views"
    template="survey_assets.pt"
  />

  <browser:page
    name="editor"
    for="*"
    permission="cmf.ModifyPortalContent"
    class=".survey_editor.SurveyEditor"
    template="survey_editor.pt"
  />

  <browser:page 
    name="clear-results"
    permission="cmf.ModifyPortalContent"
    for="zopyx.surveyjs.content.survey.ISurvey"
    class=".views.Views"
    attribute="clear_results"

  />
  <browser:page 
    name="get-form-json"
    permission="zope2.View"
    for="zopyx.surveyjs.content.survey.ISurvey"
    class=".views.Views"
    attribute="get_form_json"

  />
  <browser:page
    name="trusted-access-token"
    permission="cmf.ModifyPortalContent"
    for="zopyx.surveyjs.content.survey.ISurvey"
    class=".views.Views"
    attribute="trusted_access_token"
  />
  <browser:page 
    name="save-form-json"
    permission="zope2.View"
    for="zopyx.surveyjs.content.survey.ISurvey"
    class=".views.Views"
    attribute="save_form_json"
  />
  <browser:page 
    name="save-poll"
    permission="zope2.View"
    for="zopyx.surveyjs.content.survey.ISurvey"
    class=".views.Views"
    attribute="save_poll"
  />
  <browser:page 
    name="get-polls-json"
    permission="zope2.View"
    for="zopyx.surveyjs.content.survey.ISurvey"
    class=".views.Views"
    attribute="get_polls_json"
  />
  <browser:page 
    name="get-polls-json2"
    permission="zope2.View"
    for="zopyx.surveyjs.content.survey.ISurvey"
    class=".views.Views"
    attribute="get_polls_json2"
  />
  <browser:page 
    name="create-template-from-version"
    permission="cmf.ModifyPortalContent"
    for="zopyx.surveyjs.content.survey.ISurvey"
    class=".survey_versions.SurveyVersions"
    attribute="create_template_from_version"
  />
  <browser:page
    name="results-data"
    permission="cmf.ModifyPortalContent"
    for="zopyx.surveyjs.content.survey.ISurvey"
    class=".survey_results.SurveyResults"
    attribute="results_data"
  />

  <!-- Download endpoints with Content-Disposition attachment -->
  <browser:page
    name="download-form-json"
    permission="zope2.View"
    for="zopyx.surveyjs.content.survey.ISurvey"
    class=".views.Views"
    attribute="download_form_json"
  />
  <browser:page
    name="download-polls-json"
    permission="zope2.View"
    for="zopyx.surveyjs.content.survey.ISurvey"
    class=".views.Views"
    attribute="download_polls_json"
  />
  <browser:page
    name="download-polls-csv"
    permission="zope2.View"
    for="zopyx.surveyjs.content.survey.ISurvey"
    class=".views.Views"
    attribute="download_polls_csv"
  />
  <browser:page
    name="download-result"
    permission="cmf.ModifyPortalContent"
    for="zopyx.surveyjs.content.survey.ISurvey"
    class=".survey_results.SurveyResults"
    attribute="download_result"
  />
  <browser:page
    name="mail-result"
    permission="cmf.ModifyPortalContent"
    for="zopyx.surveyjs.content.survey.ISurvey"
    class=".survey_results.SurveyResults"
    attribute="mail_result"
  />
  <browser:page
    name="post-result"
    permission="cmf.ModifyPortalContent"
    for="zopyx.surveyjs.content.survey.ISurvey"
    class=".survey_results.SurveyResults"
    attribute="post_result"
  />

  <!-- Form Versions Management -->
  <browser:page
    name="form-versions"
    for="zopyx.surveyjs.content.survey.ISurvey"
    permission="cmf.ModifyPortalContent"
    class=".survey_versions.SurveyVersions"
    template="survey_versions.pt"
  />
  <browser:page
    name="download-version"
    for="zopyx.surveyjs.content.survey.ISurvey"
    permission="cmf.ModifyPortalContent"
    class=".survey_versions.SurveyVersions"
    attribute="download_version"
  />
  <browser:page
    name="restore-version"
    for="zopyx.surveyjs.content.survey.ISurvey"
    permission="cmf.ModifyPortalContent"
    class=".survey_versions.SurveyVersions"
    attribute="restore_version"
  />
  <browser:page
    name="toggle-version-lock"
    for="zopyx.surveyjs.content.survey.ISurvey"
    permission="cmf.ModifyPortalContent"
    class=".survey_versions.SurveyVersions"
    attribute="toggle_version_lock"
  />
  <browser:page
    name="delete-version"
    for="zopyx.surveyjs.content.survey.ISurvey"
    permission="cmf.ModifyPortalContent"
    class=".survey_versions.SurveyVersions"
    attribute="delete_version"
  />
  <browser:page
    name="upload-version"
    for="zopyx.surveyjs.content.survey.ISurvey"
    permission="cmf.ModifyPortalContent"
    class=".survey_versions.SurveyVersions"
    attribute="upload_version"
  />
  <browser:page
    name="view-version-json"
    for="zopyx.surveyjs.content.survey.ISurvey"
    permission="cmf.ModifyPortalContent"
    class=".survey_versions.SurveyVersions"
    attribute="view_version_json"
  />

  <browser:page
    name="view-result-json"
    for="zopyx.surveyjs.content.survey.ISurvey"
    permission="cmf.ModifyPortalContent"
    class=".survey_results.SurveyResults"
    attribute="view_result_json"
  />
  <browser:page
    name="delete-results"
    for="zopyx.surveyjs.content.survey.ISurvey"
    permission="cmf.ModifyPortalContent"
    class=".survey_results.SurveyResults"
    attribute="delete_results"
  />

  <!-- AI Form Generator -->
  <browser:page
    name="ai"
    for="zopyx.surveyjs.content.survey.ISurvey"
    permission="cmf.ModifyPortalContent"
    class=".ai.AIView"
    template="ai.pt"
  />
  <browser:page
    name="ai-upload"
    for="zopyx.surveyjs.content.survey.ISurvey"
    permission="cmf.ModifyPortalContent"
    class=".ai.AIView"
    attribute="upload_document"
  />
  <browser:page
    name="ai-store-temp-version"
    for="zopyx.surveyjs.content.survey.ISurvey"
    permission="cmf.ModifyPortalContent"
    class=".ai.AIView"
    attribute="store_temp_as_version"
  />
  <browser:page
    name="ai-copy-latest-to-temp"
    for="zopyx.surveyjs.content.survey.ISurvey"
    permission="cmf.ModifyPortalContent"
    class=".ai.AIView"
    attribute="copy_latest_version_to_temp"
  />
  <browser:page
    name="ai-clear-temp-storage"
    for="zopyx.surveyjs.content.survey.ISurvey"
    permission="cmf.ModifyPortalContent"
    class=".ai.AIView"
    attribute="clear_temp_storage"
  />
  <browser:page
    name="ai-chat-refine"
    for="zopyx.surveyjs.content.survey.ISurvey"
    permission="cmf.ModifyPortalContent"
    class=".ai.AIView"
    attribute="chat_refine_temp_form"
  />
  <browser:page
    name="ai-restore-history-step"
    for="zopyx.surveyjs.content.survey.ISurvey"
    permission="cmf.ModifyPortalContent"
    class=".ai.AIView"
    attribute="restore_temp_history_step"
  />

  <!-- Chatbot -->
  <browser:page
    name="chatbot"
    for="zopyx.surveyjs.content.survey.ISurvey"
    permission="cmf.ModifyPortalContent"
    class=".chatbot.SurveyChatbot"
    template="chatbot.pt"
  />
  <browser:page
    name="chat-api"
    for="zopyx.surveyjs.content.survey.ISurvey"
    permission="cmf.ModifyPortalContent"
    class=".chatbot.SurveyChatbot"
    attribute="chatbot_api"
  />
  <browser:page
    name="chatbot-stats"
    for="zopyx.surveyjs.content.survey.ISurvey"
    permission="cmf.ModifyPortalContent"
    class=".chatbot.SurveyChatbot"
    attribute="chatbot_api_stats"
  />
  <browser:page
    name="chatbot-mgmt"
    for="zopyx.surveyjs.content.survey.ISurvey"
    permission="cmf.ManagePortal"
    class=".chatbot.SurveyChatbot"
    attribute="chatbot_mgmt"
  />
  <browser:page
    name="chatbot-index-local"
    for="zopyx.surveyjs.content.survey.ISurvey"
    permission="cmf.ManagePortal"
    class=".chatbot.SurveyChatbot"
    attribute="chatbot_index_local"
  />
  <browser:page
    name="chatbot-index-remote"
    for="zopyx.surveyjs.content.survey.ISurvey"
    permission="cmf.ManagePortal"
    class=".chatbot.SurveyChatbot"
    attribute="chatbot_index_remote"
  />
  <browser:page
    name="chatbot-reset"
    for="zopyx.surveyjs.content.survey.ISurvey"
    permission="cmf.ManagePortal"
    class=".chatbot.SurveyChatbot"
    attribute="chatbot_reset"
  />

  <!-- LLM Models List (Manager only, no navigation integration) -->
  <browser:page
    name="llm-models"
    for="Products.CMFPlone.interfaces.IPloneSiteRoot"
    permission="cmf.ManagePortal"
    class=".llm_models.LLMModelsView"
    template="llm_models.pt"
  />

  <!-- Fillable PDF -->
  <browser:page
    name="fillable-pdf"
    for="zopyx.surveyjs.content.survey.ISurvey"
    permission="cmf.ModifyPortalContent"
    class=".fillable_pdf.FillablePDFView"
    template="fillable_pdf.pt"
  />
  <browser:page
    name="fillable-pdf-upload"
    for="zopyx.surveyjs.content.survey.ISurvey"
    permission="cmf.ModifyPortalContent"
    class=".fillable_pdf.FillablePDFView"
    attribute="upload_pdf"
  />
  <browser:page
    name="fillable-pdf-download"
    for="zopyx.surveyjs.content.survey.ISurvey"
    permission="cmf.ModifyPortalContent"
    class=".fillable_pdf.FillablePDFView"
    attribute="download_pdf"
  />
  <browser:page
    name="fillable-pdf-delete"
    for="zopyx.surveyjs.content.survey.ISurvey"
    permission="cmf.ModifyPortalContent"
    class=".fillable_pdf.FillablePDFView"
    attribute="delete_pdf"
  />

  <!-- Survey Submission Monitor -->
  <browser:page
    name="survey-monitor"
    for="Products.CMFPlone.interfaces.IPloneSiteRoot"
    class=".survey_monitor.SurveyMonitorView"
    permission="cmf.ManagePortal"
    template="survey_monitor.pt"
  />

  <!-- Forms Settings Control Panel (SurveyJS-based) -->
  <browser:page
    name="forms-settings"
    for="Products.CMFPlone.interfaces.IPloneSiteRoot"
    class=".controlpanel.FormsSettingsView"
    permission="cmf.ManagePortal"
  />

  <!-- Direct DOM Embedding Views -->
  <browser:page
    name="embed-surveyjs"
    for="*"
    permission="zope2.View"
    class=".embed_direct.EmbedSurveyJSView"
  />

  <browser:page
    name="embed-token"
    for="zopyx.surveyjs.content.survey.ISurvey"
    permission="cmf.ModifyPortalContent"
    class=".embed_direct.EmbedDirectTokenView"
  />

  <browser:page
    name="embed-config"
    for="zopyx.surveyjs.content.survey.ISurvey"
    permission="zope2.View"
    class=".embed_direct.EmbedConfigView"
  />

  <browser:page
    name="embed-loader"
    for="zopyx.surveyjs.content.survey.ISurvey"
    permission="zope2.View"
    class=".embed_direct.EmbedLoaderView"
  />

  <browser:page
    name="embed-direct-demo"
    for="zopyx.surveyjs.content.survey.ISurvey"
    permission="cmf.ModifyPortalContent"
    class=".embed_direct.DirectEmbedDemoView"
  />


  <browser:jbot
      directory="overrides"
      layer="zopyx.surveyjs.interfaces.IZopyxSurveyjsLayer"
      />

  <!-- Publish static files -->
  <browser:resourceDirectory
      name="zopyx.surveyjs"
      directory="static"
      />

</configure>
