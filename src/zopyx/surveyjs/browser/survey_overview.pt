<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      i18n:domain="zopyx.surveyjs"
      metal:use-macro="context/main_template/macros/master"
>

  <metal:block fill-slot="content-core">
    <link rel="stylesheet"
          type="text/css"
          href="++resource++zopyx.surveyjs/vendor/tabulator.min.css"
    />
    <link rel="stylesheet"
          type="text/css"
          href="++resource++zopyx.surveyjs/survey_overview.css"
    />

    <h2 class="page-headline" i18n:translate="">Survey overview</h2>
    <div class="page-subtitle" i18n:translate="">
      Overview of surveys in this section and their submission status.
    </div>

    <tal:entries tal:define="entries view/survey_overview_entries">
      <tal:empty tal:condition="not: entries">
        <p i18n:translate="">No surveys found below this location.</p>
      </tal:empty>
      <tal:hasentries tal:condition="entries">
        <div class="survey-overview-grid-wrap">
          <div class="survey-overview-pager-row">
            <div id="survey-overview-pager" class="survey-overview-pager"></div>
          </div>
          <div id="survey-overview-grid"></div>
        </div>
        <script type="text/javascript"
                tal:define="entries_json python: __import__('json').dumps(entries)">
          window.SURVEY_OVERVIEW_DATA = ${structure: entries_json};
        </script>
        <script src="++resource++zopyx.surveyjs/vendor/tabulator.min.js"
                type="text/javascript"></script>
        <script src="++resource++zopyx.surveyjs/survey_overview.js"
                type="text/javascript"></script>
      </tal:hasentries>
    </tal:entries>
  </metal:block>
</html>
