<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      metal:use-macro="context/main_template/macros/master"
>

  <metal:block fill-slot="content-core">
    <script type="text/javascript"
            tal:content="string: ACTUAL_URL='${context/absolute_url}'"
    ></script>
    <script type="text/javascript"
            tal:content="string: CSRF_TOKEN='${context/@@authenticator/token}'"
    ></script>

    <link href="https://unpkg.com/survey-core/survey-core.min.css"
          rel="stylesheet"
          type="text/css"
    />
    <script src="https://unpkg.com/survey-core/survey.core.min.js"></script>
    <script src="https://unpkg.com/survey-js-ui/survey-js-ui.min.js"></script>

    <script src="https://unpkg.com/survey-core/themes/index.min.js"></script>

    <link href="https://unpkg.com/survey-creator-core/survey-creator-core.min.css"
          rel="stylesheet"
          type="text/css"
    />
    <script src="https://unpkg.com/survey-creator-core/survey-creator-core.min.js"></script>
    <script src="https://unpkg.com/survey-creator-core/i18n/german.js"></script>
    <script src="https://unpkg.com/survey-creator-js/survey-creator-js.min.js"></script>
    <script src="https://unpkg.com/survey-core/survey.i18n.min.js"></script>
    <script src="https://unpkg.com/survey-core/themes/contrast-dark.min.js"
            type="text/javascript"
    ></script>
    <script src="https://unpkg.com/survey-core/themes/contrast-light.min.js"
            type="text/javascript"
    ></script>

    <script src="++resource++zopyx.surveyjs/editor.js"
            type="text/javascript"
    ></script>

    <link href="++resource++zopyx.surveyjs/viewer.css"
          rel="stylesheet"
          type="text/css"
    />

    <link rel="stylesheet"
          type="text/css"
          href="++resource++zopyx.surveyjs/editor.css"
    />  

    <div class="survey-actions"
         tal:condition="view/can_manage_portal_content">
      <a class="survey-action-button action-view"
         href="${context/absolute_url}/@@viewer">
        <span i18n:translate="">View</span>
      </a>
      <a class="survey-action-button action-editor"
         href="${context/absolute_url}/@@editor">
        <span i18n:translate="">Visual Editor</span>
      </a>
      <a class="survey-action-button action-results"
         href="${context/absolute_url}/@@results">
        <span i18n:translate="">Form Results</span>
      </a>
      <a class="survey-action-button action-versions"
         href="${context/absolute_url}/@@form-versions">
        <span i18n:translate="">Versions</span>
      </a>
      <a class="survey-action-button action-ai"
         href="${context/absolute_url}/@@ai">
        <span i18n:translate="">AI Generator</span>
      </a>
      <tal:manager tal:condition="view/is_manager">
        <a class="survey-action-button action-pdf-importer"
           href="${context/absolute_url}/@@pdf-importer">
          <span i18n:translate="">PDF Form Import</span>
          <span class="beta-badge" i18n:translate="">Beta</span>
        </a>
      </tal:manager>
      <tal:notmanager tal:condition="not: view/is_manager">
        <span class="survey-action-button action-pdf-importer is-disabled"
              aria-disabled="true">
          <span i18n:translate="">PDF Form Import</span>
          <span class="beta-badge" i18n:translate="">Beta</span>
          <span class="manager-badge" i18n:translate="">Manager only</span>
        </span>
      </tal:notmanager>
    </div>

    <div id="surveyEditorContainer">
      <div id="surveyContainer"></div>
    </div>


  </metal:block>

</html>
