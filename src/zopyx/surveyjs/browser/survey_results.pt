<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      metal:use-macro="context/main_template/macros/master"
      i18n:domain="zopyx.surveyjs">

<metal:block fill-slot="style_slot">
  <metal:survey-header-critical
      use-macro="context/@@survey-actions/macros/survey-header-critical"
  />
</metal:block>

<metal:block fill-slot="content-core"
             tal:define="portal_state context/@@plone_portal_state">

    <metal:surveyjs-vars-base
        use-macro="context/@@survey-assets/macros/surveyjs-vars-base"
    />
    <metal:surveyjs-i18n-scripts
        use-macro="context/@@survey-assets/macros/surveyjs-i18n-scripts"
    />


    <link rel="stylesheet"
          type="text/css"
          href="++resource++zopyx.surveyjs/results.css"
    />
    <metal:surveyjs-viewer-css
        use-macro="context/@@survey-assets/macros/surveyjs-viewer-css"
    />

    <div id="surveyResultsContainer" class="results-shell">
        <metal:survey-header use-macro="context/@@survey-actions/macros/survey-header">
            <metal:survey-header-headline fill-slot="view-headline">
                <div class="page-headline" i18n:translate="">Stored form data</div>
            </metal:survey-header-headline>
            <metal:survey-header-subtitle fill-slot="view-subtitle">
                <div class="page-subtitle">
                    <strong i18n:translate="">Storage:</strong>
                    <span tal:content="view/storage_info">Storage</span>
                </div>
            </metal:survey-header-subtitle>
        </metal:survey-header>
        <div class="results-top-actions">
            <div class="results-docs">
                <a class="results-docs-link"
                   href="https://docs.privacyforms.studio/functionality_results.html"
                   target="_blank"
                   rel="noopener noreferrer"
                   i18n:translate=""
                >
                    DOCS
                </a>
            </div>
            <div class="results-fullscreen-toggle">
                <a id="surveyResultsFullscreenToggle"
                   class="survey-fullscreen-toggle"
                   href="#"
                   role="button"
                   aria-pressed="false"
                   i18n:translate=""
                >Fullscreen</a>
            </div>
        </div>

        <tal:block tal:condition="python: not view.storing_enabled">
            <div class="storage-warning">
                <strong i18n:translate="">Storage disabled.</strong>
                <span i18n:translate="">Results are not being saved because the "Store" action is turned off.</span>
                <span i18n:translate="">Enable it in the survey settings to collect and view responses here.</span>
            </div>
        </tal:block>

        <tal:block tal:condition="view/storing_enabled">
            <div class="results-toolbar">
                <div class="results-toolbar-left">
                    <label class="results-search">
                        <span class="sr-only" i18n:translate="">Search</span>
                        <input id="results-search-input" type="text" placeholder="Search by user, UUID, or date" i18n:attributes="placeholder" i18n:translate="" />
                    </label>
                    <button id="results-search-btn" class="btn btn-secondary" i18n:translate="">Search</button>
                    <button id="results-reset-btn" class="btn btn-danger" i18n:translate="">Reset</button>
                </div>
                <div class="results-toolbar-right">
                    <button id="results-refresh-btn" class="btn btn-secondary" i18n:translate="">Refresh</button>
                    <button id="results-delete-selected-btn"
                            class="btn btn-danger"
                            tal:condition="view/is_manager"
                            disabled
                            i18n:translate="">Delete selected</button>
                    <button id="results-clear-results-btn" class="btn btn-danger" i18n:translate="">Clear all results</button>
                </div>
            </div>

            <div tal:condition="view/is_manager" style="display:none;"
                 tal:content="structure context/@@authenticator/authenticator"></div>

            <div class="results-grid-wrap">
                <div class="results-pager-row">
                    <div class="results-total">
                        <span i18n:translate="">Results</span>:
                        <span id="results-total-count">0</span>
                    </div>
                    <div id="results-pager" class="results-pager"></div>
                </div>
                <div id="results-grid"></div>
            </div>

            <div class="results-export-row">
                <div class="results-export-left">
                    <div class="results-export-filters">
                        <div class="results-export-label" i18n:translate="">Export range</div>
                        <label class="results-export-field">
                            <span i18n:translate="">From</span>
                            <input type="date" id="results-export-from" />
                        </label>
                        <label class="results-export-field">
                            <span i18n:translate="">To</span>
                            <input type="date" id="results-export-to" />
                        </label>
                        <div id="results-export-warning" class="results-export-warning" role="alert" aria-live="polite" style="display:none;" i18n:translate="">
                            “To” date must be after “From” date.
                        </div>
                    </div>
                    <div class="results-export-actions">
                        <a href="download-polls-json" data-base-href="download-polls-json" class="btn btn-primary" i18n:translate="">Download results (JSON)</a>
                        <a href="download-polls-csv" data-base-href="download-polls-csv" class="btn btn-primary" i18n:translate="">Download results (CSV)</a>
                    </div>
                </div>
                <div class="results-export-right">
                    <a href="download-form-json" class="btn btn-primary download-definition" i18n:translate="">Download form definition (JSON)</a>
                </div>
            </div>

            <div id="json-modal" class="modal" style="display:none;">
                <div class="modal-content">
                    <span class="close-button">&times;</span>
                    <pre id="json-content"></pre>
                </div>
            </div>

            <div id="details-modal" class="modal" style="display:none;">
                <div class="modal-content modal-content-large">
                    <span class="close-button details-close-button">&times;</span>
                    <h2 i18n:translate="">Survey Response Details</h2>
                    <div id="details-content"></div>
                </div>
            </div>

            <div id="delete-confirm-modal" class="modal" style="display:none;">
                <div class="modal-content">
                    <span class="close-button delete-close-button">&times;</span>
                    <h2 i18n:translate="">Delete Result</h2>
                    <p i18n:translate="">This will permanently delete the selected result. This cannot be undone.</p>
                    <div class="modal-actions">
                        <button id="delete-confirm-btn" class="btn btn-danger" i18n:translate="">Delete</button>
                        <button id="delete-cancel-btn" class="btn btn-secondary" i18n:translate="">Cancel</button>
                    </div>
                </div>
            </div>

            <div id="delete-selected-confirm-modal" class="modal" style="display:none;">
                <div class="modal-content">
                    <span class="close-button delete-selected-close-button">&times;</span>
                    <h2 i18n:translate="">Delete Selected Results</h2>
                    <p id="delete-selected-message"></p>
                    <div class="modal-actions">
                        <button id="delete-selected-confirm-btn" class="btn btn-danger" i18n:translate="">Delete</button>
                        <button id="delete-selected-cancel-btn" class="btn btn-secondary" i18n:translate="">Cancel</button>
                    </div>
                </div>
            </div>

            <div id="clear-confirm-modal" class="modal" style="display:none;">
                <div class="modal-content">
                    <span class="close-button clear-close-button">&times;</span>
                    <h2 i18n:translate="">Clear All Results</h2>
                    <div class="warning-message">
                        <p><strong i18n:translate="">Warning:</strong> <span i18n:translate="">This action will permanently delete all survey results. This cannot be undone.</span></p>
                        <p i18n:translate="">To confirm, please type clear in the field below:</p>
                    </div>
                    <input type="text"
                           id="clear-confirm-input"
                           data-clear-keyword="clear"
                           placeholder="Type 'clear' to confirm"
                           i18n:attributes="placeholder data-clear-keyword" />
                    <div class="modal-actions">
                        <button id="clear-confirm-btn" class="btn btn-danger" disabled i18n:translate="">Clear All Results</button>
                        <button id="clear-cancel-btn" class="btn btn-secondary" i18n:translate="">Cancel</button>
                    </div>
                </div>
            </div>
        </tal:block>
    </div>

    <script type="application/json"
            id="results-config"
            tal:define="formats view/converter_formats;
                        is_manager view/is_manager;
                        has_mail view/has_mail_action;
                        has_post view/has_post_action;
                        auth_token context/@@authenticator/token;
                        config_json python: __import__('json').dumps({'resultsUrl': context.absolute_url() + '/@@results-data', 'detailUrlBase': context.absolute_url() + '/@@result-detail?poll_id=', 'viewJsonUrlBase': 'view-result-json?poll_id=', 'downloadUrl': 'download-result', 'authenticator': auth_token if is_manager else '', 'isManager': bool(is_manager), 'hasMailAction': bool(has_mail), 'hasPostAction': bool(has_post), 'converterFormats': formats})"
            tal:content="structure config_json"></script>
    <script src="++resource++zopyx.surveyjs/results.js"
            type="text/javascript"></script>

</metal:block>
</html>
