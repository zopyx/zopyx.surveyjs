<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      metal:use-macro="context/main_template/macros/master"
      i18n:domain="zopyx.surveyjs">

<metal:block fill-slot="style_slot">
  <metal:survey-header-critical
      use-macro="context/@@survey-actions/macros/survey-header-critical"
  />
  <style type="text/css">
    .ai2-container {
      max-width: 1160px;
      margin: 0 auto;
    }
    .ai2-header {
      margin-bottom: 16px;
    }
    .ai2-stack {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .ai2-container .panel {
      border: 1px solid #d7deea;
      border-radius: 14px;
      overflow: hidden;
      box-shadow: 0 8px 24px rgba(15, 23, 42, 0.1);
      background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
    }
    .ai2-container .panel-heading {
      background: linear-gradient(120deg, #edf5ff 0%, #ddeeff 100%);
      border-bottom: 1px solid #d7deea;
      padding: 12px 16px;
    }
    .ai2-container .panel-title {
      font-weight: 700;
      letter-spacing: 0.01em;
      color: #0f172a;
      margin: 0;
    }
    .ai2-container .panel-body {
      padding: 16px;
    }
    .ai2-eyebrow {
      display: inline-block;
      margin-bottom: 8px;
      font-size: 0.78rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #0f766e;
      font-weight: 700;
    }
    .ai2-intro {
      margin: 0;
      color: #334155;
      line-height: 1.45;
    }
    .ai2-container .form-control[type="file"] {
      border: 1px solid #c8d3e6;
      border-radius: 10px;
      background: #fff;
      padding: 10px;
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9);
    }
    .ai2-container .help-block {
      color: #54667d;
    }
    .ai2-actions-row {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }
    .ai2-actions-row form {
      margin: 0;
    }
    .ai2-status-box {
      border: 1px dashed #c9d8ea;
      border-radius: 10px;
      padding: 12px;
      background: #f9fcff;
    }
    .ai2-status-title {
      font-size: 0.84rem;
      font-weight: 700;
      color: #0f172a;
      margin: 0 0 4px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .ai2-preview-actions .help-block,
    .ai2-actions-row .help-block {
      margin: 0;
    }
    .ai2-section-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(220px, 300px);
      gap: 16px;
      align-items: start;
    }
    .ai2-action-pane {
      border: 1px solid #d8e1ee;
      border-radius: 12px;
      background: linear-gradient(180deg, #ffffff 0%, #f7fbff 100%);
      padding: 12px;
    }
    .ai2-action-pane h4 {
      margin: 0 0 8px;
      color: #0f172a;
      font-size: 0.95rem;
      font-weight: 700;
    }
    .ai2-action-group {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      margin-bottom: 10px;
    }
    .ai2-action-group form {
      margin: 0;
      align-self: center;
      width: 196px;
    }
    .ai2-action-group > button {
      align-self: center;
      width: 196px;
    }
    .ai2-action-group .ai2-action-btn {
      width: 100%;
      min-width: 0;
      text-align: center;
    }
    .ai2-chat-layout {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 14px;
    }
    .ai2-chat-box,
    .ai2-history-box {
      border: 1px solid #d8e1ee;
      border-radius: 10px;
      background: #fff;
      padding: 12px;
    }
    .ai2-chat-box h4,
    .ai2-history-box h4 {
      margin: 0 0 8px;
      font-size: 0.95rem;
      font-weight: 700;
      color: #0f172a;
    }
    .ai2-history-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
      max-height: 240px;
      overflow: auto;
    }
    .ai2-history-item {
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      padding: 8px;
      background: #f8fbff;
    }
    .ai2-history-meta {
      font-size: 0.8rem;
      color: #475569;
      margin-bottom: 6px;
      font-weight: 600;
    }
    .ai2-history-prompt {
      font-size: 0.84rem;
      color: #334155;
      margin-bottom: 8px;
      line-height: 1.3;
    }
    @media (max-width: 980px) {
      .ai2-chat-layout {
        grid-template-columns: 1fr;
      }
      .ai2-section-grid {
        grid-template-columns: 1fr;
      }
    }
    .ai2-preview-modal .modal-content {
      width: 80vw;
      max-width: 1200px;
      max-height: 80vh;
      overflow: auto;
      border-radius: 10px;
      border: 1px solid #d8dee9;
      box-shadow: 0 12px 30px rgba(15, 23, 42, 0.2);
      padding: 16px 18px;
    }
    .ai2-preview-modal h2 {
      margin-top: 0;
      margin-bottom: 12px;
      font-size: 1.15rem;
    }
    .ai2-preview-modal .close-button {
      font-size: 1.3rem;
      line-height: 1;
      opacity: 0.8;
    }
    .ai2-preview-modal .close-button:hover {
      opacity: 1;
    }
    #ai2SurveyPreviewContainer {
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      padding: 10px;
      background: #fff;
    }
    #ai2OpenPreviewBtn {
      white-space: normal;
    }
    .ai2-action-btn {
      border: 1px solid transparent;
      border-radius: 6px;
      font-weight: 600;
      letter-spacing: 0;
      font-size: 0.88rem;
      padding: 6px 12px;
      box-shadow: none;
      transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
    }
    .ai2-action-btn:hover,
    .ai2-action-btn:focus {
      transform: none;
      box-shadow: none;
      filter: none;
    }
    .ai2-action-btn:active {
      transform: translateY(0);
    }
    .ai2-action-btn[disabled] {
      opacity: 0.8;
      cursor: not-allowed;
      transform: none;
      filter: grayscale(0.08);
    }
    .ai2-btn-spinner {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    .ai2-spinner {
      width: 14px;
      height: 14px;
      border: 2px solid rgba(255, 255, 255, 0.35);
      border-top-color: #ffffff;
      border-radius: 50%;
      animation: ai2-spin 0.8s linear infinite;
    }
    @keyframes ai2-spin {
      to {
        transform: rotate(360deg);
      }
    }
    .ai2-btn-upload {
      background: #0f766e;
      border-color: #0f766e;
      color: #fff;
    }
    .ai2-btn-upload:hover,
    .ai2-btn-upload:focus {
      background: #0d6f68;
      border-color: #0d6f68;
      color: #fff;
    }
    .ai2-btn-copy {
      background: #2563eb;
      border-color: #2563eb;
      color: #fff;
    }
    .ai2-btn-copy:hover,
    .ai2-btn-copy:focus {
      background: #1d4ed8;
      border-color: #1d4ed8;
      color: #fff;
    }
    .ai2-btn-clear {
      background: #f59e0b;
      border-color: #f59e0b;
      color: #fff;
    }
    .ai2-btn-clear:hover,
    .ai2-btn-clear:focus {
      background: #d97706;
      border-color: #d97706;
      color: #fff;
    }
    .ai2-btn-preview {
      background: #0891b2;
      border-color: #0891b2;
      color: #fff;
    }
    .ai2-btn-preview:hover,
    .ai2-btn-preview:focus {
      background: #0b7f9b;
      border-color: #0b7f9b;
      color: #fff;
    }
    .ai2-btn-store {
      background: #15803d;
      border-color: #15803d;
      color: #fff;
    }
    .ai2-btn-store:hover,
    .ai2-btn-store:focus {
      background: #166534;
      border-color: #166534;
      color: #fff;
    }
    #ai2SurveyPreviewContainer {
      border: 1px solid #e5e7eb;
      border-radius: 10px;
      padding: 12px;
      background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9);
      max-height: 62vh;
      overflow: auto;
    }
    .ai2-preview-modal {
      position: fixed;
      inset: 0;
      z-index: 2000;
      background: rgba(15, 23, 42, 0.35);
      align-items: center;
      justify-content: center;
      padding: 16px;
    }
  </style>
</metal:block>

<metal:block fill-slot="content-core"
             tal:define="portal_state context/@@plone_portal_state">

  <metal:surveyjs-vars-base
      use-macro="context/@@survey-assets/macros/surveyjs-vars-base"
  />
  <metal:surveyjs-i18n-scripts
      use-macro="context/@@survey-assets/macros/surveyjs-i18n-scripts"
  />
  <metal:surveyjs-core
      use-macro="context/@@survey-assets/macros/surveyjs-core"
  />
  <metal:surveyjs-ui
      use-macro="context/@@survey-assets/macros/surveyjs-ui"
  />
  <metal:surveyjs-theme-index
      use-macro="context/@@survey-assets/macros/surveyjs-theme-index"
  />
  <metal:surveyjs-viewer-css
      use-macro="context/@@survey-assets/macros/surveyjs-viewer-css"
  />

  <div class="ai2-container">
    <div class="ai2-header">
      <metal:survey-header use-macro="context/@@survey-actions/macros/survey-header">
        <metal:survey-header-headline fill-slot="view-headline">
          <div class="page-headline" i18n:translate="">AI2 (Beta)</div>
        </metal:survey-header-headline>
      </metal:survey-header>
    </div>
    <div class="ai2-stack">
      <div class="panel">
        <div class="panel-heading">
          <h3 class="panel-title" i18n:translate="">1. Generate and Prepare Temporary Form</h3>
        </div>
        <div class="panel-body">
          <div class="ai2-section-grid">
            <div>
              <span class="ai2-eyebrow" i18n:translate="">Document To SurveyJS</span>
              <p class="ai2-intro" i18n:translate="">
                Upload a source document and generate a temporary SurveyJS form draft with AI.
              </p>
              <form method="post"
                    id="ai2UploadForm"
                    enctype="multipart/form-data"
                    style="margin-top: 14px;"
                    tal:attributes="action string:${context/absolute_url}/@@ai2-upload">
                <span tal:replace="structure context/@@authenticator/authenticator"></span>
                <div class="form-group">
                  <input type="file"
                         class="form-control"
                         name="document_file"
                         accept=".pdf,.docx,.odt,.html,.htm,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.oasis.opendocument.text,text/html"
                         required="required" />
                  <p class="help-block" i18n:translate="">
                    Accepted formats: PDF, DOCX, ODT, HTML.
                  </p>
                </div>
                <button type="submit"
                        class="btn ai2-action-btn ai2-btn-upload"
                        id="ai2UploadBtn">
                  <span id="ai2UploadBtnText" i18n:translate="">Upload and Convert</span>
                  <span id="ai2UploadBtnSpinner" class="ai2-btn-spinner" style="display:none;">
                    <span class="ai2-spinner"></span>
                    <span i18n:translate="">Uploading...</span>
                  </span>
                </button>
              </form>
              <script type="text/javascript">
                (function () {
                  const form = document.getElementById("ai2UploadForm");
                  const button = document.getElementById("ai2UploadBtn");
                  const text = document.getElementById("ai2UploadBtnText");
                  const spinner = document.getElementById("ai2UploadBtnSpinner");
                  if (!form || !button || !text || !spinner) {
                    return;
                  }
                  form.addEventListener("submit", function () {
                    button.disabled = true;
                    text.style.display = "none";
                    spinner.style.display = "inline-flex";
                  });
                })();
              </script>
            </div>
            <div class="ai2-action-pane">
              <h4 i18n:translate="">Temporary Actions</h4>
              <p class="help-block" i18n:translate="">
                Manage the temporary form and persist when ready.
              </p>
              <div class="ai2-action-group">
                <form method="post"
                      tal:attributes="action string:${context/absolute_url}/@@ai2-copy-latest-to-temp">
                  <span tal:replace="structure context/@@authenticator/authenticator"></span>
                  <button type="submit"
                          class="btn ai2-action-btn ai2-btn-copy"
                          i18n:translate="">Copy Latest Version</button>
                </form>
                <tal:has-temp-clear tal:condition="view/has_temp_form">
                  <form method="post"
                        tal:attributes="action string:${context/absolute_url}/@@ai2-clear-temp-storage">
                    <span tal:replace="structure context/@@authenticator/authenticator"></span>
                    <button type="submit"
                            class="btn ai2-action-btn ai2-btn-clear"
                            i18n:translate="">Clear Temporary</button>
                  </form>
                </tal:has-temp-clear>
                <tal:has-temp-actions tal:condition="view/has_temp_form">
                  <form method="post" action="#">
                    <button type="button"
                            class="btn ai2-action-btn ai2-btn-preview"
                            id="ai2OpenPreviewBtn"
                            i18n:translate="">Open SurveyJS Preview</button>
                  </form>
                  <form method="post"
                        tal:attributes="action string:${context/absolute_url}/@@ai2-store-temp-version">
                    <span tal:replace="structure context/@@authenticator/authenticator"></span>
                    <button type="submit"
                            class="btn ai2-action-btn ai2-btn-store"
                            i18n:translate="">Store as New Version</button>
                  </form>
                </tal:has-temp-actions>
              </div>
              <div class="ai2-status-box">
                <p class="ai2-status-title" i18n:translate="">Current Temporary State</p>
                <tal:temp-ok tal:condition="view/has_temp_form">
                  <p class="help-block" i18n:translate="">
                    Temporary form is available and can be previewed, refined, or stored as new version.
                  </p>
                </tal:temp-ok>
                <tal:temp-empty tal:condition="not: view/has_temp_form">
                  <p class="help-block" i18n:translate="">
                    No temporary form yet. Upload a document or copy the latest version.
                  </p>
                </tal:temp-empty>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <tal:has-temp-bottom tal:condition="view/has_temp_form">
      <div class="panel" style="margin-top: 16px;">
        <div class="panel-heading">
          <h3 class="panel-title" i18n:translate="">2. AI Chat Refinement</h3>
        </div>
        <div class="panel-body">
          <div class="ai2-chat-layout">
            <div class="ai2-chat-box">
              <h4 i18n:translate="">Improve Temporary Form</h4>
              <p class="help-block" i18n:translate="">
                Ask AI to change the current temporary form. Each prompt builds on the latest temporary version.
              </p>
              <form method="post"
                    id="ai2ChatForm"
                    tal:attributes="action string:${context/absolute_url}/@@ai2-chat-refine">
                <span tal:replace="structure context/@@authenticator/authenticator"></span>
                <div class="form-group">
                  <textarea name="chat_prompt"
                            class="form-control"
                            rows="4"
                            required="required"
                            i18n:attributes="placeholder"
                            placeholder="Example: Add a section for contact preferences and make email required."></textarea>
                </div>
                <button type="submit"
                        id="ai2ChatSubmitBtn"
                        class="btn ai2-action-btn ai2-btn-preview"
                        >
                  <span id="ai2ChatSubmitText" i18n:translate="">Apply AI Change</span>
                  <span id="ai2ChatSubmitSpinner" class="ai2-btn-spinner" style="display:none;">
                    <span class="ai2-spinner"></span>
                    <span i18n:translate="">Applying...</span>
                  </span>
                </button>
              </form>
              <script type="text/javascript">
                (function () {
                  const form = document.getElementById("ai2ChatForm");
                  const button = document.getElementById("ai2ChatSubmitBtn");
                  const text = document.getElementById("ai2ChatSubmitText");
                  const spinner = document.getElementById("ai2ChatSubmitSpinner");
                  if (!form || !button || !text || !spinner) {
                    return;
                  }
                  form.addEventListener("submit", function () {
                    button.disabled = true;
                    text.style.display = "none";
                    spinner.style.display = "inline-flex";
                  });
                })();
              </script>
            </div>
            <div class="ai2-history-box">
              <h4 i18n:translate="">History (max 5)</h4>
              <tal:history tal:condition="view/has_temp_history">
                <div class="ai2-history-list">
                  <div class="ai2-history-item"
                       tal:repeat="item view/temp_history_items">
                    <div class="ai2-history-meta">
                      <span i18n:translate="">Step back:</span>
                      <span tal:content="item/step_back">1</span>
                    </div>
                    <div class="ai2-history-prompt"
                         tal:content="item/prompt">Prompt text</div>
                    <form method="post"
                          tal:attributes="action string:${context/absolute_url}/@@ai2-restore-history-step">
                      <span tal:replace="structure context/@@authenticator/authenticator"></span>
                      <input type="hidden"
                             name="history_index"
                             tal:attributes="value item/history_index" />
                      <button type="submit"
                              class="btn btn-default btn-xs"
                              i18n:translate="">Restore</button>
                    </form>
                  </div>
                </div>
              </tal:history>
              <tal:nohistory tal:condition="not: view/has_temp_history">
                <p class="help-block" i18n:translate="">
                  No chat refinement history yet.
                </p>
              </tal:nohistory>
            </div>
          </div>
        </div>
      </div>

      <div id="ai2PreviewModal"
           class="modal ai2-preview-modal"
           style="display:none;">
        <div class="modal-content">
          <span id="ai2ClosePreviewBtn" class="close-button">&#215;</span>
          <h2 i18n:translate="">Temporary SurveyJS Preview</h2>
          <div id="ai2SurveyPreviewContainer"></div>
        </div>
      </div>
      <script type="application/json"
              id="ai2-temp-form-json"
              tal:define="temp_json python: __import__('json').dumps(view.temp_form_data)"
              tal:content="structure temp_json"></script>
      <script type="text/javascript">
        (function () {
          const holder = document.getElementById("ai2-temp-form-json");
          const target = document.getElementById("ai2SurveyPreviewContainer");
          const modal = document.getElementById("ai2PreviewModal");
          const openBtn = document.getElementById("ai2OpenPreviewBtn");
          const closeBtn = document.getElementById("ai2ClosePreviewBtn");
          if (!holder || !target || !modal || !openBtn || !closeBtn || typeof Survey === "undefined") {
            return;
          }
          let surveyInstance = null;
          let previewRendered = false;
          const renderPreview = function () {
            try {
              if (previewRendered) {
                return;
              }
              const formJson = JSON.parse(holder.textContent || "{}");
              target.innerHTML = "";
              surveyInstance = new Survey.Model(formJson);
              surveyInstance.mode = "display";
              surveyInstance.render(target);
              previewRendered = true;
            } catch (err) {
              target.innerHTML = "<div class='alert alert-danger'>SurveyJS preview failed.</div>";
            }
          };

          const openModal = function () {
            modal.style.display = "flex";
            document.body.style.overflow = "hidden";
            renderPreview();
          };

          const closeModal = function () {
            modal.style.display = "none";
            document.body.style.overflow = "";
          };

          openBtn.addEventListener("click", function () {
            openModal();
          });

          closeBtn.addEventListener("click", function () {
            closeModal();
          });

          modal.addEventListener("click", function (ev) {
            if (ev.target === modal) {
              closeModal();
            }
          });

          document.addEventListener("keydown", function (ev) {
            if (ev.key === "Escape") {
              if (modal.style.display === "flex") {
                closeModal();
              }
            }
          });
        })();
      </script>
    </tal:has-temp-bottom>
  </div>

</metal:block>
</html>
