<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      metal:use-macro="context/main_template/macros/master"
      i18n:domain="zopyx.surveyjs">

  <metal:block fill-slot="style_slot">
    <metal:survey-header-critical
        use-macro="context/@@survey-actions/macros/survey-header-critical"
    />
    <link rel="stylesheet"
          type="text/css"
          href="++resource++zopyx.surveyjs/token_store.css"
    />
  </metal:block>

  <metal:block fill-slot="content-core"
               tal:define="stats view/get_stats">

    <metal:survey-header use-macro="context/@@survey-actions/macros/survey-header">
      <metal:survey-header-headline fill-slot="view-headline">
        <div class="page-headline" i18n:translate="">Access Tokens</div>
      </metal:survey-header-headline>
      <metal:survey-header-subtitle fill-slot="view-subtitle">
        <div class="page-subtitle" i18n:translate="">
          Manage single-use access tokens for this survey.
        </div>
      </metal:survey-header-subtitle>
    </metal:survey-header>

    <div class="token-view">

      <!-- Stats Row - Clean display at top -->
      <div class="tv-stats-row" tal:condition="python: stats['total'] > 0">
        <div class="tv-stat-item">
          <span class="tv-stat-number total" tal:content="stats/total">0</span>
          <span class="tv-stat-label">Total</span>
        </div>
        <div class="tv-stat-item">
          <span class="tv-stat-number unused" tal:content="stats/unused">0</span>
          <span class="tv-stat-label">Unused</span>
        </div>
        <div class="tv-stat-item">
          <span class="tv-stat-number used" tal:content="stats/used">0</span>
          <span class="tv-stat-label">Used</span>
        </div>
      </div>

      <!-- Empty state when no tokens -->
      <p class="tv-empty" tal:condition="python: stats['total'] == 0">
        No tokens generated yet. Use the form below to create access tokens.
      </p>

      <!-- Main Action Box -->
      <div class="tv-action-box">
        <div class="tv-action-grid">
          
          <!-- Generate Section -->
          <div class="tv-generate">
            <h3>Generate New Tokens</h3>
            <form method="post" class="tv-form">
              <input type="hidden" name="_authenticator" 
                     tal:attributes="value context/@@authenticator/token" />
              <input type="number" name="num_tokens" min="1" max="10000" value="10" required="required" />
              <button type="submit" name="generate_tokens" class="tv-btn tv-btn-primary">Generate</button>
            </form>
          </div>

          <!-- Actions Section -->
          <div class="tv-actions" tal:condition="python: stats['total'] > 0">
            <h3 class="tv-actions-title">Export & Manage</h3>
            <form method="post" class="tv-action">
              <input type="hidden" name="_authenticator" 
                     tal:attributes="value context/@@authenticator/token" />
              <button type="submit" name="download_valid_tokens" class="tv-btn tv-btn-green">Download valid tokens</button>
            </form>
            <form method="post" class="tv-action">
              <input type="hidden" name="_authenticator" 
                     tal:attributes="value context/@@authenticator/token" />
              <button type="submit" name="download_all_tokens" class="tv-btn tv-btn-secondary">Download all tokens</button>
            </form>
            <form method="post" class="tv-action" onsubmit="return confirm('Clear all tokens?');">
              <input type="hidden" name="_authenticator" 
                     tal:attributes="value context/@@authenticator/token" />
              <button type="submit" name="clear_tokens" class="tv-btn tv-btn-red">Clear All</button>
            </form>
          </div>

        </div>
      </div>

      <!-- Help -->
      <div class="tv-help">
        <p><strong>How it works:</strong> Generate tokens to create unique access URLs. 
        Each token can only be used once. Download the CSV to distribute URLs to participants.</p>
      </div>

    </div>

  </metal:block>

</html>
