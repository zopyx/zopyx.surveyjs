<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      i18n:domain="zopyx.surveyjs"
      metal:use-macro="context/main_template/macros/master"
>

  <metal:block fill-slot="content-core"
               tal:define="portal_state context/@@plone_portal_state">
    <metal:surveyjs-var-actual-url
        use-macro="context/@@survey-assets/macros/surveyjs-var-actual-url"
    />
    <metal:surveyjs-var-csrf
        use-macro="context/@@survey-assets/macros/surveyjs-var-csrf"
    />
    <metal:surveyjs-var-auth-token
        use-macro="context/@@survey-assets/macros/surveyjs-var-auth-token"
    />
    <script type="text/javascript"
            tal:content="python: 'SURVEY_TRUSTED_ACCESS_ENABLED=%s;' % ('true' if view.trusted_access_enabled else 'false')">
    </script>
    <metal:surveyjs-vars-base
        use-macro="context/@@survey-assets/macros/surveyjs-vars-base"
    />
    <metal:surveyjs-i18n-scripts
        use-macro="context/@@survey-assets/macros/surveyjs-i18n-scripts"
    />
    <metal:surveyjs-core
        use-macro="context/@@survey-assets/macros/surveyjs-core"
    />
    <metal:surveyjs-ui
        use-macro="context/@@survey-assets/macros/surveyjs-ui"
    />
    <metal:surveyjs-theme-contrast
        use-macro="context/@@survey-assets/macros/surveyjs-theme-contrast"
    />
    <script src="++resource++zopyx.surveyjs/viewer.js"
            type="text/javascript"
    ></script>
    <metal:surveyjs-viewer-css
        use-macro="context/@@survey-assets/macros/surveyjs-viewer-css"
    />
    <style type="text/css">
      article > header {
        display: none;
      }
    </style>

    <metal:survey-actions
        use-macro="context/@@survey-actions/macros/survey-actions"
    />

    <metal:survey-status
        use-macro="context/@@survey-actions/macros/survey-status"
    />

    <tal:trusted tal:condition="python: view.can_manage_portal_content and view.trusted_access_enabled">
      <div class="survey-trusted-access"
           id="surveyTrustedAccess"
           data-token-endpoint="${context/absolute_url}/@@trusted-access-token">
        <details class="survey-trusted-access-details">
          <summary class="survey-trusted-access-summary">
            <strong i18n:translate="">Trusted access link</strong>
            <span class="survey-trusted-access-hint" i18n:translate="">
              Share this link to open the form.
            </span>
          </summary>
          <div class="survey-trusted-access-body">
            <div class="survey-trusted-access-row">
              <span class="survey-trusted-access-label" i18n:translate="">URL</span>
              <a class="survey-trusted-access-value"
                 id="surveyTrustedAccessUrl"
                 href="#"
                 rel="noopener"
                 target="_blank">-</a>
              <button class="survey-trusted-access-copy"
                      id="surveyTrustedAccessCopy"
                      type="button"
                      i18n:translate="">Copy link</button>
              <span class="survey-trusted-access-message"
                    id="surveyTrustedAccessMessage"
                    aria-live="polite"></span>
            </div>
            <div class="survey-trusted-access-row">
              <span class="survey-trusted-access-label" i18n:translate="">Token</span>
              <span class="survey-trusted-access-value"
                    id="surveyTrustedAccessToken">-</span>
            </div>
            <div class="survey-trusted-access-row">
              <span class="survey-trusted-access-label" i18n:translate="">Expires</span>
              <span class="survey-trusted-access-value"
                    id="surveyTrustedAccessExpires">-</span>
            </div>
          </div>
        </details>
      </div>
    </tal:trusted>

    <div id="surveyAccessError" class="survey-access-error" hidden="hidden"></div>
    <div id="surveyContainer"></div>

  </metal:block>
</html>
