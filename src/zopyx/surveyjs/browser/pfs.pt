<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      i18n:domain="zopyx.surveyjs"
      metal:use-macro="context/main_template/macros/master">

  <metal:styles fill-slot="style_slot">
    <style type="text/css">
      .pfs-hero {
        background: linear-gradient(135deg, #eef4ff, #fdfdff);
        border-radius: 18px;
        padding: 2.5rem;
        box-shadow: 0 25px 60px rgba(0, 34, 90, 0.08);
        margin-bottom: 2rem;
        border: 1px solid #e2e8fa;
      }
      .pfs-hero-eyebrow {
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-size: 0.85rem;
        color: #4a63aa;
        display: block;
        margin-bottom: 0.4rem;
        font-weight: 600;
      }
      .pfs-hero h1 {
        margin: 0 0 0.8rem 0;
        font-size: 2.3rem;
        color: #0f172a;
      }
      .pfs-hero p {
        margin: 0;
        font-size: 1.15rem;
        color: #475569;
        max-width: 48rem;
      }
      .pfs-card-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
        max-width: 1200px;
        margin: 0;
      }
      @media (min-width: 1100px) {
        .pfs-card-grid {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
      }
      .pfs-card {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        padding: 1.4rem 1.6rem;
        border-radius: 18px;
        text-decoration: none;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        box-shadow: 0 20px 50px rgba(15, 23, 42, 0.06);
        transition: transform 120ms ease, box-shadow 120ms ease,
          border-color 120ms ease;
      }
      .pfs-card:hover,
      .pfs-card:focus {
        transform: translateY(-4px);
        box-shadow: 0 30px 60px rgba(15, 23, 42, 0.12);
        border-color: #93c5fd;
      }
      .pfs-card-header {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        width: 100%;
        margin-bottom: 0.6rem;
      }
      .pfs-card-icon {
        width: 2.4rem;
        height: 2.4rem;
        border-radius: 50%;
        background: linear-gradient(135deg, #2563eb, #3b82f6);
        color: #ffffff;
        font-weight: 700;
        font-size: 1.2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
        text-shadow: 0 3px 10px rgba(0, 0, 0, 0.35);
      }
      .pfs-card-icon::after {
        content: "";
        font-size: 1.35rem;
        font-weight: 700;
        line-height: 1;
      }
      .pfs-card-icon.icon-add::after {
        content: "+";
      }
      .pfs-card-icon.icon-overview::after {
        content: "\1F4C8";
      }
      .pfs-card-icon.icon-add {
        background: linear-gradient(135deg, #60a5fa, #2563eb);
        box-shadow: inset 0 0 10px rgba(255, 255, 255, 0.3);
      }
      .pfs-card-icon.icon-overview {
        background: linear-gradient(135deg, #4338ca, #7c3aed);
        box-shadow: inset 0 0 10px rgba(255, 255, 255, 0.25);
      }
      .pfs-card-icon.icon-admin::after {
        content: "\2699";
      }
      .pfs-card-icon.icon-admin {
        background: linear-gradient(135deg, #0f172a, #1e3a8a);
        box-shadow: inset 0 0 12px rgba(255, 255, 255, 0.35);
      }
      .pfs-card-icon.icon-template::after {
        content: "\2726";
      }
      .pfs-card-icon.icon-template {
        background: linear-gradient(135deg, #0ea5e9, #2563eb);
        box-shadow: inset 0 0 12px rgba(255, 255, 255, 0.35);
      }
      .pfs-card-title {
        font-size: 1.2rem;
        color: #111827;
        font-weight: 600;
        margin: 0;
      }
      .pfs-card-description {
        color: #475569;
        font-size: 1rem;
        margin: 0 0 1rem 0;
        line-height: 1.5;
      }
      .pfs-card-action {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-weight: 600;
        color: #1d4ed8;
        font-size: 0.95rem;
      }
      .pfs-card-button {
        margin-top: auto;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.7rem 1.3rem;
        border-radius: 999px;
        border: none;
        color: #f8fafc;
        font-weight: 600;
        text-decoration: none;
        background: linear-gradient(135deg, #2563eb, #3b82f6);
        box-shadow: 0 10px 24px rgba(37, 99, 235, 0.3);
        transition: transform 120ms ease, box-shadow 120ms ease;
      }
      .pfs-card-button::after {
        content: "";
      }
      .pfs-card-button:hover,
      .pfs-card-button:focus {
        transform: translateY(-2px);
        box-shadow: 0 14px 30px rgba(37, 99, 235, 0.4);
      }
      .pfs-card-button.button-secondary {
        background: linear-gradient(135deg, #334155, #475569);
        box-shadow: 0 10px 24px rgba(51, 65, 85, 0.3);
      }
      .pfs-card-button.button-secondary:hover,
      .pfs-card-button.button-secondary:focus {
        box-shadow: 0 14px 30px rgba(51, 65, 85, 0.4);
      }
      .pfs-card-button.button-manager {
        background: linear-gradient(135deg, #0f172a, #1e3a8a);
        box-shadow: 0 10px 24px rgba(15, 23, 42, 0.35);
      }
      .pfs-card-button.button-primary {
        background: linear-gradient(135deg, #2563eb, #3b82f6);
        box-shadow: 0 10px 24px rgba(37, 99, 235, 0.3);
      }
      .pfs-card-button.button-manager:hover,
      .pfs-card-button.button-manager:focus {
        box-shadow: 0 14px 30px rgba(15, 23, 42, 0.45);
      }
      .pfs-card-action::after {
        content: "›";
        transition: transform 120ms ease;
      }
      .pfs-card:hover .pfs-card-action::after {
        transform: translateX(4px);
      }
      .pfs-card-form {
        position: relative;
        overflow: hidden;
      }
      .pfs-card-form::before {
        content: "";
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at top right, rgba(59, 130, 246, 0.12), transparent 45%);
        pointer-events: none;
      }
      .pfs-form-row {
        width: 100%;
        display: grid;
        gap: 0.9rem;
        margin-top: 0.5rem;
      }
      .pfs-form-row label {
        font-size: 0.85rem;
        font-weight: 600;
        color: #475569;
      }
      .pfs-select {
        width: 100%;
        border-radius: 12px;
        border: 1px solid #cbd5f5;
        padding: 0.65rem 0.8rem;
        font-size: 0.95rem;
        color: #0f172a;
        background: #f8fafc;
        box-shadow: inset 0 1px 2px rgba(15, 23, 42, 0.08);
      }
      .pfs-select:focus {
        outline: none;
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.25);
        background: #ffffff;
      }
      .pfs-submit {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        padding: 0.7rem 1.2rem;
        border-radius: 999px;
        border: none;
        background: linear-gradient(135deg, #0ea5e9, #2563eb);
        color: #e0f2fe;
        font-weight: 600;
        cursor: pointer;
        box-shadow: 0 10px 24px rgba(37, 99, 235, 0.3);
      }
      .pfs-submit:hover {
        background: linear-gradient(135deg, #0284c7, #1d4ed8);
      }
      .pfs-card-meta {
        font-size: 0.85rem;
        color: #64748b;
        margin-top: 0.2rem;
      }
      .pfs-empty {
        border: 1px solid #f1f5f9;
        border-radius: 16px;
        padding: 2rem;
        background: #ffffff;
        text-align: center;
        box-shadow: 0 10px 25px rgba(15, 23, 42, 0.05);
      }
      .pfs-empty h2 {
        margin: 0 0 0.5rem 0;
        color: #0f172a;
      }
      .pfs-empty p {
        margin: 0 0 1rem 0;
        color: #475569;
      }
      .pfs-empty a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.8rem 1.6rem;
        border-radius: 99px;
        background: linear-gradient(135deg, #2563eb, #3b82f6);
        color: #ffffff;
        font-weight: 600;
        text-decoration: none;
      }
    </style>
  </metal:styles>

  <metal:content fill-slot="content-core" tal:define="cards view/cards">
    <section class="pfs-hero">
      <span class="pfs-hero-eyebrow" i18n:translate="">Privacy Forms Studio</span>
      <h1 i18n:translate="">What would you like to do today?</h1>
      <p i18n:translate="">
        Start with a guided action that matches your role. These shortcuts keep every
        team member productive, confident, and in control of their survey data.
      </p>
    </section>

    <section tal:condition="python: cards or view.can_create_from_template"
             tal:define="first_card python: cards[0] if cards else None;
                         remaining_cards python: cards[1:] if cards else []">
      <div class="pfs-card-grid">
        <tal:first-card tal:condition="first_card">
          <a class="pfs-card"
             tal:define="card first_card"
             tal:attributes="
               href card/url;
               class python: 'pfs-card accent-' + (card.get('accent') or 'primary')
             ">
            <div class="pfs-card-header">
              <div class="pfs-card-icon"
                   tal:attributes="class python: 'pfs-card-icon' + (' icon-' + card.get('icon') if card.get('icon') else '')"
                   aria-hidden="true"></div>
              <h2 class="pfs-card-title" tal:content="card/title">Card title</h2>
            </div>
            <p class="pfs-card-description"
               tal:content="card/description">Card description</p>
            <span class="pfs-card-button"
                  tal:attributes="class python: 'pfs-card-button button-' + (card.get('accent') or 'primary')"
                  tal:content="card/action_label">Go</span>
          </a>
        </tal:first-card>

        <tal:template-card tal:condition="view/can_create_from_template"
                           tal:define="templates view/template_options">
          <form class="pfs-card pfs-card-form"
                method="post"
                tal:attributes="action string:${context/absolute_url}/@@pfs">
            <input type="hidden" name="_authenticator" tal:attributes="value context/@@authenticator/token" />
            <input type="hidden" name="pfs_action" value="create_from_template" />
            <div class="pfs-card-header">
              <div class="pfs-card-icon icon-template" aria-hidden="true"></div>
              <h2 class="pfs-card-title" i18n:translate="">Create from template</h2>
            </div>
            <p class="pfs-card-description" i18n:translate="">
              Start a new form or survey using one of your curate presets.
            </p>
            <div class="pfs-form-row">
              <select id="pfs-template-select" name="template_uid" class="pfs-select" required="required">
                <option value="" i18n:translate="">Select a template</option>
                <tal:option repeat="template templates">
                  <option tal:attributes="value template/uid"
                          tal:content="template/title">Template</option>
                </tal:option>
              </select>
            </div>
            <div class="pfs-card-meta" i18n:translate="">
              The new form will be created in this workspace.
            </div>
            <div style="margin-top: auto; padding-top: 0.8rem;">
              <button type="submit" class="pfs-submit" i18n:translate="">
                Create form
              </button>
            </div>
          </form>
        </tal:template-card>

        <a class="pfs-card"
           tal:repeat="card remaining_cards"
           tal:attributes="
             href card/url;
             class python: 'pfs-card accent-' + (card.get('accent') or 'primary')
           ">
          <div class="pfs-card-header">
            <div class="pfs-card-icon"
                 tal:attributes="class python: 'pfs-card-icon' + (' icon-' + card.get('icon') if card.get('icon') else '')"
                 aria-hidden="true"></div>
            <h2 class="pfs-card-title" tal:content="card/title">Card title</h2>
          </div>
          <p class="pfs-card-description"
             tal:content="card/description">Card description</p>
          <span class="pfs-card-button"
                tal:attributes="class python: 'pfs-card-button button-' + (card.get('accent') or 'primary')"
                tal:content="card/action_label">Go</span>
        </a>
      </div>
    </section>

    <section class="pfs-empty" tal:condition="python: not cards and not view.can_create_from_template">
      <h2 i18n:translate="">Nothing to do yet</h2>
      <p i18n:translate="">
        You need permission to create new SurveyJS content here.
        Please reach out to a site manager for access.
      </p>
      <tal:login tal:condition="view/is_anonymous">
        <a tal:attributes="href view/login_url" i18n:translate="">Sign in</a>
      </tal:login>
    </section>
  </metal:content>
</html>
