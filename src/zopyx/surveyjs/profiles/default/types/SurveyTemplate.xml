<?xml version="1.0"?>
<object xmlns:i18n="http://xml.zope.org/namespaces/i18n"
    name="SurveyTemplate"
    meta_type="Dexterity FTI"
    i18n:domain="zopyx.surveyjs">

  <property
      i18n:translate=""
      name="title">Form/Survey Template</property>
  <property
      i18n:translate=""
      name="description">Form/Survey Template</property>

  <property name="allow_discussion">False</property>
  <property name="factory">SurveyTemplate</property>
  <property name="icon_expr">string:${portal_url}/++resource++zopyx.surveyjs/survey-template-icon.svg</property>
  <property name="link_target"></property>

  <property name="global_allow">True</property>
  <property name="add_permission">zopyx.surveyjs.AddSurveyTemplate</property>
  <property name="klass">zopyx.surveyjs.content.survey_template.SurveyTemplate</property>
  <property name="model_file"></property>
  <property name="model_source"></property>
  <property name="schema">zopyx.surveyjs.content.survey_template.ISurveyTemplate</property>

  <property name="behaviors" purge="false">
    <element value="plone.namefromtitle"/>
    <element value="plone.allowdiscussion"/>
    <element value="plone.excludefromnavigation"/>
    <element value="plone.shortname"/>
    <element value="plone.ownership"/>
    <element value="plone.publication"/>
    <element value="plone.categorization"/>
    <element value="plone.basic"/>
    <element value="plone.locking" />
  </property>

  <property name="add_view_expr">string:${folder_url}/++add++SurveyTemplate</property>
  <property name="default_view">viewer</property>
  <property name="default_view_fallback">False</property>
  <property name="immediate_view">viewer</property>
  <property name="view_methods">
    <element value="viewer"/>
  </property>

  <alias
      from="(Default)"
      to="(dynamic view)"
  />
  <alias
      from="edit"
      to="@@edit"
  />
  <alias
      from="sharing"
      to="@@sharing"
  />
  <alias
      from="view"
      to="(selected layout)"
  />

  <action
      action_id="view"
      category="object"
      condition_expr=""
      i18n:attributes="title"
      i18n:domain="plone"
      title="View"
      url_expr="string:${object_url}"
      visible="True">
    <permission value="View"/>
  </action>
  <action
      action_id="edit"
      category="object"
      condition_expr="not:object/@@plone_lock_info/is_locked_for_current_user|python:True"
      i18n:attributes="title"
      i18n:domain="plone"
      title="Edit"
      url_expr="string:${object_url}/edit"
      visible="True">
    <permission value="Modify portal content"/>
  </action>

</object>
