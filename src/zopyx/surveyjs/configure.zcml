<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    xmlns:plone="http://namespaces.plone.org/plone"
    xmlns:browser="http://namespaces.zope.org/browser"
    i18n_domain="zopyx.surveyjs">

  <i18n:registerTranslations directory="locales" />

  <!--
    Be careful if you use general includeDependencies, it can have side effects!
    Better import explicit packages or configurations ;)
  -->
  <!--<includeDependencies package="." />-->

  <include file="permissions.zcml" />

  <include package=".browser" />
  <include package=".vocabularies" />
  <include package=".adapters" />

  <genericsetup:registerProfile
      name="default"
      title="Privacy Forms Studio"
      directory="profiles/default"
      description="Installs the Privacy Forms Studio add-on."
      provides="Products.GenericSetup.interfaces.EXTENSION"
      post_handler=".setuphandlers.post_install"
      />

  <genericsetup:registerProfile
      name="uninstall"
      title="Privacy Forms Studio (uninstall)"
      directory="profiles/uninstall"
      description="Uninstalls the Privacy Forms Studio add-on."
      provides="Products.GenericSetup.interfaces.EXTENSION"
      post_handler=".setuphandlers.uninstall"
      />

  <genericsetup:upgradeSteps
      source="1001"
      destination="1002"
      profile="zopyx.surveyjs:default">
    <genericsetup:upgradeStep
        title="Register AI provider settings records"
        description="Re-imports the registry step to create the records for the new IFormsSettings AI provider fields (ai_provider, ollama_model, custom LLM fields)."
        handler=".upgrades.to_1002"
        />
  </genericsetup:upgradeSteps>

  <utility
      factory=".setuphandlers.HiddenProfiles"
      name="zopyx.surveyjs-hiddenprofiles"
      />

  <subscriber
      for="* zopyx.surveyjs.events.ISurveyJSFormSubmittedEvent"
      handler=".subscribers.send_submission_email"
      />

  <subscriber
      for="* zopyx.surveyjs.events.ISurveyJSFormSubmittedEvent"
      handler=".subscribers.send_submission_notification"
      />

  <subscriber
      for="* zopyx.surveyjs.events.ISurveyJSFormSubmittedEvent"
      handler=".subscribers.store_submission_result"
      />

  <subscriber
      for="* zopyx.surveyjs.events.ISurveyJSFormSubmittedEvent"
      handler=".subscribers.post_submission_payload"
      />

  <subscriber
      for="* zopyx.surveyjs.events.ISurveyJSFormSubmittedEvent"
      handler=".subscribers.log_survey_submission"
      />

  <subscriber
      for="* zopyx.surveyjs.events.ISurveyJSFormSubmittedEvent"
      handler=".monitoring.record_submission"
      />

  <subscriber
      for="plone.dexterity.interfaces.IDexterityContent
           zope.lifecycleevent.interfaces.IObjectModifiedEvent"
      handler=".subscribers.log_metadata_changes"
      />

  <subscriber
      for="plone.registry.interfaces.IRecordModifiedEvent"
      handler=".subscribers.log_controlpanel_change"
      />

      <include package="z3c.jbot" file="meta.zcml" />

  <browser:jbot
      directory="overrides"/>

</configure>
