
{
  "title": "Inscrição / Cancelamento de Inscrição no Evento",
  "description": "Inscreva-se no evento ou informe-nos que não poderá mais comparecer.",
  "pages": [
    {
      "name": "main",
      "title": "Escolha de Participação",
      "elements": [
        {
          "type": "radiogroup",
          "name": "action",
          "title": "O que você gostaria de fazer?",
          "isRequired": true,
          "choices": [
            {
              "value": "register",
              "text": "Inscrever-se no evento"
            },
            {
              "value": "unregister",
              "text": "Cancelar inscrição (cancelar minha participação)"
            }
          ]
        },
        {
          "type": "text",
          "name": "firstName",
          "title": "Nome",
          "isRequired": true,
          "visibleIf": "{action} = 'register'"
        },
        {
          "type": "text",
          "name": "lastName",
          "title": "Sobrenome",
          "isRequired": true,
          "visibleIf": "{action} = 'register'"
        },
        {
          "type": "text",
          "name": "email",
          "title": "Endereço de e-mail",
          "inputType": "email",
          "isRequired": true,
          "visibleIf": "{action} = 'register'"
        },
        {
          "type": "text",
          "name": "numberOfPersons",
          "title": "Número de pessoas participantes",
          "inputType": "number",
          "isRequired": true,
          "visibleIf": "{action} = 'register'"
        },
        {
          "type": "text",
          "name": "cancellationName",
          "title": "Nome do participante a ser cancelado",
          "description": "Informe-nos quem deve ser removido da lista de participantes.",
          "isRequired": true,
          "visibleIf": "{action} = 'unregister'"
        }
      ]
    }
  ]
}

