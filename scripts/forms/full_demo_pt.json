
{
  "title": "Consumo de Redes Sociais",
  "description": "Demonstração dos recursos do SurveyJS usando um contexto de redes sociais.",
  "locale": "pt",
  "showQuestionNumbers": "on",
  "showProgressBar": "top",
  "progressBarType": "pages",
  "completedHtml": "<h3>Obrigado por explorar a demonstração!</h3><p>Ajuste e amplie estas perguntas para suas próprias pesquisas.</p>",
  "pages": [
    {
      "name": "intro",
      "elements": [
        {
          "type": "html",
          "name": "demoIntro",
          "html": ""
        }
      ]
    },
    {
      "name": "basics",
      "title": "Seu perfil",
      "elements": [
        {
          "type": "text",
          "name": "fullName",
          "title": "Qual é o seu nome?",
          "placeHolder": "Alex Doe"
        },
        {
          "type": "dropdown",
          "name": "ageRange",
          "title": "Sua faixa etária",
          "isRequired": true,
          "choices": [
            "Menos de 18",
            "18-24",
            "25-34",
            "35-44",
            "45-54",
            "55-64",
            "65+"
          ]
        },
        {
          "type": "checkbox",
          "name": "primaryPlatforms",
          "title": "Quais plataformas você usa semanalmente?",
          "isRequired": true,
          "hasOther": true,
          "choices": [
            "Instagram",
            "TikTok",
            "YouTube",
            "Facebook",
            "LinkedIn",
            "Snapchat",
            "X/Twitter"
          ]
        },
        {
          "type": "rating",
          "name": "engagementLevel",
          "title": "Quão engajado(a) você se sente com as redes sociais em geral?",
          "rateMin": 1,
          "rateMax": 5,
          "minRateDescription": "Nada engajado",
          "maxRateDescription": "Muito engajado"
        }
      ]
    },
    {
      "name": "time",
      "title": "Tempo gasto",
      "elements": [
        {
          "type": "rating",
          "name": "dailyMinutes",
          "title": "Média de minutos por dia nas redes sociais",
          "rateMin": 0,
          "rateMax": 5,
          "rateStep": 1,
          "rateValues": [
            {
              "value": 0,
              "text": "Menos de 30"
            },
            {
              "value": 1,
              "text": "30-60"
            },
            {
              "value": 2,
              "text": "1-2 horas"
            },
            {
              "value": 3,
              "text": "2-3 horas"
            },
            {
              "value": 4,
              "text": "3-5 horas"
            },
            {
              "value": 5,
              "text": "5+ horas"
            }
          ]
        },
        {
          "type": "comment",
          "name": "timeComments",
          "title": "Quando você costuma navegar?",
          "placeHolder": "Deslocamento matinal, pausa para o almoço, noites, antes de dormir..."
        }
      ]
    },
    {
      "name": "matrixSection",
      "title": "Frequência por plataforma",
      "elements": [
        {
          "type": "matrix",
          "name": "platformFrequency",
          "title": "Com que frequência você acessa estas plataformas?",
          "isRequired": true,
          "columns": [
            {
              "value": "rarely",
              "text": "Raramente"
            },
            {
              "value": "weekly",
              "text": "Semanalmente"
            },
            {
              "value": "daily",
              "text": "Diariamente"
            },
            {
              "value": "hourly",
              "text": "Várias vezes ao dia"
            }
          ],
          "rows": [
            {
              "value": "instagram",
              "text": "Instagram"
            },
            {
              "value": "tiktok",
              "text": "TikTok"
            },
            {
              "value": "youtube",
              "text": "YouTube"
            },
            {
              "value": "facebook",
              "text": "Facebook"
            },
            {
              "value": "twitter",
              "text": "X/Twitter"
            }
          ]
        }
      ]
    },
    {
      "name": "matrixDynamicSection",
      "title": "Tempo de tela por dispositivo",
      "elements": [
        {
          "type": "matrixdynamic",
          "name": "screenTimeByDevice",
          "title": "Adicione dispositivos e estime seu tempo de tela durante a semana e no fim de semana.",
          "isRequired": true,
          "rowCount": 2,
          "minRowCount": 1,
          "addRowText": "Adicionar dispositivo",
          "columns": [
            {
              "name": "device",
              "title": "Dispositivo",
              "cellType": "dropdown",
              "choices": [
                "Celular",
                "Tablet",
                "Laptop",
                "Desktop",
                "TV",
                "Outro"
              ]
            },
            {
              "name": "weekday",
              "title": "Dias de semana (hrs)",
              "cellType": "text",
              "inputType": "number",
              "min": 0,
              "max": 24
            },
            {
              "name": "weekend",
              "title": "Fim de semana (hrs)",
              "cellType": "text",
              "inputType": "number",
              "min": 0,
              "max": 24
            }
          ]
        }
      ]
    },
    {
      "name": "uploads",
      "title": "Envios e feedback",
      "elements": [
        {
          "type": "file",
          "name": "screenshot",
          "title": "Opcional: envie uma captura de tela da sua tela inicial ou feed",
          "maxSize": 1024000,
          "imageHeight": 150,
          "imageWidth": 150
        },
        {
          "type": "comment",
          "name": "improvementIdeas",
          "title": "O que melhoraria sua experiência nas redes sociais?"
        },
        {
          "type": "boolean",
          "name": "followUp",
          "title": "Podemos entrar em contato com você para falar sobre esses insights?",
          "labelTrue": "Sim, vocês podem entrar em contato comigo",
          "labelFalse": "Não, mantenha isso anônimo"
        }
      ]
    }
  ]
}

