          "type": "text",
          "name": "fullName",
          "title": "Qual è il tuo nome?",
          "placeHolder": "Alex Rossi"
        },
        {
          "type": "dropdown",
          "name": "ageRange",
          "title": "La tua fascia d’età",
          "isRequired": true,
          "choices": [
            "Meno di 18",
            "18-24",
            "25-34",
            "35-44",
            "45-54",
            "55-64",
            "65+"
          ]
        },
        {
          "type": "checkbox",
          "name": "primaryPlatforms",
          "title": "Quali piattaforme utilizzi settimanalmente?",
