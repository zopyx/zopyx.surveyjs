          "rowCount": 2,
          "minRowCount": 1,
          "addRowText": "Aggiungi dispositivo",
          "columns": [
            {
              "name": "device",
              "title": "Dispositivo",
              "cellType": "dropdown",
              "choices": [
                "Telefono",
                "Tablet",
                "Laptop",
                "Desktop",
                "TV",
                "Altro"
              ]
            },
            {
              "name": "weekday",
              "title": "Giorni feriali (ore)",
              "cellType": "text",
              "inputType": "number",
              "min": 0,
              "max": 24
            },
            {
              "name": "weekend",
              "title": "Weekend (ore)",
              "cellType": "text",
              "inputType": "number",
              "min": 0,
              "max": 24
            }
          ]
        }
      ]
    },
    {
      "name": "uploads",
      "title": "Caricamenti e feedback",
      "elements": [
        {
          "type": "file",
          "name": "screenshot",
          "title": "Opzionale: carica uno screenshot della tua schermata principale o del feed",
          "maxSize": 1024000,
          "imageHeight": 150,
          "imageWidth": 150
        },
        {
          "type": "comment",
          "name": "improvementIdeas",
          "title": "Cosa migliorerebbe la tua esperienza sui social media?"
        },
        {
          "type": "boolean",
          "name": "followUp",
          "title": "Possiamo ricontattarti per approfondire questi spunti?",
          "labelTrue": "Sì, potete contattarmi",
          "labelFalse": "No, mantieni l’anonimato"
        }
      ]
