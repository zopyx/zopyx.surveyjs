  "locale": "it",
  "showQuestionNumbers": "on",
  "showProgressBar": "top",
  "progressBarType": "pages",
  "completedHtml": "<h3>Grazie per aver esplorato la demo!</h3><p>Adatta ed estendi queste domande per i tuoi sondaggi.</p>",
