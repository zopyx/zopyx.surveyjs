
{
  "title": "Registro / Cancelación de inscripción al evento",
  "description": "Regístrate para el evento o avísanos si ya no puedes asistir.",
  "pages": [
    {
      "name": "main",
      "title": "Elección de participación",
      "elements": [
        {
          "type": "radiogroup",
          "name": "action",
          "title": "¿Qué te gustaría hacer?",
          "isRequired": true,
          "choices": [
            {
              "value": "register",
              "text": "Registrarme en el evento"
            },
            {
              "value": "unregister",
              "text": "Cancelar mi inscripción (no asistiré)"
            }
          ]
        },
        {
          "type": "text",
          "name": "firstName",
          "title": "Nombre",
          "isRequired": true,
          "visibleIf": "{action} = 'register'"
        },
        {
          "type": "text",
          "name": "lastName",
          "title": "Apellido",
          "isRequired": true,
          "visibleIf": "{action} = 'register'"
        },
        {
          "type": "text",
          "name": "email",
          "title": "Dirección de correo electrónico",
          "inputType": "email",
          "isRequired": true,
          "visibleIf": "{action} = 'register'"
        },
        {
          "type": "text",
          "name": "numberOfPersons",
          "title": "Número de personas asistentes",
          "inputType": "number",
          "isRequired": true,
          "visibleIf": "{action} = 'register'"
        },
        {
          "type": "text",
          "name": "cancellationName",
          "title": "Nombre del asistente a cancelar",
          "description": "Indícanos a quién debemos eliminar de la lista de asistentes.",
          "isRequired": true,
          "visibleIf": "{action} = 'unregister'"
        }
      ]
    }
  ]
}

