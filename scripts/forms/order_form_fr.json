{
  "title": "Bon de commande textile",
  "description": "Un formulaire de commande textile simple pour recueillir les coordonnées clients et les lignes de commande détaillées.",
  "pages": [
    {
      "name": "page1",
      "title": "Bon de commande textile",
      "description": "Renseignez les informations client et utilisez la grille des articles pour ajouter, modifier ou supprimer des lignes pour chaque article textile.",
      "elements": [
        {
          "type": "hidden",
          "name": "uuid",
          "defaultValue": "6f8b9d2e-2c4a-4f1b-9e2a-7d3a8c1b2f5d"
        },
        {
          "type": "hidden",
          "name": "created",
          "defaultValue": "2026-01-11T12:34:56Z"
        },
        {
          "type": "text",
          "name": "firstname",
          "title": "Prénom"
        },
        {
          "type": "text",
          "name": "lastname",
          "title": "Nom"
        },
        {
          "type": "text",
          "name": "email",
          "title": "Adresse e-mail"
        },
        {
          "type": "text",
          "name": "phone",
          "title": "Numéro de téléphone"
        },
        {
          "type": "matrixdynamic",
          "name": "order_items",
          "title": "Articles commandés",
          "description": "Ajoutez un ou plusieurs articles textiles à la commande. Vous pouvez ajouter, modifier ou supprimer des lignes.",
          "columns": [
            {
              "name": "item",
              "title": "Article (p. ex., robe, chemise)",
              "cellType": "text"
            },
            {
              "name": "fabric",
              "title": "Type de tissu",
              "cellType": "dropdown",
              "choices": [
                "Coton",
                "Soie",
                "Laine",
                "Lin",
                "Polyester"
              ]
            },
            {
              "name": "color",
              "title": "Couleur",
              "cellType": "text"
            },
            {
              "name": "size",
              "title": "Taille",
              "cellType": "dropdown",
              "choices": [
                "XS",
                "S",
                "M",
                "L",
                "XL",
                "XXL"
              ]
            },
            {
              "name": "quantity",
              "title": "Quantité",
              "cellType": "text"
            },
            {
              "name": "unitPrice",
              "title": "Prix unitaire",
              "cellType": "text",
              "inputType": "number"
            },
            {
              "name": "notes",
              "title": "Notes",
              "cellType": "text"
            }
          ],
          "minRowCount": 1,
          "addRowText": "Ajouter un article",
          "removeRowText": "Supprimer l'article"
        },
        {
          "type": "radiogroup",
          "name": "deliveryOption",
          "title": "Option de livraison",
          "description": "Choisissez comment vous souhaitez recevoir votre commande.",
          "choices": [
            {
              "value": "standard",
              "text": "Standard (5-7 jours)"
            },
            {
              "value": "express",
              "text": "Express (2-3 jours)"
            },
            {
              "value": "pickup",
              "text": "Retrait au showroom"
            }
          ]
        },
        {
          "type": "checkbox",
          "name": "extras",
          "title": "Options supplémentaires",
          "choices": [
            "Emballage cadeau",
            "Production accélérée",
            "Inclure des étiquettes de couture"
          ]
        },
        {
          "type": "comment",
          "name": "specialInstructions",
          "title": "Instructions spéciales",
          "description": "Toute demande particulière ou précision pour la commande."
        },
        {
          "type": "checkbox",
          "name": "termsAccepted",
          "title": "Conditions générales",
          "description": "Confirmez que vous acceptez les conditions générales de commande.",
          "choices": [
            "J'accepte les conditions générales"
          ],
          "isRequired": true
        },
        {
          "type": "signaturepad",
          "name": "signature",
          "title": "Signature",
          "description": "Signez pour confirmer les détails de la commande.",
          "isRequired": true
        }
      ]
    }
  ],
  "showProgressBar": "onPage",
  "requiredTextOnNormalMessages": false
}
