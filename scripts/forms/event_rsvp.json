{
  "title": "Event Registration / Unregistration",
  "description": "Register for the event or let us know you can no longer attend.",
  "pages": [
    {
      "name": "main",
      "title": "Participation Choice",
      "elements": [
        {
          "type": "radiogroup",
          "name": "action",
          "title": "What would you like to do?",
          "isRequired": true,
          "choices": [
            {
              "value": "register",
              "text": "Register for the event"
            },
            {
              "value": "unregister",
              "text": "Unregister (cancel my attendance)"
            }
          ]
        },
        {
          "type": "text",
          "name": "firstName",
          "title": "First name",
          "isRequired": true,
          "visibleIf": "{action} = 'register'"
        },
        {
          "type": "text",
          "name": "lastName",
          "title": "Last name",
          "isRequired": true,
          "visibleIf": "{action} = 'register'"
        },
        {
          "type": "text",
          "name": "email",
          "title": "Email address",
          "inputType": "email",
          "isRequired": true,
          "visibleIf": "{action} = 'register'"
        },
        {
          "type": "text",
          "name": "numberOfPersons",
          "title": "Number of persons attending",
          "inputType": "number",
          "isRequired": true,
          "visibleIf": "{action} = 'register'"
        },
        {
          "type": "text",
          "name": "cancellationName",
          "title": "Name of the attendee to unregister",
          "description": "Tell us who should be removed from the attendee list.",
          "isRequired": true,
          "visibleIf": "{action} = 'unregister'"
        }
      ]
    }
  ]
}
