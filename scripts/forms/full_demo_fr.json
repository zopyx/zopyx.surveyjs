{
  "title": "Consommation des réseaux sociaux",
  "description": "Démonstration des fonctionnalités de SurveyJS dans un contexte de réseaux sociaux.",
  "locale": "fr",
  "showQuestionNumbers": "on",
  "showProgressBar": "top",
  "progressBarType": "pages",
  "completedHtml": "<h3>Merci d'avoir exploré la démo !</h3><p>Adaptez et enrichissez ces questions pour vos propres enquêtes.</p>",
  "pages": [
    {
      "name": "intro",
      "elements": [
        {
          "type": "html",
          "name": "demoIntro",
          "html": ""
        }
      ]
    },
    {
      "name": "basics",
      "title": "Votre profil",
      "elements": [
        {
          "type": "text",
          "name": "fullName",
          "title": "Comment vous appelez-vous ?",
          "placeHolder": "Alex Doe"
        },
        {
          "type": "dropdown",
          "name": "ageRange",
          "title": "Votre tranche d'âge",
          "isRequired": true,
          "choices": [
            "Moins de 18",
            "18-24",
            "25-34",
            "35-44",
            "45-54",
            "55-64",
            "65+"
          ]
        },
        {
          "type": "checkbox",
          "name": "primaryPlatforms",
          "title": "Quelles plateformes utilisez-vous chaque semaine ?",
          "isRequired": true,
          "hasOther": true,
          "choices": [
            "Instagram",
            "TikTok",
            "YouTube",
            "Facebook",
            "LinkedIn",
            "Snapchat",
            "X/Twitter"
          ]
        },
        {
          "type": "rating",
          "name": "engagementLevel",
          "title": "À quel point vous sentez-vous engagé(e) sur les réseaux sociaux en général ?",
          "rateMin": 1,
          "rateMax": 5,
          "minRateDescription": "Pas engagé(e)",
          "maxRateDescription": "Très engagé(e)"
        }
      ]
    },
    {
      "name": "time",
      "title": "Temps passé",
      "elements": [
        {
          "type": "rating",
          "name": "dailyMinutes",
          "title": "Minutes moyennes par jour sur les réseaux sociaux",
          "rateMin": 0,
          "rateMax": 5,
          "rateStep": 1,
          "rateValues": [
            {
              "value": 0,
              "text": "Moins de 30"
            },
            {
              "value": 1,
              "text": "30-60"
            },
            {
              "value": 2,
              "text": "1-2 heures"
            },
            {
              "value": 3,
              "text": "2-3 heures"
            },
            {
              "value": 4,
              "text": "3-5 heures"
            },
            {
              "value": 5,
              "text": "5+ heures"
            }
          ]
        },
        {
          "type": "comment",
          "name": "timeComments",
          "title": "Quand faites-vous défiler d'habitude ?",
          "placeHolder": "Trajet du matin, pause déjeuner, soirées, avant de dormir..."
        }
      ]
    },
    {
      "name": "matrixSection",
      "title": "Fréquence par plateforme",
      "elements": [
        {
          "type": "matrix",
          "name": "platformFrequency",
          "title": "À quelle fréquence consultez-vous ces plateformes ?",
          "isRequired": true,
          "columns": [
            {
              "value": "rarely",
              "text": "Rarement"
            },
            {
              "value": "weekly",
              "text": "Chaque semaine"
            },
            {
              "value": "daily",
              "text": "Quotidiennement"
            },
            {
              "value": "hourly",
              "text": "Plusieurs fois par jour"
            }
          ],
          "rows": [
            {
              "value": "instagram",
              "text": "Instagram"
            },
            {
              "value": "tiktok",
              "text": "TikTok"
            },
            {
              "value": "youtube",
              "text": "YouTube"
            },
            {
              "value": "facebook",
              "text": "Facebook"
            },
            {
              "value": "twitter",
              "text": "X/Twitter"
            }
          ]
        }
      ]
    },
    {
      "name": "matrixDynamicSection",
      "title": "Temps d'écran par appareil",
      "elements": [
        {
          "type": "matrixdynamic",
          "name": "screenTimeByDevice",
          "title": "Ajoutez des appareils et estimez votre temps d'écran en semaine et le week-end.",
          "isRequired": true,
          "rowCount": 2,
          "minRowCount": 1,
          "addRowText": "Ajouter un appareil",
          "columns": [
            {
              "name": "device",
              "title": "Appareil",
              "cellType": "dropdown",
              "choices": [
                "Téléphone",
                "Tablette",
                "Ordinateur portable",
                "Ordinateur de bureau",
                "Télévision",
                "Autre"
              ]
            },
            {
              "name": "weekday",
              "title": "Semaine (h)",
              "cellType": "text",
              "inputType": "number",
              "min": 0,
              "max": 24
            },
            {
              "name": "weekend",
              "title": "Week-end (h)",
              "cellType": "text",
              "inputType": "number",
              "min": 0,
              "max": 24
            }
          ]
        }
      ]
    },
    {
      "name": "uploads",
      "title": "Téléversements et commentaires",
      "elements": [
        {
          "type": "file",
          "name": "screenshot",
          "title": "Facultatif : téléversez une capture d'écran de votre écran d'accueil ou de votre fil d'actualité",
          "maxSize": 1024000,
          "imageHeight": 150,
          "imageWidth": 150
        },
        {
          "type": "comment",
          "name": "improvementIdeas",
          "title": "Qu'est-ce qui améliorerait votre expérience des réseaux sociaux ?"
        },
        {
          "type": "boolean",
          "name": "followUp",
          "title": "Pouvons-nous vous recontacter à propos de ces informations ?",
          "labelTrue": "Oui, vous pouvez me contacter",
          "labelFalse": "Non, gardez cela anonyme"
        }
      ]
    }
  ]
}
