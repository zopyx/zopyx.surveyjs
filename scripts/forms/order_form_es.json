
{
  "title": "Formulario de Pedido de Ropa",
  "description": "Un formulario simple de pedido de ropa para recopilar los datos del cliente y las líneas de pedido detalladas.",
  "pages": [
    {
      "name": "page1",
      "title": "Formulario de Pedido de Ropa",
      "description": "Complete los datos del cliente y use la tabla de artículos para agregar, editar o eliminar filas para cada prenda.",
      "elements": [
        {
          "type": "hidden",
          "name": "uuid",
          "defaultValue": "6f8b9d2e-2c4a-4f1b-9e2a-7d3a8c1b2f5d"
        },
        {
          "type": "hidden",
          "name": "created",
          "defaultValue": "2026-01-11T12:34:56Z"
        },
        {
          "type": "text",
          "name": "firstname",
          "title": "Nombre"
        },
        {
          "type": "text",
          "name": "lastname",
          "title": "Apellido"
        },
        {
          "type": "text",
          "name": "email",
          "title": "Correo electrónico"
        },
        {
          "type": "text",
          "name": "phone",
          "title": "Número de teléfono"
        },
        {
          "type": "matrixdynamic",
          "name": "order_items",
          "title": "Artículos del Pedido",
          "description": "Agregue uno o más artículos de ropa al pedido. Puede agregar, editar o eliminar filas.",
          "columns": [
            {
              "name": "item",
              "title": "Artículo (p. ej., Vestido, Camisa)",
              "cellType": "text"
            },
            {
              "name": "fabric",
              "title": "Tipo de Tela",
              "cellType": "dropdown",
              "choices": [
                "Algodón",
                "Seda",
                "Lana",
                "Lino",
                "Poliéster"
              ]
            },
            {
              "name": "color",
              "title": "Color",
              "cellType": "text"
            },
            {
              "name": "size",
              "title": "Talla",
              "cellType": "dropdown",
              "choices": [
                "XS",
                "S",
                "M",
                "L",
                "XL",
                "XXL"
              ]
            },
            {
              "name": "quantity",
              "title": "Cantidad",
              "cellType": "text"
            },
            {
              "name": "unitPrice",
              "title": "Precio Unitario",
              "cellType": "text",
              "inputType": "number"
            },
            {
              "name": "notes",
              "title": "Notas",
              "cellType": "text"
            }
          ],
          "minRowCount": 1,
          "addRowText": "Agregar Artículo",
          "removeRowText": "Eliminar Artículo"
        },
        {
          "type": "radiogroup",
          "name": "deliveryOption",
          "title": "Opción de Entrega",
          "description": "Elija cómo desea que se entregue su pedido.",
          "choices": [
            {
              "value": "standard",
              "text": "Estándar (5–7 días)"
            },
            {
              "value": "express",
              "text": "Exprés (2–3 días)"
            },
            {
              "value": "pickup",
              "text": "Recogida en la sala de exhibición"
            }
          ]
        },
        {
          "type": "checkbox",
          "name": "extras",
          "title": "Opciones Adicionales",
          "choices": [
            "Envoltura para regalo",
            "Producción urgente",
            "Incluir etiquetas de costura"
          ]
        },
        {
          "type": "comment",
          "name": "specialInstructions",
          "title": "Instrucciones Especiales",
          "description": "Cualquier solicitud especial o detalle para el pedido."
        },
        {
          "type": "checkbox",
          "name": "termsAccepted",
          "title": "Términos y Condiciones",
          "description": "Confirme que acepta los términos y condiciones del pedido.",
          "choices": [
            "Acepto los términos y condiciones"
          ],
          "isRequired": true
        },
        {
          "type": "signaturepad",
          "name": "signature",
          "title": "Firma",
          "description": "Firme para confirmar los detalles del pedido.",
          "isRequired": true
        }
      ]
    }
  ],
  "showProgressBar": "onPage",
  "requiredTextOnNormalMessages": false
}

