
{
  "title": "Formulário de Pedido de Roupas",
  "description": "Um formulário simples de pedido de roupas para coletar os dados do cliente e as linhas de itens do pedido.",
  "pages": [
    {
      "name": "page1",
      "title": "Formulário de Pedido de Roupas",
      "description": "Preencha os dados do cliente e use a grade de itens para adicionar, editar ou remover linhas para cada item de roupa.",
      "elements": [
        {
          "type": "hidden",
          "name": "uuid",
          "defaultValue": "6f8b9d2e-2c4a-4f1b-9e2a-7d3a8c1b2f5d"
        },
        {
          "type": "hidden",
          "name": "created",
          "defaultValue": "2026-01-11T12:34:56Z"
        },
        {
          "type": "text",
          "name": "firstname",
          "title": "Nome"
        },
        {
          "type": "text",
          "name": "lastname",
          "title": "Sobrenome"
        },
        {
          "type": "text",
          "name": "email",
          "title": "Endereço de e-mail"
        },
        {
          "type": "text",
          "name": "phone",
          "title": "Número de telefone"
        },
        {
          "type": "matrixdynamic",
          "name": "order_items",
          "title": "Itens do Pedido",
          "description": "Adicione um ou mais itens de roupa ao pedido. Você pode adicionar, editar ou remover linhas.",
          "columns": [
            {
              "name": "item",
              "title": "Item (ex.: Vestido, Camisa)",
              "cellType": "text"
            },
            {
              "name": "fabric",
              "title": "Tipo de Tecido",
              "cellType": "dropdown",
              "choices": [
                "Algodão",
                "Seda",
                "Lã",
                "Linho",
                "Poliéster"
              ]
            },
            {
              "name": "color",
              "title": "Cor",
              "cellType": "text"
            },
            {
              "name": "size",
              "title": "Tamanho",
              "cellType": "dropdown",
              "choices": [
                "PP",
                "P",
                "M",
                "G",
                "GG",
                "XGG"
              ]
            },
            {
              "name": "quantity",
              "title": "Quantidade",
              "cellType": "text"
            },
            {
              "name": "unitPrice",
              "title": "Preço Unitário",
              "cellType": "text",
              "inputType": "number"
            },
            {
              "name": "notes",
              "title": "Observações",
              "cellType": "text"
            }
          ],
          "minRowCount": 1,
          "addRowText": "Adicionar Item",
          "removeRowText": "Remover Item"
        },
        {
          "type": "radiogroup",
          "name": "deliveryOption",
          "title": "Opção de Entrega",
          "description": "Escolha como você gostaria de receber seu pedido.",
          "choices": [
            {
              "value": "standard",
              "text": "Padrão (5–7 dias)"
            },
            {
              "value": "express",
              "text": "Expresso (2–3 dias)"
            },
            {
              "value": "pickup",
              "text": "Retirada no showroom"
            }
          ]
        },
        {
          "type": "checkbox",
          "name": "extras",
          "title": "Opções Adicionais",
          "choices": [
            "Embalagem para presente",
            "Produção urgente",
            "Incluir etiquetas de costura"
          ]
        },
        {
          "type": "comment",
          "name": "specialInstructions",
          "title": "Instruções Especiais",
          "description": "Quaisquer solicitações ou detalhes especiais para o pedido."
        },
        {
          "type": "checkbox",
          "name": "termsAccepted",
          "title": "Termos e Condições",
          "description": "Confirme que você concorda com os termos e condições do pedido.",
          "choices": [
            "Concordo com os termos e condições"
          ],
          "isRequired": true
        },
        {
          "type": "signaturepad",
          "name": "signature",
          "title": "Assinatura",
          "description": "Assine para confirmar os detalhes do pedido.",
          "isRequired": true
        }
      ]
    }
  ],
  "showProgressBar": "onPage",
  "requiredTextOnNormalMessages": false
}

