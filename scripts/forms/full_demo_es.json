
{
  "title": "Consumo de redes sociales",
  "description": "Demostración de las funciones de SurveyJS utilizando un contexto de redes sociales.",
  "locale": "es",
  "showQuestionNumbers": "on",
  "showProgressBar": "top",
  "progressBarType": "pages",
  "completedHtml": "<h3>¡Gracias por explorar la demostración!</h3><p>Ajusta y amplía estas preguntas para tus propias encuestas.</p>",
  "pages": [
    {
      "name": "intro",
      "elements": [
        {
          "type": "html",
          "name": "demoIntro",
          "html": ""
        }
      ]
    },
    {
      "name": "basics",
      "title": "Tu perfil",
      "elements": [
        {
          "type": "text",
          "name": "fullName",
          "title": "¿Cuál es tu nombre?",
          "placeHolder": "Alex Doe"
        },
        {
          "type": "dropdown",
          "name": "ageRange",
          "title": "Tu rango de edad",
          "isRequired": true,
          "choices": [
            "Menos de 18",
            "18-24",
            "25-34",
            "35-44",
            "45-54",
            "55-64",
            "65+"
          ]
        },
        {
          "type": "checkbox",
          "name": "primaryPlatforms",
          "title": "¿Qué plataformas usas semanalmente?",
          "isRequired": true,
          "hasOther": true,
          "choices": [
            "Instagram",
            "TikTok",
            "YouTube",
            "Facebook",
            "LinkedIn",
            "Snapchat",
            "X/Twitter"
          ]
        },
        {
          "type": "rating",
          "name": "engagementLevel",
          "title": "¿Qué tan involucrado/a te sientes con las redes sociales en general?",
          "rateMin": 1,
          "rateMax": 5,
          "minRateDescription": "Nada involucrado/a",
          "maxRateDescription": "Muy involucrado/a"
        }
      ]
    },
    {
      "name": "time",
      "title": "Tiempo dedicado",
      "elements": [
        {
          "type": "rating",
          "name": "dailyMinutes",
          "title": "Promedio de minutos al día en redes sociales",
          "rateMin": 0,
          "rateMax": 5,
          "rateStep": 1,
          "rateValues": [
            {
              "value": 0,
              "text": "Menos de 30"
            },
            {
              "value": 1,
              "text": "30-60"
            },
            {
              "value": 2,
              "text": "1-2 horas"
            },
            {
              "value": 3,
              "text": "2-3 horas"
            },
            {
              "value": 4,
              "text": "3-5 horas"
            },
            {
              "value": 5,
              "text": "5+ horas"
            }
          ]
        },
        {
          "type": "comment",
          "name": "timeComments",
          "title": "¿Cuándo sueles desplazarte por las redes?",
          "placeHolder": "Traslado por la mañana, hora del almuerzo, tardes, antes de dormir..."
        }
      ]
    },
    {
      "name": "matrixSection",
      "title": "Frecuencia por plataforma",
      "elements": [
        {
          "type": "matrix",
          "name": "platformFrequency",
          "title": "¿Con qué frecuencia revisas estas plataformas?",
          "isRequired": true,
          "columns": [
            {
              "value": "rarely",
              "text": "Rara vez"
            },
            {
              "value": "weekly",
              "text": "Semanalmente"
            },
            {
              "value": "daily",
              "text": "Diariamente"
            },
            {
              "value": "hourly",
              "text": "Varias veces al día"
            }
          ],
          "rows": [
            {
              "value": "instagram",
              "text": "Instagram"
            },
            {
              "value": "tiktok",
              "text": "TikTok"
            },
            {
              "value": "youtube",
              "text": "YouTube"
            },
            {
              "value": "facebook",
              "text": "Facebook"
            },
            {
              "value": "twitter",
              "text": "X/Twitter"
            }
          ]
        }
      ]
    },
    {
      "name": "matrixDynamicSection",
      "title": "Tiempo de pantalla por dispositivo",
      "elements": [
        {
          "type": "matrixdynamic",
          "name": "screenTimeByDevice",
          "title": "Agrega dispositivos y estima tu tiempo de pantalla entre semana y fines de semana.",
          "isRequired": true,
          "rowCount": 2,
          "minRowCount": 1,
          "addRowText": "Agregar dispositivo",
          "columns": [
            {
              "name": "device",
              "title": "Dispositivo",
              "cellType": "dropdown",
              "choices": [
                "Teléfono",
                "Tableta",
                "Portátil",
                "Computadora de escritorio",
                "Televisor",
                "Otro"
              ]
            },
            {
              "name": "weekday",
              "title": "Entre semana (hrs)",
              "cellType": "text",
              "inputType": "number",
              "min": 0,
              "max": 24
            },
            {
              "name": "weekend",
              "title": "Fin de semana (hrs)",
              "cellType": "text",
              "inputType": "number",
              "min": 0,
              "max": 24
            }
          ]
        }
      ]
    },
    {
      "name": "uploads",
      "title": "Cargas y comentarios",
      "elements": [
        {
          "type": "file",
          "name": "screenshot",
          "title": "Opcional: sube una captura de pantalla de tu pantalla de inicio o feed",
          "maxSize": 1024000,
          "imageHeight": 150,
          "imageWidth": 150
        },
        {
          "type": "comment",
          "name": "improvementIdeas",
          "title": "¿Qué mejoraría tu experiencia en redes sociales?"
        },
        {
          "type": "boolean",
          "name": "followUp",
          "title": "¿Podemos ponernos en contacto contigo para dar seguimiento a estos comentarios?",
          "labelTrue": "Sí, pueden contactarme",
          "labelFalse": "No, mantengan esto anónimo"
        }
      ]
    }
  ]
}

