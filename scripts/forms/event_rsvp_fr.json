
{
  "title": "Inscription / Désinscription à l’événement",
  "description": "Inscrivez-vous à l’événement ou informez-nous que vous ne pouvez plus y assister.",
  "pages": [
    {
      "name": "main",
      "title": "Choix de participation",
      "elements": [
        {
          "type": "radiogroup",
          "name": "action",
          "title": "Que souhaitez-vous faire ?",
          "isRequired": true,
          "choices": [
            {
              "value": "register",
              "text": "M’inscrire à l’événement"
            },
            {
              "value": "unregister",
              "text": "Me désinscrire (annuler ma participation)"
            }
          ]
        },
        {
          "type": "text",
          "name": "firstName",
          "title": "Prénom",
          "isRequired": true,
          "visibleIf": "{action} = 'register'"
        },
        {
          "type": "text",
          "name": "lastName",
          "title": "Nom",
          "isRequired": true,
          "visibleIf": "{action} = 'register'"
        },
        {
          "type": "text",
          "name": "email",
          "title": "Adresse e-mail",
          "inputType": "email",
          "isRequired": true,
          "visibleIf": "{action} = 'register'"
        },
        {
          "type": "text",
          "name": "numberOfPersons",
          "title": "Nombre de personnes présentes",
          "inputType": "number",
          "isRequired": true,
          "visibleIf": "{action} = 'register'"
        },
        {
          "type": "text",
          "name": "cancellationName",
          "title": "Nom de la personne à désinscrire",
          "description": "Indiquez-nous quelle personne doit être retirée de la liste des participants.",
          "isRequired": true,
          "visibleIf": "{action} = 'unregister'"
        }
      ]
    }
  ]
}

