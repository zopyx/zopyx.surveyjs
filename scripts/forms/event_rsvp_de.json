{
  "title": "Veranstaltung An-/Abmeldung",
  "description": "Melden Sie sich zur Veranstaltung an oder sagen Sie Ihre Teilnahme ab.",
  "locale": "de",
  "pages": [
    {
      "name": "main",
      "title": "Teilnahme auswählen",
      "elements": [
        {
          "type": "radiogroup",
          "name": "action",
          "title": "Was möchten Sie tun?",
          "isRequired": true,
          "choices": [
            {
              "value": "register",
              "text": "Für die Veranstaltung anmelden"
            },
            {
              "value": "unregister",
              "text": "Abmelden (Teilnahme stornieren)"
            }
          ]
        },
        {
          "type": "text",
          "name": "firstName",
          "title": "Vorname",
          "isRequired": true,
          "visibleIf": "{action} = 'register'"
        },
        {
          "type": "text",
          "name": "lastName",
          "title": "Nachname",
          "isRequired": true,
          "visibleIf": "{action} = 'register'"
        },
        {
          "type": "text",
          "name": "email",
          "title": "E-Mail-Adresse",
          "inputType": "email",
          "isRequired": true,
          "visibleIf": "{action} = 'register'"
        },
        {
          "type": "text",
          "name": "numberOfPersons",
          "title": "Anzahl der teilnehmenden Personen",
          "inputType": "number",
          "isRequired": true,
          "visibleIf": "{action} = 'register'"
        },
        {
          "type": "text",
          "name": "cancellationName",
          "title": "Name der abzumeldenden Person",
          "description": "Wer soll von der Teilnahmeliste entfernt werden?",
          "isRequired": true,
          "visibleIf": "{action} = 'unregister'"
        }
      ]
    }
  ]
}
