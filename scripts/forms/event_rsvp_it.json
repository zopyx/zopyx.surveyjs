
{
  "title": "Registrazione / Cancellazione dall’evento",
  "description": "Registrati all’evento oppure comunicaci che non puoi più partecipare.",
  "pages": [
    {
      "name": "main",
      "title": "Scelta di partecipazione",
      "elements": [
        {
          "type": "radiogroup",
          "name": "action",
          "title": "Cosa desideri fare?",
          "isRequired": true,
          "choices": [
            {
              "value": "register",
              "text": "Registrarmi all’evento"
            },
            {
              "value": "unregister",
              "text": "Annullare la registrazione (cancellare la mia partecipazione)"
            }
          ]
        },
        {
          "type": "text",
          "name": "firstName",
          "title": "Nome",
          "isRequired": true,
          "visibleIf": "{action} = 'register'"
        },
        {
          "type": "text",
          "name": "lastName",
          "title": "Cognome",
          "isRequired": true,
          "visibleIf": "{action} = 'register'"
        },
        {
          "type": "text",
          "name": "email",
          "title": "Indirizzo email",
          "inputType": "email",
          "isRequired": true,
          "visibleIf": "{action} = 'register'"
        },
        {
          "type": "text",
          "name": "numberOfPersons",
          "title": "Numero di persone partecipanti",
          "inputType": "number",
          "isRequired": true,
          "visibleIf": "{action} = 'register'"
        },
        {
          "type": "text",
          "name": "cancellationName",
          "title": "Nome del partecipante da cancellare",
          "description": "Indicaci chi deve essere rimosso dall’elenco dei partecipanti.",
          "isRequired": true,
          "visibleIf": "{action} = 'unregister'"
        }
      ]
    }
  ]
}

